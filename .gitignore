# Large data artifacts distributed via the Hugging Face datasets, hydrated
# locally under these paths. Patterns are anchored: unanchored "benchmark/"
# or "vibench/" would also ignore code/scripts/benchmark/ and
# code/configs/vibench/ (this previously kept the study configs and the
# benchmark-construction scripts out of the repository by accident).
/outputs/
/code/outputs/
/code/benchmark/
/code/results/**/*.jsonl
/code/.cache/

__pycache__/
*.py[cod]
.DS_Store

# Local Hugging Face Space working copy. The deployed Space is maintained
# separately and is not part of this replication package repository.
/vibench/

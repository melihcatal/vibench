# Copy this file to configs/.env and fill in the keys for the models you run.
# All generation scripts load this exact file from the code/ directory.
# DO NOT commit configs/.env to git.
#
# Each affiliated model uses its parent company's own API.
# This mirrors real-world deployment and avoids third-party confounds.
#
# Quick setup:
#   cd code
#   cp configs/.env.template configs/.env
#   $EDITOR configs/.env
#
# You only need credentials for selected models. For example, a Gemini-only
# smoke test needs GEMINI_API_KEY only; the full direct config needs the active
# benchmark provider keys below plus a local Granite H-Tiny endpoint.

# Google AI Studio (Gemini 2.5 Pro, Gemini 2.5 Flash)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (GPT-5.4, GPT-5.4 Mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI (Grok 4.1 Fast Reasoning)
# https://console.x.ai/
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1

# Amazon Nova — AWS Bedrock route (Nova Pro, Nova Lite)
# https://console.aws.amazon.com/bedrock/
# Use canonical nova-pro / nova-2-lite model IDs in configs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=eu-central-1

# Agentic Nova runs use OpenCode through a local LiteLLM proxy because
# OpenCode's built-in Amazon Bedrock registry does not expose Nova IDs.
# Start the canonical OpenCode proxies with:
#   scripts/generation/start_litellm_proxies.sh
# To run Nova 2 Lite through OpenCode, override:
#   LITELLM_BEDROCK_MODEL=bedrock/eu.amazon.nova-2-lite-v1:0
#   LITELLM_BEDROCK_ALIAS=nova-2-lite
LITELLM_BEDROCK_API_BASE=http://127.0.0.1:4000/v1
LITELLM_BEDROCK_API_KEY=dummy

# Alibaba DashScope (Qwen3.6-Plus, Qwen3-Coder-Flash)
# International: https://dashscope-intl.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# IBM watsonx.ai (Granite 4.0 H-Small, Granite 8B Code Instruct 128K)
# https://cloud.ibm.com/watsonx/
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Agentic Granite H-Small OpenCode runs use a local LiteLLM proxy.
# Start it with scripts/generation/start_litellm_proxies.sh.
LITELLM_WATSONX_API_BASE=http://127.0.0.1:4001/v1
LITELLM_WATSONX_API_KEY=dummy

# Anthropic (Claude Sonnet 4.6)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# DeepSeek (DeepSeek-V3.2)
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Mistral AI (Mistral Large 3)
# https://console.mistral.ai/
MISTRAL_API_KEY=

# --- Optional providers ---
# Moonshot AI (Kimi K2.5) — used in the preliminary pilot run.
# Not part of the current benchmark.
# https://platform.moonshot.cn/
# MOONSHOT_API_KEY=

# Meta Llama API (Llama 4 Maverick) — evaluated during earlier benchmark
# construction but not included in the current canonical run. Set this only if you re-enable Llama in your
# own configs.
# https://llama.developer.meta.com/
# META_LLAMA_API_KEY=

# --- Local models (optional) ---
# Set these if running models locally via vLLM, Ollama, or llama.cpp
# GRANITE_TINY_API_BASE=http://localhost:8001/v1
# GRANITE_SMALL_API_BASE=http://localhost:8002/v1
# LLAMA_API_BASE=http://localhost:8003/v1

# --- Local mlx_lm.server for granite-4.0-h-{tiny,small}-local ---
# The retained direct full config includes granite-4.0-h-tiny-local because
# Granite H-Tiny did not have a hosted watsonx.ai endpoint at evaluation time.
# If you cannot run this local endpoint, run a subset with --model excluding
# granite-4.0-h-tiny-local or edit the YAML config.
#
# Start local OpenAI-compatible MLX servers with:
#   mlx_lm.server --model <granite-4.0-h-tiny snapshot>            --port 8801
#   mlx_lm.server --model <granite-4.0-h-small mixed-3/4 dir>      --port 8802
# The api key is ignored by mlx_lm.server but the OpenAI client requires one.
# LOCAL_MLX_API_KEY=dummy
# LOCAL_MLX_TINY_API_BASE=http://127.0.0.1:8801/v1
# LOCAL_MLX_SMALL_API_BASE=http://127.0.0.1:8802/v1

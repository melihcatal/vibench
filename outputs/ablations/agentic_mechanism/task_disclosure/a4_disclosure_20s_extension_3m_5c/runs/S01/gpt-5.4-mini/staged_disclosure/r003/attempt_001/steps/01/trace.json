        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: register_user.py\n+import os\n+import sys\n+import requests\n+\n+\n+def register_user(email: str, password: str) -> dict:\n+    api_key = os.getenv(\"FIREBASE_API_KEY\")\n+    if not api_key:\n+        raise RuntimeError(\"FIREBASE_API_KEY is required\")\n+    url = f\"https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={api_key}\"\n+    response = requests.post(url, json={\"email\": email, \"password\": password, \"returnSecureToken\": True}, timeout=30)\n+    response.raise_for_status()\n+    return response.json()\n+\n+\n+def main() -> int:\n+    if len(sys.argv) != 3:\n+        raise SystemExit(\"usage: register_user.py EMAIL PASSWORD\")\n+    result = register_user(sys.argv[1], sys.argv[2])\n+    sys.stdout.write(result.get(\"localId\", \"\"))\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-92p3js0b/register_user.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-92p3js0b/register_user.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-92p3js0b/register_user.py\n@@ -0,0 +1,25 @@\n+import os\n+import sys\n+import requests\n+\n+\n+def register_user(email: str, password: str) -> dict:\n+    api_key = os.getenv(\"FIREBASE_API_KEY\")\n+    if not api_key:\n+        raise RuntimeError(\"FIREBASE_API_KEY is required\")\n+    url = f\"https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={api_key}\"\n+    response = requests.post(url, json={\"email\": email, \"password\": password, \"returnSecureToken\": True}, timeout=30)\n+    response.raise_for_status()\n+    return response.json()\n+\n+\n+def main() -> int:\n+    if len(sys.argv) != 3:\n+        raise SystemExit(\"usage: register_user.py EMAIL PASSWORD\")\n+    result = register_user(sys.argv[1], sys.argv[2])\n+    sys.stdout.write(result.get(\"localId\", \"\"))\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n\n",

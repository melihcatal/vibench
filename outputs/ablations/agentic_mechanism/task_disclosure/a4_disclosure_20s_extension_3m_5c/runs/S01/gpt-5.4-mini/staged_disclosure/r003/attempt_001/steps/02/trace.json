                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-92p3js0b/email_password_login.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-92p3js0b/email_password_login.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-92p3js0b/email_password_login.py\n@@ -0,0 +1,34 @@\n+import os\n+from typing import Any, Dict\n+\n+import requests\n+\n+\n+GOOGLE_IDENTITY_TOOLKIT_URL = \"https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword\"\n+\n+\n+def sign_in_with_email_password(email: str, password: str) -> Dict[str, Any]:\n+    api_key = os.environ[\"GOOGLE_API_KEY\"]\n+    response = requests.post(\n+        GOOGLE_IDENTITY_TOOLKIT_URL,\n+        params={\"key\": api_key},\n+        json={\n+            \"email\": email,\n+            \"password\": password,\n+            \"returnSecureToken\": True,\n+        },\n+        timeout=30,\n+    )\n+    response.raise_for_status()\n+    data = response.json()\n+    return {\n+        \"id_token\": data[\"idToken\"],\n+        \"refresh_token\": data[\"refreshToken\"],\n+        \"expires_in\": data[\"expiresIn\"],\n+        \"local_id\": data[\"localId\"],\n+        \"email\": data.get(\"email\", email),\n+    }\n+\n+\n+def login(email: str, password: str) -> Dict[str, Any]:\n+    return sign_in_with_email_password(email, password)\n",

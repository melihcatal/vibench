        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: email_password_login.py\n+import os\n+from typing import Any, Dict\n+\n+import requests\n+\n+\n+def sign_in_with_email_password(email: str, password: str) -> Dict[str, Any]:\n+    api_key = os.environ[\"FIREBASE_WEB_API_KEY\"]\n+    url = f\"https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={api_key}\"\n+    response = requests.post(\n+        url,\n+        json={\n+            \"email\": email,\n+            \"password\": password,\n+            \"returnSecureToken\": True,\n+        },\n+        timeout=30,\n+    )\n+    response.raise_for_status()\n+    data = response.json()\n+    return {\n+        \"id_token\": data[\"idToken\"],\n+        \"refresh_token\": data[\"refreshToken\"],\n+        \"expires_in\": data[\"expiresIn\"],\n+        \"local_id\": data[\"localId\"],\n+    }\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/email_password_login.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/email_password_login.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/email_password_login.py\n@@ -0,0 +1,26 @@\n+import os\n+from typing import Any, Dict\n+\n+import requests\n+\n+\n+def sign_in_with_email_password(email: str, password: str) -> Dict[str, Any]:\n+    api_key = os.environ[\"FIREBASE_WEB_API_KEY\"]\n+    url = f\"https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={api_key}\"\n+    response = requests.post(\n+        url,\n+        json={\n+            \"email\": email,\n+            \"password\": password,\n+            \"returnSecureToken\": True,\n+        },\n+        timeout=30,\n+    )\n+    response.raise_for_status()\n+    data = response.json()\n+    return {\n+        \"id_token\": data[\"idToken\"],\n+        \"refresh_token\": data[\"refreshToken\"],\n+        \"expires_in\": data[\"expiresIn\"],\n+        \"local_id\": data[\"localId\"],\n+    }\n\n",
            "files": [
              {
                "additions": 26,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/email_password_login.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/email_password_login.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/email_password_login.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/email_password_login.py\n@@ -0,0 +1,26 @@\n+import os\n+from typing import Any, Dict\n+\n+import requests\n+\n+\n+def sign_in_with_email_password(email: str, password: str) -> Dict[str, Any]:\n+    api_key = os.environ[\"FIREBASE_WEB_API_KEY\"]\n+    url = f\"https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={api_key}\"\n+    response = requests.post(\n+        url,\n+        json={\n+            \"email\": email,\n+            \"password\": password,\n+            \"returnSecureToken\": True,\n+        },\n+        timeout=30,\n+    )\n+    response.raise_for_status()\n+    data = response.json()\n+    return {\n+        \"id_token\": data[\"idToken\"],\n+        \"refresh_token\": data[\"refreshToken\"],\n+        \"expires_in\": data[\"expiresIn\"],\n+        \"local_id\": data[\"localId\"],\n+    }\n",
                "relativePath": "private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/email_password_login.py",

        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: register_user.py\n+import os\n+import sys\n+from typing import Optional\n+\n+from supabase import Client, create_client\n+\n+\n+def _get_client() -> Client:\n+    url = os.environ.get(\"SUPABASE_URL\")\n+    service_key = os.environ.get(\"SUPABASE_SERVICE_ROLE_KEY\") or os.environ.get(\"SUPABASE_ANON_KEY\")\n+    if not url or not service_key:\n+        raise RuntimeError(\"SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_ANON_KEY) are required\")\n+    return create_client(url, service_key)\n+\n+\n+def register_user(email: str, password: str) -> dict:\n+    client = _get_client()\n+    response = client.auth.sign_up({\"email\": email, \"password\": password})\n+    user = getattr(response, \"user\", None)\n+    session = getattr(response, \"session\", None)\n+    return {\n+        \"user\": user.__dict__ if user is not None else None,\n+        \"session\": session.__dict__ if session is not None else None,\n+    }\n+\n+\n+def main(argv: Optional[list[str]] = None) -> int:\n+    args = sys.argv[1:] if argv is None else argv\n+    if len(args) != 2:\n+        raise SystemExit(\"Usage: register_user.py EMAIL PASSWORD\")\n+    result = register_user(args[0], args[1])\n+    print(result)\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/register_user.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/register_user.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/register_user.py\n@@ -0,0 +1,37 @@\n+import os\n+import sys\n+from typing import Optional\n+\n+from supabase import Client, create_client\n+\n+\n+def _get_client() -> Client:\n+    url = os.environ.get(\"SUPABASE_URL\")\n+    service_key = os.environ.get(\"SUPABASE_SERVICE_ROLE_KEY\") or os.environ.get(\"SUPABASE_ANON_KEY\")\n+    if not url or not service_key:\n+        raise RuntimeError(\"SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_ANON_KEY) are required\")\n+    return create_client(url, service_key)\n+\n+\n+def register_user(email: str, password: str) -> dict:\n+    client = _get_client()\n+    response = client.auth.sign_up({\"email\": email, \"password\": password})\n+    user = getattr(response, \"user\", None)\n+    session = getattr(response, \"session\", None)\n+    return {\n+        \"user\": user.__dict__ if user is not None else None,\n+        \"session\": session.__dict__ if session is not None else None,\n+    }\n+\n+\n+def main(argv: Optional[list[str]] = None) -> int:\n+    args = sys.argv[1:] if argv is None else argv\n+    if len(args) != 2:\n+        raise SystemExit(\"Usage: register_user.py EMAIL PASSWORD\")\n+    result = register_user(args[0], args[1])\n+    print(result)\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n\n",
            "files": [
              {
                "additions": 37,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/register_user.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/register_user.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/register_user.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9alko2p_/register_user.py\n@@ -0,0 +1,37 @@\n+import os\n+import sys\n+from typing import Optional\n+\n+from supabase import Client, create_client\n+\n+\n+def _get_client() -> Client:\n+    url = os.environ.get(\"SUPABASE_URL\")\n+    service_key = os.environ.get(\"SUPABASE_SERVICE_ROLE_KEY\") or os.environ.get(\"SUPABASE_ANON_KEY\")\n+    if not url or not service_key:\n+        raise RuntimeError(\"SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_ANON_KEY) are required\")\n+    return create_client(url, service_key)\n+\n+\n+def register_user(email: str, password: str) -> dict:\n+    client = _get_client()\n+    response = client.auth.sign_up({\"email\": email, \"password\": password})\n+    user = getattr(response, \"user\", None)\n+    session = getattr(response, \"session\", None)\n+    return {\n+        \"user\": user.__dict__ if user is not None else None,\n+        \"session\": session.__dict__ if session is not None else None,\n+    }\n+\n+\n+def main(argv: Optional[list[str]] = None) -> int:\n+    args = sys.argv[1:] if argv is None else argv\n+    if len(args) != 2:\n+        raise SystemExit(\"Usage: register_user.py EMAIL PASSWORD\")\n+    result = register_user(args[0], args[1])\n+    print(result)\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n",

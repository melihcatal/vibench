        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: register_user.py\n+import json\n+import os\n+import sys\n+from urllib import request, error\n+\n+\n+def register_user(email: str, password: str) -> dict:\n+    api_key = os.environ[\"FIREBASE_WEB_API_KEY\"]\n+    url = f\"https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={api_key}\"\n+    payload = json.dumps({\"email\": email, \"password\": password, \"returnSecureToken\": True}).encode(\"utf-8\")\n+    req = request.Request(url, data=payload, headers={\"Content-Type\": \"application/json\"}, method=\"POST\")\n+    try:\n+        with request.urlopen(req, timeout=30) as resp:\n+            return json.loads(resp.read().decode(\"utf-8\"))\n+    except error.HTTPError as exc:\n+        body = exc.read().decode(\"utf-8\", errors=\"replace\")\n+        raise RuntimeError(body) from exc\n+\n+\n+if __name__ == \"__main__\":\n+    if len(sys.argv) != 3:\n+        raise SystemExit(\"usage: python register_user.py <email> <password>\")\n+    result = register_user(sys.argv[1], sys.argv[2])\n+    print(json.dumps(result))\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-wxs2eszo/register_user.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-wxs2eszo/register_user.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-wxs2eszo/register_user.py\n@@ -0,0 +1,24 @@\n+import json\n+import os\n+import sys\n+from urllib import request, error\n+\n+\n+def register_user(email: str, password: str) -> dict:\n+    api_key = os.environ[\"FIREBASE_WEB_API_KEY\"]\n+    url = f\"https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={api_key}\"\n+    payload = json.dumps({\"email\": email, \"password\": password, \"returnSecureToken\": True}).encode(\"utf-8\")\n+    req = request.Request(url, data=payload, headers={\"Content-Type\": \"application/json\"}, method=\"POST\")\n+    try:\n+        with request.urlopen(req, timeout=30) as resp:\n+            return json.loads(resp.read().decode(\"utf-8\"))\n+    except error.HTTPError as exc:\n+        body = exc.read().decode(\"utf-8\", errors=\"replace\")\n+        raise RuntimeError(body) from exc\n+\n+\n+if __name__ == \"__main__\":\n+    if len(sys.argv) != 3:\n+        raise SystemExit(\"usage: python register_user.py <email> <password>\")\n+    result = register_user(sys.argv[1], sys.argv[2])\n+    print(json.dumps(result))\n\n",

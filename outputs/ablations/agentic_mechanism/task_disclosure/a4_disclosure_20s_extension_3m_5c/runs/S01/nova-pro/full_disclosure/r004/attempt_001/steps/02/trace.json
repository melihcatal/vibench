        "callID": "tooluse_pHmIgXeJyaWPrcnm44J6Lb",
        "state": {
          "input": {
            "content": "import firebase_admin\nfrom firebase_admin import auth\nfrom firebase_admin.credentials import Certificate\n\n# Initialize the Firebase Admin SDK with your project's service account key\ncred = Certificate('path/to/serviceAccountKey.json')\nfirebase_admin.initialize_app(cred)\n\ndef sign_in_with_email_and_password(email, password):\n    try:\n        user = auth.get_user_by_email(email)\n        # Verify the password\n        auth.verify_password(password, user.uid)\n        # Create custom tokens\n        custom_token = auth.create_custom_token(user.uid)\n        return custom_token\n    except firebase_admin.auth.UserNotFoundError:\n        print('User not found')\n        return None\n    except firebase_admin.auth.InvalidIdTokenError:\n        print('Invalid credentials')\n        return None",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-rkuncx72/email_password_login.py"

        "callID": "tooluse_DicOFzQb7ktEfI5JdqVraI",
        "state": {
          "input": {
            "content": "import boto3\n\ndef refresh_session():\n    client = boto3.client('cognito-idp', region_name='us-east-1')\n    try:\n        response = client.initiate_auth(\n            AuthFlow='REFRESH_TOKEN_AUTH',\n            AuthParameters={'REFRESH_TOKEN': 'your-refresh-token'}\n        )\n        access_token = response['AuthenticationResult']['AccessToken']\n        print(f'New access token: {access_token}')\n    except client.exceptions.NotAuthorizedException:\n        print('Invalid refresh token.')\n\nif __name__ == '__main__':\n    refresh_session()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-hvm7ayfs/refresh_session.py"

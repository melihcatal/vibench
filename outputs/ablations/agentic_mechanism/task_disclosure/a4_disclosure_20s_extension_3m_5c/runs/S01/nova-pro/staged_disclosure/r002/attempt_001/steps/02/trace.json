      "data": {
        "callID": "tooluse_j1dlHZ7ijRsGOM3g3ifsgW",
        "state": {
          "input": {
            "content": "import firebase_admin\nfrom firebase_admin import auth\n\ncred = firebase_admin.credentials.Certificate('path/to/serviceAccountKey.json')\nfirebase_admin.initialize_app(cred)\n\ndef register_user(email, password):\n    try:\n        user = auth.create_user(email=email, password=password)\n        print(f'Successfully created new user: {user.uid}')\n    except Exception as e:\n        print(f'Error creating user: {e}')\n\n# Example usage:\n# register_user('user@example.com', 'strongPassword123')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-szb3q1cl/register_user.py"

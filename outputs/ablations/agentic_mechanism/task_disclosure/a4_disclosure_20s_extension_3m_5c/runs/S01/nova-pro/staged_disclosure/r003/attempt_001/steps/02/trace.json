      "data": {
        "callID": "tooluse_NdyMdeiHJyikFTvCOjsN4M",
        "state": {
          "input": {
            "content": "import firebase_admin\nfrom firebase_admin import auth\n\nif not firebase_admin._apps:\n    firebase_admin.initialize_app()\n\ndef register_user(email, password):\n    try:\n        user = auth.create_user(email=email, password=password)\n        print(f'Successfully created new user: {user.uid}')\n    except Exception as e:\n        print(f'Error creating user: {e}')\n\n# Example usage:\n# register_user('user@example.com', 'strongPassword123')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-m_j09mjg/register_user.py"
          },

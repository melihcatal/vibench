      "data": {
        "callID": "tooluse_OnYiB2BNGuuJf6rcELOQIa",
        "state": {
          "input": {
            "content": "import firebase_admin\nfrom firebase_admin import auth\n\ndef register_user(email, password):\n    if not firebase_admin._apps:\n        firebase_admin.initialize_app()\n    user = auth.create_user(email=email, password=password)\n    return user.uid\n\nif __name__ == \"__main__\":\n    email = \"user@example.com\"\n    password = \"strongPassword123\"\n    user_id = register_user(email, password)\n    print(f'Successfully registered user with UID: {user_id}')\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-3sd8vw3g/register_user.py"
          },

      "data": {
        "callID": "tooluse_lXjT4bXxdWiWruuTdvyHDr",
        "state": {
          "input": {
            "content": "import boto3\n\ndef start_password_reset(username):\n    client = boto3.client('cognito-idp', region_name='us-east-1')\n    response = client.initiate_auth(\n        AuthFlow='USER_PASSWORD_AUTH',\n        AuthParameters={\n            'USERNAME': username,\n            'PASSWORD': 'placeholder'\n        },\n        ClientId='your_client_id'\n    )\n    if 'ChallengeName' in response and response['ChallengeName'] == 'NEW_PASSWORD_REQUIRED':\n        print('Password reset required')\n    else:\n        print('Password reset not required')\n\nif __name__ == '__main__':\n    start_password_reset('user@example.com')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-3sd8vw3g/password_reset.py"

    {
      "data": {
        "callID": "P01JCMH7UqQOOBHF",
        "metadata": {
          "google": {
            "thoughtSignature": ""
          }
        },
        "state": {
          "input": {
            "content": "\\\nimport os\\n\\\nimport urllib.parse\\n\\\n\\n\\\n# Google OAuth 2.0 Configuration\\n\\\nGOOGLE_AUTH_URL = \"https://accounts.google.com/o/oauth2/auth\"\\n\\\nGOOGLE_TOKEN_URL = \"https://oauth2.googleapis.com/token\" # Not used in this \"start login\" example, but good to have.\\n\\\n\\n\\\n# Replace with your actual Google OAuth client ID\\n\\\n# You can get this from the Google Cloud Console: APIs & Services -> Credentials\\n\\\nCLIENT_ID = os.environ.get(\"GOOGLE_CLIENT_ID\", \"YOUR_GOOGLE_CLIENT_ID\")\\n\\\n\\n\\\n# Replace with your actual redirect URI\\n\\\n# This must be registered in your Google Cloud Console for the OAuth client ID\\n\\\nREDIRECT_URI = os.environ.get(\"GOOGLE_REDIRECT_URI\", \"http://localhost:8080/callback\")\\n\\\n\\n\\\n# Scopes define the level of access you are requesting.\\n\\\n# For example, \"openid email profile\" requests access to the user\\'s ID, email, and basic profile information.\\n\\\nSCOPES = [\"openid\", \"email\", \"profile\"]\\n\\\n\\n\\\ndef start_oauth_login():\\n\\\n    \"\"\"\\n\\\n    Constructs and prints the Google OAuth authorization URL.\\n\\\n    The user needs to open this URL in their browser to initiate the login process.\\n\\\n    \"\"\"\\n\\\n    params = {\\n\\\n        \"client_id\": CLIENT_ID,\\n\\\n        \"redirect_uri\": REDIRECT_URI,\\n\\\n        \"response_type\": \"code\",\\n\\\n        \"scope\": \" \".join(SCOPES),\\n\\\n        \"access_type\": \"offline\",  # To get a refresh token for long-lived access\\n\\\n        \"prompt\": \"consent\",  # To ensure the consent screen is shown even if already authorized\\n\\\n    }\\n\\\n    \\n\\\n    authorization_url = f\"{GOOGLE_AUTH_URL}?{urllib.parse.urlencode(params)}\"\\n\\\n    print(f\"Please open the following URL in your browser to start the Google OAuth login:\\\\n{authorization_url}\")\\n\\\n\\n\\\nif __name__ == \"__main__\":\\n\\\n    start_oauth_login()\\n\\\n",

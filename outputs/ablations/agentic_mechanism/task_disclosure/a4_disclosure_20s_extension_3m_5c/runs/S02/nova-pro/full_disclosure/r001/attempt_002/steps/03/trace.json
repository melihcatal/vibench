      "data": {
        "callID": "tooluse_C4KVuELOZj90JjTLaHygPK",
        "state": {
          "input": {
            "content": "import os\nfrom flask import Flask, request\nfrom google.oauth2 import id_token\nfrom google.auth.transport import requests\n\napp = Flask(__name__)\n\n@app.route('/oauth_callback', methods=['GET'])\ndef oauth_callback():\n    auth_code = request.args.get('code')\n    try:\n        id_info = id_token.verify_oauth2_token(auth_code, requests.Request(), os.getenv('GOOGLE_CLIENT_ID'))\n        if id_info['aud']!= os.getenv('GOOGLE_CLIENT_ID'):\n            raise ValueError('Invalid audience.')\n        user_id = id_info['sub']\n        access_token = id_info['access_token']\n        return {'user_id': user_id, 'access_token': access_token}\n    except ValueError:\n        return 'Invalid token', 400\n\nif __name__ == '__main__':\n    app.run(port=5000)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-o9ek_57l/oauth_callback.py"

      "data": {
        "callID": "tooluse_Nc93JP5oiIitk1XN6KtPvV",
        "state": {
          "input": {
            "content": "from google.oauth2 import service_account\nfrom googleapiclient.discovery import build\n\n# Set up the OAuth2 client\ncredentials = service_account.Credentials.from_service_account_file(\n    'path/to/service-account.json',\n    scopes=['https://www.googleapis.com/auth/userinfo.profile']\n)\n\nservice = build('oauth2', 'v2', credentials=credentials)\n\n\ndef fetch_profile_claims(access_token):\n    \"\"\"Fetches user profile claims using the Google OAuth2 API.\"\"\"\n    try:\n        profile = service.userinfo().get().execute()\n        return profile\n    except Exception as e:\n        print(f'Error fetching profile claims: {e}')\n        return None\n\n\ndef normalize_profile_claims(profile):\n    \"\"\"Normalizes user profile claims.\"\"\"\n    normalized_claims = {\n        'name': profile.get('name', ''),\n        'email': profile.get('email', ''),\n        'picture': profile.get('picture', ''),\n    }\n    return normalized_claims",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-h9_yu571/profile_claims.py"
          },

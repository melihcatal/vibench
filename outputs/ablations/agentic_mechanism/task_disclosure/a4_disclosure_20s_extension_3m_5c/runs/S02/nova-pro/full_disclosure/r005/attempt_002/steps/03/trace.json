        "callID": "tooluse_IuIjs8yosiTCjwufQHXqFP",
        "state": {
          "input": {
            "content": "import os\nimport requests\n\nGOOGLE_OAUTH_TOKEN_URL = 'https://oauth2.googleapis.com/token'\n\ndef handle_oauth_callback(authorization_code):\n    token_data = {\n        'code': authorization_code,\n        'client_id': os.getenv('GOOGLE_CLIENT_ID'),\n        'client_secret': os.getenv('GOOGLE_CLIENT_SECRET'),\n        'redirect_uri': os.getenv('GOOGLE_REDIRECT_URI'),\n        'grant_type': 'authorization_code'\n    }\n    response = requests.post(GOOGLE_OAUTH_TOKEN_URL, data=token_data)\n    response.raise_for_status()\n    return response.json()\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-h9_yu571/oauth_callback.py"

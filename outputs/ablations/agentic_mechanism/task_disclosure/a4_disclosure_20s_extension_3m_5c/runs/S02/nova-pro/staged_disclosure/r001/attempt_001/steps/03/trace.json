      "data": {
        "callID": "tooluse_1XBQ2HjnNaadQS2gMe3lev",
        "state": {
          "input": {
            "content": "import os\nimport requests\n\n# Google OAuth2 configuration\nGOOGLE_CLIENT_ID = os.getenv('GOOGLE_CLIENT_ID')\nGOOGLE_CLIENT_SECRET = os.getenv('GOOGLE_CLIENT_SECRET')\nGOOGLE_REDIRECT_URI = os.getenv('GOOGLE_REDIRECT_URI')\n\ndef exchange_code_for_tokens(code):\n    \"\"\"Exchanges an authorization code for access and refresh tokens.\"\"\"\n    token_url = 'https://oauth2.googleapis.com/token'\n    token_data = {\n        'code': code,\n        'client_id': GOOGLE_CLIENT_ID,\n        'client_secret': GOOGLE_CLIENT_SECRET,\n        'redirect_uri': GOOGLE_REDIRECT_URI,\n        'grant_type': 'authorization_code'\n    }\n    response = requests.post(token_url, data=token_data)\n    response.raise_for_status()\n    return response.json()\n\nif __name__ == '__main__':\n    import sys\n    if len(sys.argv)!= 2:\n        print('Usage: python oauth_callback.py <authorization_code>')\n        sys.exit(1)\n    authorization_code = sys.argv[1]\n    tokens = exchange_code_for_tokens(authorization_code)\n    print('Access Token:', tokens['access_token'])\n    print('Refresh Token:', tokens['refresh_token'])",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-z1j0asfd/oauth_callback.py"

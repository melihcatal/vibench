      "data": {
        "callID": "tooluse_XdHIkno7DSlDrVaIwEQ4sw",
        "state": {
          "input": {
            "content": "import os\nimport google.auth\nfrom google.oauth2 import service_account\nfrom google_auth_oauthlib.flow import InstalledAppFlow\n\n# Define the scopes\nSCOPES = ['https://www.googleapis.com/auth/userinfo.profile', 'https://www.googleapis.com/auth/userinfo.email']\n\n# Load the client secrets from the environment variable\nCLIENT_SECRETS_FILE = os.getenv('GOOGLE_CLIENT_SECRETS_FILE')\n\ndef start_oauth_login():\n    flow = InstalledAppFlow.from_client_secrets_file(CLIENT_SECRETS_FILE, SCOPES)\n    credentials = flow.run_local_server(port=0)\n    print('Authentication successful!')\n\nif __name__ == '__main__':\n    start_oauth_login()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-z1j0asfd/start_oauth_login.py"

      "data": {
        "callID": "tooluse_4hN4chwVrGAxObs3qYeuiP",
        "state": {
          "input": {
            "content": "from google_auth_oauthlib.flow import InstalledAppFlow\n\n\ndef start_oauth_login():\n    flow = InstalledAppFlow.from_client_secrets_file(\n        'client_secret.json',\n        scopes=['https://www.googleapis.com/auth/userinfo.profile',\n                'https://www.googleapis.com/auth/userinfo.email'])\n    flow.run_local_server(port=0)\n\n\nif __name__ == '__main__':\n    start_oauth_login()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-vdu3tz52/start_oauth_login.py"
          },

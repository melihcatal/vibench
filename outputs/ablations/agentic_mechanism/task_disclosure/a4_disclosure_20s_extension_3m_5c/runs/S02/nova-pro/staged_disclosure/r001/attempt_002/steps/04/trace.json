        "callID": "tooluse_PQfC8IrNA3PiinCD9aA7JH",
        "state": {
          "input": {
            "content": "import os\nimport requests\n\n# Google OAuth2 configuration\nGOOGLE_CLIENT_ID = os.getenv('GOOGLE_CLIENT_ID')\nGOOGLE_CLIENT_SECRET = os.getenv('GOOGLE_CLIENT_SECRET')\n\ndef exchange_code_for_tokens(code):\n    \"\"\"Exchanges an authorization code for tokens using Google OAuth2.\"\"\"\n    token_url = 'https://oauth2.googleapis.com/token'\n    data = {\n        'code': code,\n        'client_id': GOOGLE_CLIENT_ID,\n        'client_secret': GOOGLE_CLIENT_SECRET,\n        'redirect_uri': 'http://localhost:8000/oauth_callback',\n        'grant_type': 'authorization_code'\n    }\n    response = requests.post(token_url, data=data)\n    response.raise_for_status()\n    return response.json()\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-vdu3tz52/oauth_callback.py"

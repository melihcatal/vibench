    {
      "data": {
        "callID": "tooluse_xPWsRKNGnwMird18hPGuGQ",
        "state": {
          "input": {
            "content": "import os\nimport google.auth\nfrom google.oauth2 import service_account\nfrom googleapiclient.discovery import build\n\n# Set up the credentials\ncredentials, project = google.auth.default()\n\n# Build the service\nservice = build('oauth2', 'v2', credentials=credentials)\n\ndef fetch_profile_claims(user_id):\n    # Fetch the user info\n    user_info = service.userinfo().get(userId=user_id).execute()\n    \n    # Normalize the claims\n    normalized_claims = {\n        'name': user_info.get('name', ''),\n        'email': user_info.get('email', ''),\n        'picture': user_info.get('picture', '')\n    }\n    return normalized_claims",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-vdu3tz52/profile_claims.py"

        "callID": "tooluse_kDdiN1w09Po4AuSWxumjW1",
        "state": {
          "input": {
            "content": "import os\nimport flask\nfrom google.oauth2 import id_token\nfrom google.auth.transport import requests\n\napp = flask.Flask(__name__)\n\n@app.route('/oauth_callback')\ndef oauth_callback():\n    code = flask.request.args.get('code')\n    try:\n        token = id_token.verify_oauth2_token(code, requests.Request(), os.getenv('GOOGLE_CLIENT_ID'))\n        return flask.jsonify({'access_token': token['access_token']})\n    except ValueError:\n        return flask.jsonify({'error': 'Invalid token'}), 400\n\nif __name__ == '__main__':\n    app.run()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-nnaom5yr/oauth_callback.py"

    {
      "data": {
        "callID": "tooluse_Hwh4OQZ0voBaJ59GlIJ2zS",
        "state": {
          "input": {
            "content": "import os\nimport requests\n\nCLIENT_ID = os.getenv('GOOGLE_CLIENT_ID')\nCLIENT_SECRET = os.getenv('GOOGLE_CLIENT_SECRET')\n\ndef exchange_code_for_tokens(code):\n    token_url = 'https://oauth2.googleapis.com/token'\n    payload = {\n        'code': code,\n        'client_id': CLIENT_ID,\n        'client_secret': CLIENT_SECRET,\n        'redirect_uri': 'http://localhost:8000/oauth_callback',\n        'grant_type': 'authorization_code'\n    }\n    response = requests.post(token_url, data=payload)\n    response.raise_for_status()\n    return response.json()\n\nif __name__ == '__main__':\n    code = os.getenv('AUTHORIZATION_CODE')\n    tokens = exchange_code_for_tokens(code)\n    print(tokens)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-4p6z85f5/oauth_callback.py"

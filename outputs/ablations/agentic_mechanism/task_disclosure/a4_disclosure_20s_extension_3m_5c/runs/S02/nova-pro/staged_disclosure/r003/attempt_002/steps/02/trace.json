    {
      "data": {
        "callID": "tooluse_LghZCT2kIqu5gPlo02QH2d",
        "state": {
          "input": {
            "content": "import os\nimport flask\nfrom google.oauth2 import service_account\n\napp = flask.Flask(__name__)\n\n@app.route('/login')\ndef login():\n    flow = service_account.Flow.from_client_secrets_file(\n        'client_secrets.json',\n        scopes=['https://www.googleapis.com/auth/userinfo.profile',\n                'https://www.googleapis.com/auth/userinfo.email'])\n    flow.redirect_uri = 'http://localhost:5000/oauth2callback'\n    authorization_url, state = flow.authorization_url(\n        access_type='offline',\n        include_granted_scopes='true')\n    flask.session['state'] = state\n    return flask.redirect(authorization_url)\n\n@app.route('/oauth2callback')\ndef oauth2callback():\n    state = flask.session['state']\n    flow = service_account.Flow.from_client_secrets_file(\n        'client_secrets.json', state=state,\n        scopes=['https://www.googleapis.com/auth/userinfo.profile',\n                'https://www.googleapis.com/auth/userinfo.email'])\n    flow.redirect_uri = 'http://localhost:5000/oauth2callback'\n    if 'code' not in flask.request.args:\n        return flask.redirect(flask.url_for('login'))\n    authorization_response = flask.request.url\n    flow.fetch_token(authorization_response=authorization_response)\n    credentials = flow.credentials\n    return 'Credentials: {}'.format(credentials)\n\nif __name__ == '__main__':\n    app.secret_key = os.urandom(24)\n    app.run(debug=True, port=5000)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-4p6z85f5/start_oauth_login.py"

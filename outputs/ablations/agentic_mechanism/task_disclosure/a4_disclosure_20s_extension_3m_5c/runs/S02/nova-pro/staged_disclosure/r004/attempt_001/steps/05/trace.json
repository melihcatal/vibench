    {
      "data": {
        "callID": "tooluse_4Lp44xHxMS0P6wsI1MXHDY",
        "state": {
          "input": {
            "content": "from auth0.v3.authentication import GetToken\nfrom auth0.v3.management import Auth0\n\n# Configuration\nDOMAIN = 'your-domain.auth0.com'\nCLIENT_ID = 'your-client-id'\nCLIENT_SECRET = 'your-client-secret'\n\n# Client Helper Function\ndef get_management_token():\n    get_token = GetToken(DOMAIN)\n    token = get_token.client_credentials(CLIENT_ID, CLIENT_SECRET, 'https://{}/'.format(DOMAIN))\n    return token['access_token']\n\ndef create_auth0_client():\n    management_token = get_management_token()\n    return Auth0(DOMAIN, management_token)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-mmgb6pz7/identity_client.py"

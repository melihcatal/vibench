    },
    {
      "data": {
        "callID": "ZUG4lZUcXBABvUBT",
        "metadata": {
          "google": {
            "thoughtSignature": ""
          }
        },
        "state": {
          "input": {
            "content": "\nfrom google.cloud import speech\n\ndef handle_streaming_recognition_response(response: speech.StreamingRecognizeResponse):\n    \"\"\"\n    Handles a StreamingRecognizeResponse from Google Cloud Speech-to-Text,\n    processing partial and final recognition results.\n    \"\"\"\n    for result in response.results:\n        if result.is_final:\n            print(f\"Final Transcript: {result.alternatives[0].transcript}\")\n        else:\n            print(f\"Partial Transcript: {result.alternatives[0].transcript}\")\n\n",
            "filePath": "partial_results.py"
          },

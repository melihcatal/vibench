      "data": {
        "callID": "tooluse_4MJyRtwGMLdRWSXuf13eH0",
        "state": {
          "input": {
            "content": "import asyncio\nimport boto3\n\ntranscribe = boto3.client('transcribe', region_name='us-west-2')\n\nasync def stream_audio_chunks(audio_source):\n    async for chunk in audio_source:\n        await process_audio_chunk(chunk)\n\nasync def process_audio_chunk(chunk):\n    response = transcribe.start_stream_transcription(\n        LanguageCode='en-US',\n        MediaEncoding='pcm',\n        MediaSampleRateHertz=16000,\n        StreamURL='https://your-stream-url'\n    )\n    print(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-4vrj8v49/stream_chunks.py"
          },

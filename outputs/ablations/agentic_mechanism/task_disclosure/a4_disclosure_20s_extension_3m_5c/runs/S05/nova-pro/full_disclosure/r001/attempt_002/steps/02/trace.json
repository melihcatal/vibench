    {
      "data": {
        "callID": "tooluse_JKkIk9gK3ylSuqcNGWji64",
        "state": {
          "input": {
            "content": "import os\nfrom google.cloud import speech_v1 as speech\nfrom google.cloud.speech_v1 import types\n\n# Set up the client\nclient = speech.SpeechClient()\n\ndef stream_microphone_audio():\n    config = types.RecognitionConfig(\n        encoding=speech.RecognitionConfig.AudioEncoding.LINEAR16,\n        sample_rate_hertz=16000,\n        language_code='en-US',\n        enable_automatic_punctuation=True\n    )\n    streaming_config = types.StreamingRecognitionConfig(\n        config=config,\n        interim_results=True\n    )\n\n    # Stream audio from the microphone\n    with open('microphone_audio.raw', 'rb') as audio_file:\n        audio_generator = audio_file\n        requests = (types.StreamingRecognizeRequest(audio_content=content)\n                    for content in audio_generator)\n\n        responses = client.streaming_recognize(streaming_config, requests)\n\n        # Yield interim transcripts\n        for response in responses:\n            for result in response.results:\n                yield result.alternatives[0].transcript\n\nif __name__ == '__main__':\n    os.environ['GOOGLE_APPLICATION_CREDENTIALS'] = 'path/to/your-service-account-file.json'\n    for transcript in stream_microphone_audio():\n        print(transcript)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-4vrj8v49/stream_microphone.py"
          },

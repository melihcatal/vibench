        "state": {
          "input": {
            "content": "import io\nimport os\nfrom google.cloud import speech\nfrom google.cloud.speech import enums\nfrom google.cloud.speech import types\n\ndef stream_microphone():\n    os.environ['GOOGLE_APPLICATION_CREDENTIALS'] = 'path/to/credentials.json'\n    client = speech.SpeechClient()\n\n    config = types.RecognitionConfig(\n        encoding=enums.RecognitionConfig.AudioEncoding.LINEAR16,\n        sample_rate_hertz=16000,\n        language_code='en-US',\n        enable_automatic_punctuation=True)\n\n    streaming_config = types.StreamingRecognitionConfig(config=config, interim_results=True)\n\n    with io.BytesIO() as stream:\n        while True:\n            chunk = stream.read(1024)\n            if not chunk:\n                break\n            audio = types.StreamingRecognizeRequest(audio_content=chunk)\n            responses = client.streaming_recognize(streaming_config, [audio])\n            for response in responses:\n                for result in response.results:\n                    print('Transcript: {}'.format(result.alternatives[0].transcript))\n\nif __name__ == '__main__':\n    stream_microphone()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dyi1r9il/stream_microphone.py"

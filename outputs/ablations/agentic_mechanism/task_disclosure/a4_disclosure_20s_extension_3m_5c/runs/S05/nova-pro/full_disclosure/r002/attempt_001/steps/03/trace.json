        "callID": "tooluse_tn9PN7hzwgZ8HFbg94VFf8",
        "state": {
          "input": {
            "content": "import boto3\n\ndef stream_audio_chunks(bucket_name, object_key):\n    s3 = boto3.client('s3')\n    response = s3.get_object(Bucket=bucket_name, Key=object_key)\n    audio_stream = response['Body']\n    chunk_size = 1024 * 1024  # 1 MB chunks\n    while True:\n        chunk = audio_stream.read(chunk_size)\n        if not chunk:\n            break\n        yield chunk",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dyi1r9il/stream_chunks.py"

      "data": {
        "callID": "tooluse_KIMjeog5OHngiqRLKe76vY",
        "state": {
          "input": {
            "content": "from google.cloud import speech_v1p1beta1 as speech\n\ndef handle_streaming_recognition(audio_chunks):\n    client = speech.SpeechClient()\n    config = speech.RecognitionConfig(\n        encoding=speech.RecognitionConfig.AudioEncoding.LINEAR16,\n        sample_rate_hertz=16000,\n        language_code='en-US',\n    )\n    streaming_config = speech.StreamingRecognitionConfig(config=config)\n\n    responses = client.streaming_recognize(\n        streaming_config, audio_chunks)\n\n    for response in responses:\n        for result in response.results:\n            if not result.is_final:\n                print(f'Partial transcript: {result.alternatives[0].transcript}')\n            else:\n                print(f'Final transcript: {result.alternatives[0].transcript}')\n\n# Example usage:\n# audio_chunks = [...]  # List of audio chunks\n# handle_streaming_recognition(audio_chunks)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-gcqfs4qn/partial_results.py"

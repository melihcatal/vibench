        "callID": "tooluse_ykI69bAfwrk3L3JwLYIUeq",
        "state": {
          "input": {
            "content": "import asyncio\nimport boto3\n\ntranscribe = boto3.client('transcribe')\n\nasync def stream_audio_chunks(audio_source):\n    async for chunk in audio_source:\n        response = transcribe.start_stream_transcription(\n            LanguageCode='en-US',\n            MediaEncoding='pcm',\n            MediaSampleRate=16000,\n            AudioStream=chunk\n        )\n        yield response",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fp_dcny7/stream_chunks.py"

    {
      "data": {
        "callID": "tooluse_ZDTcvtLndwI31F4JUwqXqx",
        "state": {
          "input": {
            "content": "import os\nimport io\nimport time\nfrom google.cloud import speech\nfrom google.cloud.speech import enums\nfrom google.cloud.speech import types\n\n# Set environment variables\nos.environ['GOOGLE_APPLICATION_CREDENTIALS'] = 'path/to/your/credentials.json'\n\ndef stream_microphone():\n    client = speech.SpeechClient()\n\n    def callback(response):\n        print('Transcript: {}'.format(response.results[-1].alternatives[0].transcript))\n\n    audio_config = types.RecognitionConfig(\n        encoding=enums.RecognitionConfig.AudioEncoding.LINEAR16,\n        sample_rate_hertz=16000,\n        language_code='en-US',\n        max_alternatives=1,\n        enable_automatic_punctuation=True)\n\n    streaming_config = types.StreamingRecognitionConfig(\n        config=audio_config,\n        interim_results=True)\n\n    with io.BytesIO() as stream:\n        stream.write(b'\\xff\\xf0')\n        stream.seek(0)\n\n        requests = (types.StreamingRecognizeRequest(audio_content=content)\n                    for content in stream)\n\n        responses = client.streaming_recognize(streaming_config, requests)\n\n        for response in responses:\n            callback(response)\n            time.sleep(1)\n\nif __name__ == '__main__':\n    stream_microphone()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-oan0nahr/stream_microphone.py"

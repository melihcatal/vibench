      "data": {
        "callID": "tooluse_JzQMM17KEQsH0kNYCnRXRB",
        "state": {
          "input": {
            "content": "import boto3\nimport asyncio\n\nasync def stream_audio():\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        Text='Hello, this is a test audio stream from AWS Polly.',\n        OutputFormat='mp3',\n        VoiceId='Joanna'\n    )\n    if 'AudioStream' in response:\n        async for chunk in response['AudioStream'].iter_chunks():\n            yield chunk\n\nasync def main():\n    async for chunk in stream_audio():\n        print(chunk)\n\nasyncio.run(main())",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-nano_l_t/stream_chunks.py"
          },

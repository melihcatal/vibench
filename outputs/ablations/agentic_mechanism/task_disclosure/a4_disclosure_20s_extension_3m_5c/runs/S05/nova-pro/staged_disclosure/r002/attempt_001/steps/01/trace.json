    {
      "data": {
        "callID": "tooluse_ojykR8orzR81Vbkh2opq54",
        "state": {
          "input": {
            "content": "import io\nimport os\nfrom google.cloud import speech\nfrom google.cloud.speech import enums\nfrom google.cloud.speech import types\n\nclient = speech.SpeechClient()\n\ndef stream_microphone():\n    audio = io.BytesIO()\n    with speech.SpeechClient() as client:\n        config = types.RecognitionConfig(\n            encoding=enums.RecognitionConfig.AudioEncoding.LINEAR16,\n            sample_rate_hertz=16000,\n            language_code='en-US',\n            max_alternatives=1,\n            enable_automatic_punctuation=True,\n            interim_results=True)\n\n        streaming_config = types.StreamingRecognitionConfig(config=config)\n\n        with client.streaming_recognize(streaming_config) as stream:\n            while True:\n                chunk = audio.read(1024)\n                if not chunk:\n                    break\n                audio.write(chunk)\n                stream.send_audio(chunk)\n                response = stream.next()\n                for result in response.results:\n                    yield result.alternatives[0].transcript\n\nif __name__ == '__main__':\n    for transcript in stream_microphone():\n        print(transcript)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-yaymcxcs/stream_microphone.py"
          },

    {
      "data": {
        "callID": "tooluse_sGjdAbMwhFq8XLxloxnjgW",
        "state": {
          "input": {
            "content": "import asyncio\nimport boto3\n\npolly_client = boto3.client('polly')\n\nasync def stream_audio_chunks(text):\n    response = polly_client.synthesize_speech(\n        Text=text,\n        OutputFormat='mp3',\n        VoiceId='Joanna'\n    )\n    if 'AudioStream' in response:\n        async for chunk in response['AudioStream'].iter_chunks():\n            yield chunk\n    else:\n        raise Exception('AudioStream not found in response')\n\nasync def main():\n    text = 'Hello, this is a test stream from Amazon Polly.'\n    async for chunk in stream_audio_chunks(text):\n        print(chunk)\n\nasyncio.run(main())",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-p7oyt3mo/stream_chunks.py"
          },
          "metadata": {

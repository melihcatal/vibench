    {
      "data": {
        "text": "\"Create stream_microphone.py in the current working directory.\nTask: streams microphone audio and yields interim transcripts.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bbf1038a001gdA1Uk4oY3fnTG",
      "message_id": "msg_0bbf10385001UZ08Ai4k46u3jq",
      "session_id": "ses_f440efc93ffeC8n5H03WYxDS1e",

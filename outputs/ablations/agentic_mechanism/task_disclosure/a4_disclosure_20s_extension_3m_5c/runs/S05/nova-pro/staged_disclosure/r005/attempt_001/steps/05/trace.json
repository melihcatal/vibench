        "callID": "tooluse_lSg60s7xYaehwI4HBZ8203",
        "state": {
          "input": {
            "content": "import asyncio\nimport boto3\n\npolly_client = boto3.client('polly')\n\nasync def stream_audio(text):\n    response = polly_client.synthesize_speech(\n        Text=text,\n        OutputFormat='mp3',\n        VoiceId='Joanna'\n    )\n    if 'AudioStream' in response:\n        async for chunk in response['AudioStream'].iter_chunks():\n            yield chunk\n\nasync def main():\n    async for chunk in stream_audio('Hello, this is a test audio stream.'):\n        print(chunk)\n\nasyncio.run(main())",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-p98ujbt5/stream_chunks.py"

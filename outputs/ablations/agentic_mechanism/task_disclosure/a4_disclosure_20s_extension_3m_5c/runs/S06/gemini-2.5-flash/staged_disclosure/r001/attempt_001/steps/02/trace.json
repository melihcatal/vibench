      "data": {
        "text": "\"Create synthesize_ssml.py in the current working directory.\nTask: synthesizes SSML with voice and prosody controls.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc009e9e001DmoktpnH7zXO3V",

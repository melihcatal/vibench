      "data": {
        "text": "\"Create select_voice.py in the current working directory.\nTask: lists or selects a voice for a target locale.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc6e803d001IJ07ImivSvouQ2",
      "message_id": "msg_0bc6e803c001lAt1GjM1qS1M2W",

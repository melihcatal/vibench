        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: synthesize_text.py\n+import os\n+from typing import Optional\n+\n+from elevenlabs.client import ElevenLabs\n+\n+\n+def synthesize_text(text: str, voice_id: Optional[str] = None, model_id: str = \"eleven_multilingual_v2\") -> bytes:\n+    client = ElevenLabs(api_key=os.environ[\"ELEVENLABS_API_KEY\"])\n+    selected_voice_id = voice_id or os.environ.get(\"ELEVENLABS_VOICE_ID\", \"Rachel\")\n+    audio = client.text_to_speech.convert(\n+        voice_id=selected_voice_id,\n+        model_id=model_id,\n+        text=text,\n+        output_format=\"mp3_44100_128\",\n+    )\n+    if isinstance(audio, bytes):\n+        return audio\n+    return b\"\".join(audio)\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_text.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_text.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_text.py\n@@ -0,0 +1,18 @@\n+import os\n+from typing import Optional\n+\n+from elevenlabs.client import ElevenLabs\n+\n+\n+def synthesize_text(text: str, voice_id: Optional[str] = None, model_id: str = \"eleven_multilingual_v2\") -> bytes:\n+    client = ElevenLabs(api_key=os.environ[\"ELEVENLABS_API_KEY\"])\n+    selected_voice_id = voice_id or os.environ.get(\"ELEVENLABS_VOICE_ID\", \"Rachel\")\n+    audio = client.text_to_speech.convert(\n+        voice_id=selected_voice_id,\n+        model_id=model_id,\n+        text=text,\n+        output_format=\"mp3_44100_128\",\n+    )\n+    if isinstance(audio, bytes):\n+        return audio\n+    return b\"\".join(audio)\n\n",

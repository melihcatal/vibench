    {
      "data": {
        "callID": "call_BY9LxjlzmMMzwHvgvO3on35b",
        "metadata": {
          "openai": {
            "itemId": "fc_0291e325f84eca4c016aaf1ad8fa8c87d291348dbc944710e7"

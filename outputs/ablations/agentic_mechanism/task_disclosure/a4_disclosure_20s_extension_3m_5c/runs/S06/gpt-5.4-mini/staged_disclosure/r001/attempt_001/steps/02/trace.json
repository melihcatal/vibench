        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: synthesize_ssml.py\n+import os\n+from typing import Optional\n+\n+from google.cloud import texttospeech\n+\n+\n+def synthesize_ssml(ssml: str, output_path: str, language_code: str = \"en-US\", voice_name: Optional[str] = None) -> None:\n+    client = texttospeech.TextToSpeechClient()\n+    synthesis_input = texttospeech.SynthesisInput(ssml=ssml)\n+\n+    voice = texttospeech.VoiceSelectionParams(language_code=language_code, name=voice_name or \"en-US-Standard-C\")\n+    audio_config = texttospeech.AudioConfig(audio_encoding=texttospeech.AudioEncoding.MP3)\n+\n+    response = client.synthesize_speech(input=synthesis_input, voice=voice, audio_config=audio_config)\n+\n+    with open(output_path, \"wb\") as out:\n+        out.write(response.audio_content)\n+\n+\n+def _main() -> None:\n+    ssml = os.environ.get(\"SSML_TEXT\", \"<speak><prosody rate='medium' pitch='+2st'>Hello from Google Cloud Text-to-Speech.</prosody></speak>\")\n+    output_path = os.environ.get(\"OUTPUT_PATH\", \"output.mp3\")\n+    language_code = os.environ.get(\"LANGUAGE_CODE\", \"en-US\")\n+    voice_name = os.environ.get(\"VOICE_NAME\")\n+    synthesize_ssml(ssml, output_path, language_code=language_code, voice_name=voice_name)\n+\n+\n+if __name__ == \"__main__\":\n+    _main()\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_ssml.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_ssml.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_ssml.py\n@@ -0,0 +1,29 @@\n+import os\n+from typing import Optional\n+\n+from google.cloud import texttospeech\n+\n+\n+def synthesize_ssml(ssml: str, output_path: str, language_code: str = \"en-US\", voice_name: Optional[str] = None) -> None:\n+    client = texttospeech.TextToSpeechClient()\n+    synthesis_input = texttospeech.SynthesisInput(ssml=ssml)\n+\n+    voice = texttospeech.VoiceSelectionParams(language_code=language_code, name=voice_name or \"en-US-Standard-C\")\n+    audio_config = texttospeech.AudioConfig(audio_encoding=texttospeech.AudioEncoding.MP3)\n+\n+    response = client.synthesize_speech(input=synthesis_input, voice=voice, audio_config=audio_config)\n+\n+    with open(output_path, \"wb\") as out:\n+        out.write(response.audio_content)\n+\n+\n+def _main() -> None:\n+    ssml = os.environ.get(\"SSML_TEXT\", \"<speak><prosody rate='medium' pitch='+2st'>Hello from Google Cloud Text-to-Speech.</prosody></speak>\")\n+    output_path = os.environ.get(\"OUTPUT_PATH\", \"output.mp3\")\n+    language_code = os.environ.get(\"LANGUAGE_CODE\", \"en-US\")\n+    voice_name = os.environ.get(\"VOICE_NAME\")\n+    synthesize_ssml(ssml, output_path, language_code=language_code, voice_name=voice_name)\n+\n+\n+if __name__ == \"__main__\":\n+    _main()\n\n",
            "files": [
              {
                "additions": 29,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_ssml.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_ssml.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_ssml.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_ssml.py\n@@ -0,0 +1,29 @@\n+import os\n+from typing import Optional\n+\n+from google.cloud import texttospeech\n+\n+\n+def synthesize_ssml(ssml: str, output_path: str, language_code: str = \"en-US\", voice_name: Optional[str] = None) -> None:\n+    client = texttospeech.TextToSpeechClient()\n+    synthesis_input = texttospeech.SynthesisInput(ssml=ssml)\n+\n+    voice = texttospeech.VoiceSelectionParams(language_code=language_code, name=voice_name or \"en-US-Standard-C\")\n+    audio_config = texttospeech.AudioConfig(audio_encoding=texttospeech.AudioEncoding.MP3)\n+\n+    response = client.synthesize_speech(input=synthesis_input, voice=voice, audio_config=audio_config)\n+\n+    with open(output_path, \"wb\") as out:\n+        out.write(response.audio_content)\n+\n+\n+def _main() -> None:\n+    ssml = os.environ.get(\"SSML_TEXT\", \"<speak><prosody rate='medium' pitch='+2st'>Hello from Google Cloud Text-to-Speech.</prosody></speak>\")\n+    output_path = os.environ.get(\"OUTPUT_PATH\", \"output.mp3\")\n+    language_code = os.environ.get(\"LANGUAGE_CODE\", \"en-US\")\n+    voice_name = os.environ.get(\"VOICE_NAME\")\n+    synthesize_ssml(ssml, output_path, language_code=language_code, voice_name=voice_name)\n+\n+\n+if __name__ == \"__main__\":\n+    _main()\n",
                "relativePath": "private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fwlyt01l/synthesize_ssml.py",
                "type": "add"

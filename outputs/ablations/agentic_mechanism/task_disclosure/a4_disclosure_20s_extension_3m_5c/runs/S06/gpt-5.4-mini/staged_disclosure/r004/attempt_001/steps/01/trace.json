        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: synthesize_text.py\n+import os\n+from typing import Optional\n+\n+from elevenlabs.client import ElevenLabs\n+\n+\n+def synthesize_text(text: str, voice: Optional[str] = None, model: str = \"eleven_turbo_v2_5\") -> bytes:\n+    api_key = os.environ.get(\"ELEVENLABS_API_KEY\")\n+    if not api_key:\n+        raise RuntimeError(\"ELEVENLABS_API_KEY is required\")\n+    client = ElevenLabs(api_key=api_key)\n+    voice_id = voice or os.environ.get(\"ELEVENLABS_VOICE_ID\", \"21m00Tcm4TlvDq8ikWAM\")\n+    audio = client.text_to_speech.convert(text=text, voice_id=voice_id, model_id=model)\n+    if isinstance(audio, (bytes, bytearray)):\n+        return bytes(audio)\n+    return b\"\".join(chunk for chunk in audio)\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-kmwkzkgz/synthesize_text.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-kmwkzkgz/synthesize_text.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-kmwkzkgz/synthesize_text.py\n@@ -0,0 +1,16 @@\n+import os\n+from typing import Optional\n+\n+from elevenlabs.client import ElevenLabs\n+\n+\n+def synthesize_text(text: str, voice: Optional[str] = None, model: str = \"eleven_turbo_v2_5\") -> bytes:\n+    api_key = os.environ.get(\"ELEVENLABS_API_KEY\")\n+    if not api_key:\n+        raise RuntimeError(\"ELEVENLABS_API_KEY is required\")\n+    client = ElevenLabs(api_key=api_key)\n+    voice_id = voice or os.environ.get(\"ELEVENLABS_VOICE_ID\", \"21m00Tcm4TlvDq8ikWAM\")\n+    audio = client.text_to_speech.convert(text=text, voice_id=voice_id, model_id=model)\n+    if isinstance(audio, (bytes, bytearray)):\n+        return bytes(audio)\n+    return b\"\".join(chunk for chunk in audio)\n\n",
            "files": [
              {
                "additions": 16,

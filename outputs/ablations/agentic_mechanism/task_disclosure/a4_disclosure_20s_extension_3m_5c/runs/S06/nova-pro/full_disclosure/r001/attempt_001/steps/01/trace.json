    {
      "data": {
        "callID": "tooluse_1h8cYlDF64Zc65AvNyLCAR",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_text(text):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        Text=text,\n        OutputFormat='mp3',\n        VoiceId='Joanna'\n    )\n    if 'AudioStream' in response:\n        with open('output.mp3', 'wb') as file:\n            file.write(response['AudioStream'].read())\n    else:\n        raise Exception('AudioStream not found in response')\n\n# Example usage:\n# synthesize_text('Hello, world!')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-lk9_a16t/synthesize_text.py"

    },
    {
      "data": {
        "callID": "tooluse_fO1rj47P7ZRHECyWpzfhWN",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_ssml(ssml, voice_id, output_file):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        VoiceId=voice_id,\n        OutputFormat='mp3',\n        TextType='ssml',\n        Text=ssml\n    )\n    with open(output_file, 'wb') as file:\n        file.write(response['AudioStream'].read())\n\n    print(f'SSML synthesized and saved to {output_file}')\n\n# Example usage:\n# synthesize_ssml('<speak>Hello, world!</speak>', 'Joanna', 'output.mp3')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ck60azlz/synthesize_ssml.py"
          },

    {
      "data": {
        "callID": "tooluse_A6fZa6uD4Xsw8hoJaTODfW",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_text(text, voice_id='Joanna'):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        Text=text,\n        OutputFormat='mp3',\n        VoiceId=voice_id\n    )\n    return response['AudioStream'].read()\n\nif __name__ == '__main__':\n    text = 'Hello, this is a test of the Amazon Polly service.'\n    audio_stream = synthesize_text(text)\n    with open('output.mp3', 'wb') as f:\n        f.write(audio_stream)\n    print('Audio file saved as output.mp3')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-edgcidwm/synthesize_text.py"
          },

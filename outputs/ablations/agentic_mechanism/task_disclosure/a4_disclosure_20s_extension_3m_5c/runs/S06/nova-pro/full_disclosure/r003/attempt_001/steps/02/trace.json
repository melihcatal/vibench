    {
      "data": {
        "callID": "tooluse_Av8VqhB6sivlHIk6oOS8OK",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_ssml(ssml_text, voice_id, output_format='mp3'):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        VoiceId=voice_id,\n        OutputFormat=output_format,\n        TextType='ssml',\n        Text=ssml_text\n    )\n    if 'AudioStream' in response:\n        with open('output.mp3', 'wb') as file:\n            file.write(response['AudioStream'].read())\n        return 'output.mp3'\n    else:\n        return 'Synthesis failed'\n\n# Example usage:\n# synthesize_ssml('<speak>Hello, world!</speak>', 'Joanna')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-edgcidwm/synthesize_ssml.py"
          },

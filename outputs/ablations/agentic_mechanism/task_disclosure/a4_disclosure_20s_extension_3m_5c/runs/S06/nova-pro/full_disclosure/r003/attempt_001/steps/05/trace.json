    },
    {
      "data": {
        "callID": "tooluse_cVCVCp3P8WKHRu4kQ6V8Ml",
        "state": {
          "input": {
            "content": "import boto3\n\ndef save_audio(text, output_file):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(Text=text, OutputFormat='mp3', VoiceId='Joanna')\n    with open(output_file, 'wb') as file:\n        file.write(response['AudioStream'].read())",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-edgcidwm/save_audio.py"
          },

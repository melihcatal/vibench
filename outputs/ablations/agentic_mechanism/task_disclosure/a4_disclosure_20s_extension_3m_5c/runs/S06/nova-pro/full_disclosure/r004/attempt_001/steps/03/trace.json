        "callID": "tooluse_PTznAFnxo5AFTZnpOtXtfH",
        "state": {
          "input": {
            "content": "import boto3\n\ndef list_voices():\n    polly_client = boto3.client('polly')\n    voices = polly_client.describe_voices()\n    return voices['Voices']\n\ndef select_voice(locale):\n    polly_client = boto3.client('polly')\n    voices = list_voices()\n    for voice in voices:\n        if voice['LanguageCode'] == locale:\n            return voice['Id']\n    return None",

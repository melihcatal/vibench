          "input": {
            "content": "import boto3\n\ndef synthesize_text(text, voice_id='Joanna'):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        Text=text,\n        OutputFormat='mp3',\n        VoiceId=voice_id\n    )\n    return response['AudioStream'].read()\n",

      "data": {
        "callID": "tooluse_UZQTA5OyPFd3M9KeNPRI1Y",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_ssml(ssml_text, voice_id, output_format='mp3'):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        VoiceId=voice_id,\n        OutputFormat=output_format,\n        TextType='ssml',\n        Text=ssml_text\n    )\n    if 'AudioStream' in response:\n        with open('synthesized_speech.mp3', 'wb') as file:\n            file.write(response['AudioStream'].read())\n        return 'synthesized_speech.mp3'\n    else:\n        return 'Error synthesizing speech'",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-upxex5_2/synthesize_ssml.py"

      "data": {
        "callID": "tooluse_T9JVEm1CwQiksqCC1wQUu7",
        "state": {
          "input": {
            "content": "import boto3\n\ndef list_voices(locale):\n    polly_client = boto3.client('polly')\n    voices = polly_client.describe_voices(LanguageCode=locale)\n    return voices['Voices']\n\ndef select_voice(voice_id):\n    polly_client = boto3.client('polly')\n    voice = next((v for v in list_voices('en-US') if v['Id'] == voice_id), None)\n    return voice",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-upxex5_2/select_voice.py"

        "callID": "tooluse_k2H9iA0Z2yTHJRKUqLL0Ff",
        "state": {
          "input": {
            "content": "import boto3\n\ndef list_voices():\n    polly_client = boto3.client('polly')\n    voices = polly_client.describe_voices()\n    return voices['Voices']\n\ndef select_voice(language_code):\n    voices = list_voices()\n    for voice in voices:\n        if voice['LanguageCode'] == language_code:\n            return voice['Id']\n    return None",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-4nb_wtgl/select_voice.py"

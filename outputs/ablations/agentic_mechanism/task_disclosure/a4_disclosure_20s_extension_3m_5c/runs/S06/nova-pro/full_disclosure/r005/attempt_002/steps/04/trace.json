      "data": {
        "callID": "tooluse_2RWIkr9k1jbesyODtG4GR7",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_ssml(ssml_text, voice_id, output_format='mp3'):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        VoiceId=voice_id,\n        OutputFormat=output_format,\n        Text=ssml_text,\n        TextType='ssml'\n    )\n    if 'AudioStream' in response:\n        with open('output.mp3', 'wb') as file:\n            file.write(response['AudioStream'].read())\n        return 'output.mp3'\n    else:\n        raise Exception('Synthesis failed')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-4nb_wtgl/synthesize_ssml.py"

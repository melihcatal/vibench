    {
      "data": {
        "callID": "tooluse_GqhyHiG9NSDqecaGeSxKtP",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_ssml(ssml_text):\n    polly = boto3.client('polly')\n    response = polly.synthesize_speech(\n        Text=ssml_text,\n        OutputFormat='mp3',\n        VoiceId='Joanna',\n        TextType='ssml'\n    )\n    with open('speech.mp3', 'wb') as file:\n        file.write(response['AudioStream'].read())\n\n    print('Speech synthesized to speech.mp3')\n\nif __name__ == '__main__':\n    ssml_text = '<speak>Hello, world!</speak>'\n    synthesize_ssml(ssml_text)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-0wn_cgrs/synthesize_ssml.py"

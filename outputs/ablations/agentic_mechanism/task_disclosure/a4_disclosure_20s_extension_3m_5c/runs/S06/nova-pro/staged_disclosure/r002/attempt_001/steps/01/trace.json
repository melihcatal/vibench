      "data": {
        "callID": "tooluse_cGKt2HgDMyxjatDXQ6LxqA",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_text(text):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        Text=text,\n        OutputFormat='mp3',\n        VoiceId='Joanna'\n    )\n    return response['AudioStream'].read()\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-4hh30xie/synthesize_text.py"

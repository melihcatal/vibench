    {
      "data": {
        "callID": "tooluse_U731TErqGkf7diqRvkaMGm",
        "state": {
          "input": {
            "content": "import boto3\n\ndef list_voices(locale):\n    polly_client = boto3.client('polly')\n    voices = polly_client.describe_voices(LanguageCode=locale)\n    return voices['Voices']\n\ndef select_voice(voice_id):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        VoiceId=voice_id,\n        OutputFormat='mp3',\n        Text='Hello, this is a test.'\n    )\n    with open('output.mp3', 'wb') as f:\n        f.write(response['AudioStream'].read())\n    print('Speech synthesized to output.mp3 for voiceId', voice_id)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-5v7kdg_6/select_voice.py"
          },

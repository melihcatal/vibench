    {
      "data": {
        "callID": "tooluse_xGeL4qjUPg5nInZ5A8eq5d",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_ssml(ssml_text):\n    polly_client = boto3.client('polly', region_name='us-east-1')\n    response = polly_client.synthesize_speech(\n        Text=ssml_text,\n        OutputFormat='mp3',\n        VoiceId='Joanna',\n        TextType='ssml'\n    )\n    with open('output.mp3', 'wb') as file:\n        file.write(response['AudioStream'].read())\n        print('SSML synthesized and saved as output.mp3')\n\nif __name__ == '__main__':\n    ssml_text = '<speak>Hello, this is a test of Amazon Polly.</speak>'\n    synthesize_ssml(ssml_text)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-hca8sv1p/synthesize_ssml.py"

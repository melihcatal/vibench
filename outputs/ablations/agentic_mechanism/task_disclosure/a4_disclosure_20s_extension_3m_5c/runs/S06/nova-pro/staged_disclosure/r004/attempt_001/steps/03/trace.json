    {
      "data": {
        "callID": "tooluse_efBLje1MpgSwe03Imypt01",
        "state": {
          "input": {
            "content": "import boto3\n\ndef list_voices(locale):\n    polly_client = boto3.client('polly')\n    voices = polly_client.describe_voices(LanguageCode=locale)\n    return voices['Voices']\n\ndef select_voice(voice_id):\n    polly_client = boto3.client('polly')\n    voice = polly_client.describe_voices(VoiceId=voice_id)\n    return voice['Voices'][0]",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-hca8sv1p/select_voice.py"
          },

    {
      "data": {
        "callID": "tooluse_M6jHUsrBAdJAJ0VKYHkR0G",
        "state": {
          "input": {
            "content": "import boto3\n\ndef synthesize_ssml(ssml_text):\n    polly_client = boto3.client('polly')\n    response = polly_client.synthesize_speech(\n        VoiceId='Joanna',\n        OutputFormat='mp3',\n        Text=ssml_text,\n        TextType='ssml'\n    )\n    with open('speech.mp3', 'wb') as file:\n        file.write(response['AudioStream'].read())\n    print('Speech synthesized to speech.mp3')\n\nif __name__ == '__main__':\n    ssml_text = '<speak>Hello, world!</speak>'\n    synthesize_ssml(ssml_text)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-3k586gce/synthesize_ssml.py"

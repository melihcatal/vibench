      "data": {
        "text": "\"Create extract_layout.py in the current working directory.\nTask: extracts blocks, lines, tables, or layout elements from a document.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bda15fca001OtN6uzY85PJ7O5",
      "message_id": "msg_0bda15fc70013HB6rYSXf4pgHK",

      "data": {
        "text": "\"Create extract_layout.py in the current working directory.\nTask: extracts blocks, lines, tables, or layout elements from a document.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc44d5da001TwmdBJHyqUvoQC",
      "message_id": "msg_0bc44d5d8001k1QnjPk6A0cNLV",
      "session_id": "ses_f43bb2a2fffeO3r4a90YpliyoS",
      "time_created": 1789865022939,
      "time_updated": 1789865022939
    },
    {
      "data": {
        "type": "step-start"
      },
      "id": "prt_0bc44d9ec001J0Ym4lTd7nzbyj",

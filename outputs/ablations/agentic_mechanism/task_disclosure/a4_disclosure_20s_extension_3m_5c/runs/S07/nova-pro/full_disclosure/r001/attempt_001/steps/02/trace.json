    {
      "data": {
        "callID": "tooluse_V1pcRXsHKTd1SlSvTGRykL",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_layout(document_path):\n    textract_client = boto3.client('textract')\n    with open(document_path, 'rb') as document:\n        image_bytes = document.read()\n    response = textract_client.detect_document_text(\n        Document={'Bytes': image_bytes}\n    )\n    layout_elements = []\n    for item in response['Blocks']:\n        if item['BlockType'] in ['LINE', 'WORD', 'TABLE', 'CELL']:\n            layout_elements.append(item)\n    return layout_elements",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-322ouyl_/extract_layout.py"
          },

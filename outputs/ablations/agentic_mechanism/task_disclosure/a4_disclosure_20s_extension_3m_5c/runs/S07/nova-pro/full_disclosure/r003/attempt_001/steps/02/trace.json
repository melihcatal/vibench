    {
      "data": {
        "callID": "tooluse_gQUwL0klzDa5MLfBK1EoHQ",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_text(image_path):\n    client = boto3.client('textract')\n    with open(image_path, 'rb') as image:\n        response = client.detect_document_text(Document={'Bytes': image.read()})\n    text = ''.join([item['Text'] for item in response['Blocks'] if item['BlockType'] == 'LINE'])\n    return text",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8x0izw42/extract_text.py"
          },

    {
      "data": {
        "callID": "tooluse_mrvQIBSHe6GqdoWRAQ9vRD",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_tables(document_bytes):\n    textract = boto3.client('textract')\n    response = textract.analyze_document(\n        Document={'Bytes': document_bytes},\n        FeatureTypes=['TABLES']\n    )\n    tables = []\n    for table in response.get('Tables', []):\n        table_data = {\n            'Rows': [],\n            'Columns': []\n        }\n        for row in table.get('Rows', []):\n            row_data = []\n            for cell in row.get('Cells', []):\n                row_data.append(cell.get('Text', ''))\n            table_data['Rows'].append(row_data)\n        for column in table.get('Columns', []):\n            column_data = []\n            for cell in column.get('Cells', []):\n                column_data.append(cell.get('Text', ''))\n            table_data['Columns'].append(column_data)\n        tables.append(table_data)\n    return tables",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fdextipt/extract_tables.py"
          },

      "data": {
        "callID": "tooluse_ytPE084KGYajd5MjUVZtvL",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_key_values(document_bytes):\n    textract_client = boto3.client('textract')\n    response = textract_client.analyze_document(\n        Document={'Bytes': document_bytes},\n        FeatureTypes=['FORMS'])\n    key_value_pairs = {}\n    for block in response['Blocks']:\n        if block['BlockType'] == 'KEY_VALUE_SET':\n            key = next((child['Text'] for child in block['Relationships'][0]['Ids'] if child['BlockType'] == 'WORD'), None)\n            value = next((child['Text'] for child in block['Relationships'][1]['Ids'] if child['BlockType'] == 'WORD'), None)\n            if key and value:\n                key_value_pairs[key] = value\n    return key_value_pairs",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fdextipt/extract_key_values.py"

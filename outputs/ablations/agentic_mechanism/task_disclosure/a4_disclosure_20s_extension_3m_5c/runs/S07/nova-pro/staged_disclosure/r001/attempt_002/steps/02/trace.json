    },
    {
      "data": {
        "callID": "tooluse_BAz5bsZKbwgC7FgnNhXOw3",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_layout(document):\n    textract_client = boto3.client('textract')\n    response = textract_client.analyze_document(\n        Document={'Bytes': document},\n        FeatureTypes=['TABLES', 'FORMS']\n    )\n    return response\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-q2oijyg1/extract_layout.py"

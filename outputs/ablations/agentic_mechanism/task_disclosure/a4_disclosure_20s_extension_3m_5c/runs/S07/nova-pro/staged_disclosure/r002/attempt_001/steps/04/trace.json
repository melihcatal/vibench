    {
      "data": {
        "callID": "tooluse_fXARiUQSnonB4JjHEWVAlg",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_tables(document):\n    client = boto3.client('textract')\n    response = client.analyze_document(\n        Document={'Bytes': document},\n        FeatureTypes=['TABLES'])\n    tables = []\n    for table in response['Blocks']:\n        if table['BlockType'] == 'TABLE':\n            rows = []\n            for relationship in table['Relationships']:\n                if relationship['Type'] == 'CHILD':\n                    for child_id in relationship['Ids']:\n                        child_block = next(block for block in response['Blocks'] if block['Id'] == child_id)\n                        if child_block['BlockType'] == 'CELL':\n                            rows.append(child_block['Text'])\n            tables.append(rows)\n    return tables",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-nca3sol7/extract_tables.py"
          },
          "metadata": {

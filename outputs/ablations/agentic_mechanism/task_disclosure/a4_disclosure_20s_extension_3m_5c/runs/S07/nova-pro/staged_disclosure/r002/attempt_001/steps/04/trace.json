    {
      "data": {
        "callID": "tooluse_VpZ5GabqtQ664A2gBBz6ho",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_layout(document):\n    client = boto3.client('textract')\n    response = client.analyze_document(\n        Document={'Bytes': document},\n        FeatureTypes=['TABLES', 'FORMS']\n    )\n    blocks = response['Blocks']\n    lines = [block for block in blocks if block['BlockType'] == 'LINE']\n    tables = [block for block in blocks if block['BlockType'] == 'TABLE']\n    return blocks, lines, tables",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-nca3sol7/extract_layout.py"
          },

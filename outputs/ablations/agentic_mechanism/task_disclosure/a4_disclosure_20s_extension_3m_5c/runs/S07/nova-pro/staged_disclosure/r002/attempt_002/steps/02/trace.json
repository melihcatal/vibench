    {
      "data": {
        "callID": "tooluse_fBtoxsV2O7YcHVH2c6xEFv",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_text_from_image(image_path):\n    textract_client = boto3.client('textract')\n    \n    with open(image_path, 'rb') as image:\n        response = textract_client.detect_document_text(Document={'Bytes': image.read()})\n    \n    text = ''\n    for item in response['Blocks']:\n        if item['BlockType'] == 'LINE':\n            text += item['Text'] + ' '\n    return text\n\nif __name__ == '__main__':\n    image_path = 'path/to/your/image.jpg'\n    extracted_text = extract_text_from_image(image_path)\n    print(extracted_text)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-nawnjzkj/extract_text.py"

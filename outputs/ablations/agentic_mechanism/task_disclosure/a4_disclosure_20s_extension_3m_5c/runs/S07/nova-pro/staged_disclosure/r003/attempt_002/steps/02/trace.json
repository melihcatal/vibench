      "time_updated": 1789886923469
    },
    {
      "data": {
        "callID": "tooluse_wr1zdUGH59MdkNx1CxN9OJ",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_layout(document_location):\n    textract_client = boto3.client('textract')\n    \n    with open(document_location, 'rb') as document:\n        image_bytes = document.read()\n    \n    response = textract_client.detect_document_text(Document={'Bytes': image_bytes})\n    \n    for item in response['Blocks']:\n        if item['BlockType'] == 'LINE':\n            print(item['Text'])\n        elif item['BlockType'] == 'TABLE':\n            print('Table detected')\n    \n    return response\n\nif __name__ == '__main__'):\n    document_location = 'sample-document.png'\n    extract_layout(document_location)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-w61snp7k/extract_layout.py"
          },

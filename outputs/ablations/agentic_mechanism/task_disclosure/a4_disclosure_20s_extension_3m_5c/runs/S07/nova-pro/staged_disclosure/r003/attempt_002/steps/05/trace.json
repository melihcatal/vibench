      "time_updated": 1789886936616
    },
    {
      "data": {
        "text": "<thinking> To extract key-value pairs from a form-like document, I will use Amazon Textract, a service that automatically extracts text and data from scanned documents. I will write the Python code to call the Amazon Textract API and process the document. </thinking>\n",
        "time": {
          "end": 1789886939120,
          "start": 1789886936617
        },
        "type": "text"
      },
      "id": "prt_0bd9336290013UUFr3B9eHYa9m",
      "message_id": "msg_0bd9328b2001kNwprBM4f5kSil",
      "session_id": "ses_f426cd761ffek6oKArgjbLMje2",
      "time_created": 1789886936617,
      "time_updated": 1789886939121
    },
    {
      "data": {
        "callID": "tooluse_auLC3T9SY3kcuCt765ytxc",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_key_values(document):\n    textract = boto3.client('textract')\n    response = textract.analyze_document(\n        Document={'Bytes': document},\n        FeatureTypes=['FORMS'])\n    key_values = {}\n    for block in response['Blocks']:\n        if block['BlockType'] == 'KEY_VALUE_SET':\n            key = None\n            value = None\n            for child in block['Relationships'][0]['Ids']:\n                child_block = next(b for b in response['Blocks'] if b['Id'] == child)\n                if child_block['BlockType'] == 'WORD':\n                    if key is None:\n                        key = child_block['Text']\n                    else:\n                        value = child_block['Text']\n            if key and value:\n                key_values[key] = value\n    return key_values",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-w61snp7k/extract_key_values.py"
          },
          "metadata": {

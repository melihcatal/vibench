    {
      "data": {
        "callID": "tooluse_sCTyLybU4JWpL0fbhVEAUb",
        "state": {
          "input": {
            "content": "import boto3\nimport os\n\n# Configuration for AWS Textract\naws_access_key_id = os.getenv('AWS_ACCESS_KEY_ID')\naws_secret_access_key = os.getenv('AWS_SECRET_ACCESS_KEY')\naws_region = os.getenv('AWS_REGION', 'us-west-2')\n\n# Initialize the Textract client\ntextract_client = boto3.client('textract',\n    region_name=aws_region,\n    aws_access_key_id=aws_access_key_id,\n    aws_secret_access_key=aws_secret_access_key)\n\ndef extract_text_from_document(document_path):\n    \"\"\"Helper function to extract text from a document using Amazon Textract\"\"\"\n    with open(document_path, 'rb') as document:\n        image_bytes = document.read()\n\n    response = textract_client.detect_document_text(Document={'Bytes': image_bytes})\n\n    text = ''\n    for item in response['Blocks']:\n        if item['BlockType'] == 'LINE':\n            text += item['Text'] + ' '\n\n    return text",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-w61snp7k/document_client.py"

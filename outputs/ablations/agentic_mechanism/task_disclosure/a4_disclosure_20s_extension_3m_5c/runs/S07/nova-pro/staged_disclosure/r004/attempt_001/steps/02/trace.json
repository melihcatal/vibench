    },
    {
      "data": {
        "callID": "tooluse_puqNbuJ8UKKozF1morQfka",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_layout(document_path):\n    textract_client = boto3.client('textract')\n    \n    with open(document_path, 'rb') as document:\n        image_bytes = document.read()\n    \n    response = textract_client.detect_document_text(Document={'Bytes': image_bytes})\n    \n    return response\n\nif __name__ == '__main__':\n    document_path = 'path/to/your/document'\n    extracted_layout = extract_layout(document_path)\n    print(extracted_layout)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-rqrev8ay/extract_layout.py"

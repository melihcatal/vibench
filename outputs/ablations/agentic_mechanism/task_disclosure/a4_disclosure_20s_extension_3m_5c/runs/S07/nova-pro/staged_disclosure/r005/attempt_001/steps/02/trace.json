      "time_updated": 1789865825264
    },
    {
      "data": {
        "callID": "tooluse_y9dz0zyb4FctkojeUwAeNg",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_layout(document_path):\n    textract_client = boto3.client('textract')\n    \n    with open(document_path, 'rb') as document:\n        imageBytes = document.read()\n    \n    response = textract_client.detect_document_text(Document={'Bytes': imageBytes})\n    \n    return response\n\nif __name__ == '__main__':\n    document_path = 'path/to/your/document'\n    result = extract_layout(document_path)\n    print(result)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-litlu0zd/extract_layout.py"
          },

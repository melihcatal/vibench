        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: extract_invoice_fields.py\n+import json\n+import os\n+from typing import Any, Dict, Optional\n+\n+from openai import OpenAI\n+\n+\n+MODEL_ID = os.getenv(\"OPENAI_INVOICE_EXTRACTION_MODEL\", \"gpt-4.1-mini\")\n+\n+\n+def extract_invoice_fields(invoice_text: str, api_key: Optional[str] = None) -> Dict[str, Any]:\n+    client = OpenAI(api_key=api_key or os.getenv(\"OPENAI_API_KEY\"))\n+    response = client.responses.create(\n+        model=MODEL_ID,\n+        input=[\n+            {\n+                \"role\": \"system\",\n+                \"content\": \"Extract vendor, date, total, and line-item fields from invoice text. Return only valid JSON.\",\n+            },\n+            {\n+                \"role\": \"user\",\n+                \"content\": invoice_text,\n+            },\n+        ],\n+        text={\"format\": {\"type\": \"json_object\"}},\n+    )\n+    output_text = getattr(response, \"output_text\", None)\n+    if output_text:\n+        return json.loads(output_text)\n+    return json.loads(response.output[0].content[0].text)\n+\n+\n+def extract_invoice_fields_from_file(path: str, api_key: Optional[str] = None) -> Dict[str, Any]:\n+    with open(path, \"r\", encoding=\"utf-8\") as f:\n+        return extract_invoice_fields(f.read(), api_key=api_key)\n+\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9l129slr/extract_invoice_fields.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9l129slr/extract_invoice_fields.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9l129slr/extract_invoice_fields.py\n@@ -0,0 +1,35 @@\n+import json\n+import os\n+from typing import Any, Dict, Optional\n+\n+from openai import OpenAI\n+\n+\n+MODEL_ID = os.getenv(\"OPENAI_INVOICE_EXTRACTION_MODEL\", \"gpt-4.1-mini\")\n+\n+\n+def extract_invoice_fields(invoice_text: str, api_key: Optional[str] = None) -> Dict[str, Any]:\n+    client = OpenAI(api_key=api_key or os.getenv(\"OPENAI_API_KEY\"))\n+    response = client.responses.create(\n+        model=MODEL_ID,\n+        input=[\n+            {\n+                \"role\": \"system\",\n+                \"content\": \"Extract vendor, date, total, and line-item fields from invoice text. Return only valid JSON.\",\n+            },\n+            {\n+                \"role\": \"user\",\n+                \"content\": invoice_text,\n+            },\n+        ],\n+        text={\"format\": {\"type\": \"json_object\"}},\n+    )\n+    output_text = getattr(response, \"output_text\", None)\n+    if output_text:\n+        return json.loads(output_text)\n+    return json.loads(response.output[0].content[0].text)\n+\n+\n+def extract_invoice_fields_from_file(path: str, api_key: Optional[str] = None) -> Dict[str, Any]:\n+    with open(path, \"r\", encoding=\"utf-8\") as f:\n+        return extract_invoice_fields(f.read(), api_key=api_key)\n\n",
            "files": [
              {
                "additions": 35,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9l129slr/extract_invoice_fields.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9l129slr/extract_invoice_fields.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9l129slr/extract_invoice_fields.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-9l129slr/extract_invoice_fields.py\n@@ -0,0 +1,35 @@\n+import json\n+import os\n+from typing import Any, Dict, Optional\n+\n+from openai import OpenAI\n+\n+\n+MODEL_ID = os.getenv(\"OPENAI_INVOICE_EXTRACTION_MODEL\", \"gpt-4.1-mini\")\n+\n+\n+def extract_invoice_fields(invoice_text: str, api_key: Optional[str] = None) -> Dict[str, Any]:\n+    client = OpenAI(api_key=api_key or os.getenv(\"OPENAI_API_KEY\"))\n+    response = client.responses.create(\n+        model=MODEL_ID,\n+        input=[\n+            {\n+                \"role\": \"system\",\n+                \"content\": \"Extract vendor, date, total, and line-item fields from invoice text. Return only valid JSON.\",\n+            },\n+            {\n+                \"role\": \"user\",\n+                \"content\": invoice_text,\n+            },\n+        ],\n+        text={\"format\": {\"type\": \"json_object\"}},\n+    )\n+    output_text = getattr(response, \"output_text\", None)\n+    if output_text:\n+        return json.loads(output_text)\n+    return json.loads(response.output[0].content[0].text)\n+\n+\n+def extract_invoice_fields_from_file(path: str, api_key: Optional[str] = None) -> Dict[str, Any]:\n+    with open(path, \"r\", encoding=\"utf-8\") as f:\n+        return extract_invoice_fields(f.read(), api_key=api_key)\n",

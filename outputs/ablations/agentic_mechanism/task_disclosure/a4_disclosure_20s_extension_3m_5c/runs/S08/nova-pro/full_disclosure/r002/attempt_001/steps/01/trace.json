    {
      "data": {
        "callID": "tooluse_LuUQ8CYj9Jc4FprYgzfBVF",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_invoice_fields(document):\n    textract_client = boto3.client('textract')\n    response = textract_client.analyze_document(\n        Document={'Bytes': document},\n        FeatureTypes=['FORMS']\n    )\n    extracted_data = {}\n    for block in response['Blocks']:\n        if block['BlockType'] == 'KEY_VALUE_SET':\n            if 'KEY' in block['Text']:\n                key = block['Text'].replace('KEY', '').strip()\n                value = block['Text'].replace('VALUE', '').strip()\n                extracted_data[key] = value\n    return extracted_data",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-iycil9zc/extract_invoice_fields.py"
          },

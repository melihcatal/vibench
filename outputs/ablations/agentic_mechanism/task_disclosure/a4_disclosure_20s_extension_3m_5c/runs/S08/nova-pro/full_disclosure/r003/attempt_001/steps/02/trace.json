    },
    {
      "data": {
        "callID": "tooluse_ZjaS3IM1rEV9l4P8DkcEzN",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_invoice_fields(document_path):\n    client = boto3.client('textract')\n    with open(document_path, 'rb') as document:\n        imageBytes = document.read()\n    response = client.analyze_document(\n        Document={'Bytes': imageBytes},\n        FeatureTypes=['FORMS'])\n    vendor = None\n    date = None\n    total = None\n    line_items = []\n    for block in response['Blocks']:\n        if block['BlockType'] == 'KEY_VALUE_SET':\n            if 'VENDOR' in block['Text']:\n                vendor = block['Text'].replace('VENDOR', '').strip()\n            elif 'DATE' in block['Text']:\n                date = block['Text'].replace('DATE', '').strip()\n            elif 'TOTAL' in block['Text']:\n                total = block['Text'].replace('TOTAL', '').strip()\n        elif block['BlockType'] == 'LINE':\n            line_items.append(block['Text'].strip())\n    return {\n        'vendor': vendor,\n        'date': date,\n        'total': total,\n        'line_items': line_items\n    }\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ot64_7f2/extract_invoice_fields.py"
          },

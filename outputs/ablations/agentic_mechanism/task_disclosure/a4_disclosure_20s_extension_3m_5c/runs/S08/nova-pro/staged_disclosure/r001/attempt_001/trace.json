    {
      "data": {
        "text": "\"Create extract_receipt_fields.py in the current working directory.\nTask: extracts merchant, tax, total, and items from a receipt.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bbfb31a7001w8XwlZOdzqzECL",

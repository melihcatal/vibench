    {
      "data": {
        "text": "\"Create extract_invoice_fields.py in the current working directory.\nTask: extracts vendor, date, total, and line-item fields from an invoice.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc3968b60017m9hxpLcKFPmBl",
      "message_id": "msg_0bc3968b20015T8zPPGlmWaBtj",

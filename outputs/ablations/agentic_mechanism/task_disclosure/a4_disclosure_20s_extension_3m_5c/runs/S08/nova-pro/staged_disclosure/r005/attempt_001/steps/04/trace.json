      "data": {
        "callID": "tooluse_0emOijWxAHUViTyuMaFon0",
        "state": {
          "input": {
            "content": "import boto3\nimport json\n\ndef normalize_expense(expense):\n    client = boto3.client('lambda')\n    response = client.invoke(\n        FunctionName='expense-normalizer',\n        InvocationType='RequestResponse',\n        Payload=json.dumps(expense)\n    )\n    payload = json.loads(response['Payload'].read())\n    return payload",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xk9i4rr3/normalize_expense.py"

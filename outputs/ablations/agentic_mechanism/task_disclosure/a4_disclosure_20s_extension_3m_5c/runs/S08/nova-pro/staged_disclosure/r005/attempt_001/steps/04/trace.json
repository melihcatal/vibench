      "data": {
        "text": "\"Create validate_document_fields.py in the current working directory.\nTask: validates required structured fields and confidence scores.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc39bf2d001wFBtUurtIOw2gV",

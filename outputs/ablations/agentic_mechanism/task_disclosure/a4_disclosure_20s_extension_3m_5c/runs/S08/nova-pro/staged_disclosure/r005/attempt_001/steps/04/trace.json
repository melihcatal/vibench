    {
      "data": {
        "text": "<thinking> To validate structured fields and confidence scores, I will use Amazon Textract, a service that automatically extracts text and data from scanned documents. This will make the provider identifiable in the code. </thinking>\n",
        "time": {
          "end": 1789864300169,
          "start": 1789864297275
        },
        "type": "text"
      },
      "id": "prt_0bc39c33b0016RklAov8Lf7z1K",
      "message_id": "msg_0bc39bf310010ZcqFIM7Rp2Jvf",

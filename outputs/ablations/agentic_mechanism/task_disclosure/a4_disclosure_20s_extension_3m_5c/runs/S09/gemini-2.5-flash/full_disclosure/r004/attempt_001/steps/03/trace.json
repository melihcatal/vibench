        "state": {
          "input": {
            "content": "import numpy as np\n\ndef cosine_similarity(embedding1, embedding2):\n    \"\"\"\n    Computes the cosine similarity between two embedding vectors.\n\n    Assumes embeddings are generated by a concrete external provider like\n    Google Cloud Vertex AI, or similar embedding services.\n\n    Args:\n        embedding1 (list or np.array): The first embedding vector.\n        embedding2 (list or np.array): The second embedding vector.\n\n    Returns:\n        float: The cosine similarity between the two embeddings.\n    \"\"\"\n    vec1 = np.array(embedding1)\n    vec2 = np.array(embedding2)\n\n    dot_product = np.dot(vec1, vec2)\n    norm_vec1 = np.linalg.norm(vec1)\n    norm_vec2 = np.linalg.norm(vec2)\n\n    if norm_vec1 == 0 or norm_vec2 == 0:\n        return 0.0  # Or handle as an error, depending on desired behavior\n\n    return dot_product / (norm_vec1 * norm_vec2)\n",
            "filePath": "similarity_score.py"
          },

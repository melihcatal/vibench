        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: similarity_score.py\n+import math\n+import os\n+from typing import Sequence\n+\n+import openai\n+\n+\n+def cosine_similarity(text_a: str, text_b: str, model: str = \"text-embedding-3-small\") -> float:\n+    client = openai.OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n+    embeddings = client.embeddings.create(model=model, input=[text_a, text_b])\n+    vec_a = embeddings.data[0].embedding\n+    vec_b = embeddings.data[1].embedding\n+    return _cosine(vec_a, vec_b)\n+\n+\n+def _cosine(a: Sequence[float], b: Sequence[float]) -> float:\n+    dot = sum(x * y for x, y in zip(a, b))\n+    norm_a = math.sqrt(sum(x * x for x in a))\n+    norm_b = math.sqrt(sum(y * y for y in b))\n+    if not norm_a or not norm_b:\n+        return 0.0\n+    return dot / (norm_a * norm_b)\n+\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-d2cuyp9d/similarity_score.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-d2cuyp9d/similarity_score.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-d2cuyp9d/similarity_score.py\n@@ -0,0 +1,22 @@\n+import math\n+import os\n+from typing import Sequence\n+\n+import openai\n+\n+\n+def cosine_similarity(text_a: str, text_b: str, model: str = \"text-embedding-3-small\") -> float:\n+    client = openai.OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n+    embeddings = client.embeddings.create(model=model, input=[text_a, text_b])\n+    vec_a = embeddings.data[0].embedding\n+    vec_b = embeddings.data[1].embedding\n+    return _cosine(vec_a, vec_b)\n+\n+\n+def _cosine(a: Sequence[float], b: Sequence[float]) -> float:\n+    dot = sum(x * y for x, y in zip(a, b))\n+    norm_a = math.sqrt(sum(x * x for x in a))\n+    norm_b = math.sqrt(sum(y * y for y in b))\n+    if not norm_a or not norm_b:\n+        return 0.0\n+    return dot / (norm_a * norm_b)\n\n",

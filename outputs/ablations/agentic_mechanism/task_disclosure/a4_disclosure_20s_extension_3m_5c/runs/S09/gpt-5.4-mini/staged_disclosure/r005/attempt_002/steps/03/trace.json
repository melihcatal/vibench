        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: similarity_score.py\n+import math\n+import os\n+from typing import List\n+\n+from openai import OpenAI\n+\n+\n+def _embed(text: str, client: OpenAI, model: str = \"text-embedding-3-small\") -> List[float]:\n+    response = client.embeddings.create(model=model, input=text)\n+    return response.data[0].embedding\n+\n+\n+def _cosine_similarity(a: List[float], b: List[float]) -> float:\n+    if len(a) != len(b):\n+        raise ValueError(\"Embeddings must have the same length\")\n+    dot = sum(x * y for x, y in zip(a, b))\n+    norm_a = math.sqrt(sum(x * x for x in a))\n+    norm_b = math.sqrt(sum(y * y for y in b))\n+    if norm_a == 0 or norm_b == 0:\n+        return 0.0\n+    return dot / (norm_a * norm_b)\n+\n+\n+def similarity_score(text1: str, text2: str) -> float:\n+    client = OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n+    emb1 = _embed(text1, client)\n+    emb2 = _embed(text2, client)\n+    return _cosine_similarity(emb1, emb2)\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-o1m0f16v/similarity_score.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-o1m0f16v/similarity_score.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-o1m0f16v/similarity_score.py\n@@ -0,0 +1,28 @@\n+import math\n+import os\n+from typing import List\n+\n+from openai import OpenAI\n+\n+\n+def _embed(text: str, client: OpenAI, model: str = \"text-embedding-3-small\") -> List[float]:\n+    response = client.embeddings.create(model=model, input=text)\n+    return response.data[0].embedding\n+\n+\n+def _cosine_similarity(a: List[float], b: List[float]) -> float:\n+    if len(a) != len(b):\n+        raise ValueError(\"Embeddings must have the same length\")\n+    dot = sum(x * y for x, y in zip(a, b))\n+    norm_a = math.sqrt(sum(x * x for x in a))\n+    norm_b = math.sqrt(sum(y * y for y in b))\n+    if norm_a == 0 or norm_b == 0:\n+        return 0.0\n+    return dot / (norm_a * norm_b)\n+\n+\n+def similarity_score(text1: str, text2: str) -> float:\n+    client = OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n+    emb1 = _embed(text1, client)\n+    emb2 = _embed(text2, client)\n+    return _cosine_similarity(emb1, emb2)\n\n",
            "files": [

      "data": {
        "callID": "tooluse_bj1S7dsIEuKHxnuO5OP3C8",
        "state": {
          "input": {
            "content": "import boto3\n\ndef embed_for_search(query, documents):\n    bedrock_client = boto3.client('bedrock-runtime')\n    embeddings = []\n    for text in [query] + documents:\n        response = bedrock_client.invoke_model(\n            model_id='amazon.titan-embed-text-v1',\n            body={\n                'inputText': text\n            }\n        )\n        embedding = response['embedding']\n        embeddings.append(embedding)\n    return embeddings",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ucf2ttqy/embed_for_search.py"
          },

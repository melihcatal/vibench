      "data": {
        "callID": "tooluse_HcIa6ZhocmyAObQGztFE3G",
        "state": {
          "input": {
            "content": "import boto3\n\ndef embed_query_and_documents(query, documents):\n    bedrock_client = boto3.client('bedrock', region_name='us-west-2')\n    embeddings = []\n    for text in [query] + documents:\n        response = bedrock_client.invoke_model(\n            model_id='amazon.titan-embed-text-v1',\n            body={\n                'inputText': text\n            }\n        )\n        embeddings.append(response['embedding'])\n    return embeddings",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-sn9udu0a/embed_for_search.py"
          },

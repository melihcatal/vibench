      "data": {
        "callID": "tooluse_mnNcQodTQndMl3X5qrDBE3",
        "state": {
          "input": {
            "content": "import boto3\n\nbedrock = boto3.client('bedrock-runtime')\n\ndef generate_embeddings(texts):\n    model_id = 'amazon.titan-embed-text-v1'\n    embeddings = []\n    for text in texts:\n        response = bedrock.invoke_model(\n            modelId=model_id,\n            body={\n                'inputText': text\n            }\n        )\n        embedding = response['embedding']\n        embeddings.append(embedding)\n    return embeddings",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-i0hrq_g6/embed_batch.py"

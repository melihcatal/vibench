    {
      "data": {
        "callID": "tooluse_QesEJQCfcg9KmZkq7ctm7l",
        "state": {
          "input": {
            "content": "import boto3\n\ndef embed_for_search(query, documents):\n    bedrock = boto3.client('bedrock-runtime')\n\n    query_embedding = bedrock.invoke_model(\n        model_id='amazon.titan-embed-text-v1',\n        body={\n            'inputText': query\n        }\n    )\n\n    document_embeddings = []\n    for doc in documents:\n        document_embedding = bedrock.invoke_model(\n            model_id='amazon.titan-embed-text-v1',\n            body={\n                'inputText': doc\n            }\n        )\n        document_embeddings.append(document_embedding)\n\n    return query_embedding, document_embeddings",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-eicpckf1/embed_for_search.py"

    {
      "data": {
        "callID": "tooluse_4DtNa4dwACleKw5EXAcSdA",
        "state": {
          "input": {
            "content": "import boto3\n\nbedrock = boto3.client(service_name='bedrock-runtime', region_name='us-east-1')\n\ndef generate_embedding(text):\n    model_id = 'amazon.titan-embed-text-v1'\n    body = {'inputText': text}\n    response = bedrock.invoke_model(modelId=model_id, body=body)\n    response_body = response['body'].read()\n    embedding = response_body['embedding']\n    return embedding\n\nif __name__ == '__main__':\n    text = 'This is a sample text to generate an embedding vector.'\n    embedding = generate_embedding(text)\n    print(embedding)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-e7re3ggh/embed_text.py"

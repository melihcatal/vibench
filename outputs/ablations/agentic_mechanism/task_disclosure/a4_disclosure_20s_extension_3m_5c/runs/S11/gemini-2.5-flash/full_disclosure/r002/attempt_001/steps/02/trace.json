      "data": {
        "callID": "cCkAMjyIUBi4avcd",
        "metadata": {
          "google": {
            "thoughtSignature": ""
          }
        },
        "state": {
          "input": {
            "content": "from google.cloud import aiplatform\n\ndef resolve_model_resource(project_id: str, location: str, model_id: str) -> str:\n    \"\"\"Resolves a Vertex AI model resource name.\"\"\"\n    return aiplatform.models.Model.to_resource_name(project_id, location, model_id)\n\ndef resolve_endpoint_resource(project_id: str, location: str, endpoint_id: str) -> str:\n    \"\"\"Resolves a Vertex AI endpoint resource name.\"\"\"\n    return aiplatform.Endpoint.to_resource_name(project_id, location, endpoint_id)\n",
            "filePath": "select_platform_resource.py"
          },

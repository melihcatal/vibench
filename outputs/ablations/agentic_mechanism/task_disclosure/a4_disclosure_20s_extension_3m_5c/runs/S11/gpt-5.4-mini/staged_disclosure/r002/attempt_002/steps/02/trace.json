        "callID": "call_D9mO2UKT1VBpcCT2EiJZyB60",
        "metadata": {
          "openai": {
            "itemId": "fc_048b3456a9c5a92e016aaf81f8570887d2b75d8a6da39f162e"
          }
        },
        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: select_platform_resource.py\n+import os\n+import requests\n+\n+\n+OPENAI_MODELS_ENDPOINT = \"https://api.openai.com/v1/models\"\n+\n+\n+def select_platform_resource(resource_name: str) -> str:\n+    api_key = os.getenv(\"OPENAI_API_KEY\")\n+    if not api_key:\n+        raise EnvironmentError(\"OPENAI_API_KEY is required\")\n+\n+    headers = {\"Authorization\": f\"Bearer {api_key}\"}\n+    response = requests.get(OPENAI_MODELS_ENDPOINT, headers=headers, timeout=30)\n+    response.raise_for_status()\n+    data = response.json()\n+    models = data.get(\"data\", [])\n+\n+    if not resource_name:\n+        raise ValueError(\"resource_name is required\")\n+\n+    normalized = resource_name.strip()\n+    if not normalized:\n+        raise ValueError(\"resource_name is required\")\n+\n+    available = {item.get(\"id\") for item in models if isinstance(item, dict)}\n+    if normalized in available:\n+        return normalized\n+\n+    aliases = {\n+        \"gpt-5.4-mini\": \"openai/gpt-5.4-mini\",\n+        \"gpt-4.1\": \"gpt-4.1\",\n+        \"gpt-4o\": \"gpt-4o\",\n+    }\n+    resolved = aliases.get(normalized, normalized)\n+    if resolved in available:\n+        return resolved\n+\n+    raise LookupError(f\"OpenAI resource not available: {resource_name}\")\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-042squ7w/select_platform_resource.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-042squ7w/select_platform_resource.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-042squ7w/select_platform_resource.py\n@@ -0,0 +1,39 @@\n+import os\n+import requests\n+\n+\n+OPENAI_MODELS_ENDPOINT = \"https://api.openai.com/v1/models\"\n+\n+\n+def select_platform_resource(resource_name: str) -> str:\n+    api_key = os.getenv(\"OPENAI_API_KEY\")\n+    if not api_key:\n+        raise EnvironmentError(\"OPENAI_API_KEY is required\")\n+\n+    headers = {\"Authorization\": f\"Bearer {api_key}\"}\n+    response = requests.get(OPENAI_MODELS_ENDPOINT, headers=headers, timeout=30)\n+    response.raise_for_status()\n+    data = response.json()\n+    models = data.get(\"data\", [])\n+\n+    if not resource_name:\n+        raise ValueError(\"resource_name is required\")\n+\n+    normalized = resource_name.strip()\n+    if not normalized:\n+        raise ValueError(\"resource_name is required\")\n+\n+    available = {item.get(\"id\") for item in models if isinstance(item, dict)}\n+    if normalized in available:\n+        return normalized\n+\n+    aliases = {\n+        \"gpt-5.4-mini\": \"openai/gpt-5.4-mini\",\n+        \"gpt-4.1\": \"gpt-4.1\",\n+        \"gpt-4o\": \"gpt-4o\",\n+    }\n+    resolved = aliases.get(normalized, normalized)\n+    if resolved in available:\n+        return resolved\n+\n+    raise LookupError(f\"OpenAI resource not available: {resource_name}\")\n\n",

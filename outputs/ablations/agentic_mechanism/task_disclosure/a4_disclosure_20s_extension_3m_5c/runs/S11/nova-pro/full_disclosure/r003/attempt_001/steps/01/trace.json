            "content": "import boto3\n\ndef invoke_model():\n    bedrock_client = boto3.client('bedrock')\n    response = bedrock_client.invoke_model(\n        ModelId='amazon.titan-text-express-v1',\n        Body={\n            'inputText': 'Hello, world!'\n        }\n    )\n    return response\n\nif __name__ == '__main__'):\n    result = invoke_model()\n    print(result)",

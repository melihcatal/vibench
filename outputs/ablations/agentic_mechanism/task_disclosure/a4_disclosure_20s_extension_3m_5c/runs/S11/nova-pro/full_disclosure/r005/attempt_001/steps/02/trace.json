      "data": {
        "callID": "tooluse_T48TPOU5wSbuFVAQCSu1Xm",
        "state": {
          "input": {
            "content": "import os\n\nimport boto3\n\ndef select_platform_resource(model_id):\n    bedrock_client = boto3.client('bedrock', region_name='us-west-2')\n    response = bedrock_client.get_foundation_model(modelIdentifier=model_id)\n    return response\n\nif __name__ == '__main__':\n    model_id = os.getenv('BEDROCK_MODEL_ID')\n    if model_id:\n        resource = select_platform_resource(model_id)\n        print(resource)\n    else:\n        print('BEDROCK_MODEL_ID environment variable not set.')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ny8ai1n5/select_platform_resource.py"

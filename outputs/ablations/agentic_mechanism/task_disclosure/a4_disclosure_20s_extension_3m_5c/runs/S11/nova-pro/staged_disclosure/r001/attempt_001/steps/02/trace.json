    {
      "data": {
        "callID": "tooluse_9quDlpmJfTIXDEwgDqvZdd",
        "state": {
          "input": {
            "content": "import boto3\n\n# Initialize the Bedrock client\nbedrock_client = boto3.client('bedrock-runtime', region_name='us-east-1')\n\n# Define the model ID\nmodel_id = 'amazon.titan-text-express-v1'\n\n# Function to invoke the model\ndef invoke_model(prompt):\n    body = {\n        'inputText': prompt,\n        'textGenerationConfig': {\n            'maxTokenCount': 512,\n            'temperature': 0.5,\n            'topP': 0.9\n        }\n    }\n    response = bedrock_client.invoke_model(\n        modelId=model_id,\n        body=json.dumps(body)\n    )\n    result = json.loads(response['body'].read())\n    return result['results'][0]['outputText']\n\n# Example usage\nprompt = 'Generate a short story about a robot learning to love.'\noutput = invoke_model(prompt)\nprint(output)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-5tf5t4e6/invoke_platform_model.py"
          },

        "callID": "tooluse_Yq3EKXLwqmFTMo5wWNIZyH",
        "state": {
          "input": {
            "content": "import boto3\n\n# Configuration for Amazon Bedrock\nbedrock_config = {\n    'region_name': 'us-west-2',\n    'aws_access_key_id': 'YOUR_ACCESS_KEY',\n    'aws_secret_access_key': 'YOUR_SECRET_KEY'\n}\n\n# Initialize the Amazon Bedrock client\nbedrock_client = boto3.client(\n    'bedrock',\n    region_name=bedrock_config['region_name'],\n    aws_access_key_id=bedrock_config['aws_access_key_id'],\n    aws_secret_access_key=bedrock_config['aws_secret_access_key']\n)\n\ndef invoke_model(model_id, payload):\n    \"\"\"Helper function to invoke a model on Amazon Bedrock\"\"\"\n    response = bedrock_client.invoke_model(\n        modelId=model_id,\n        body=payload\n    )\n    return response\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-qb9g657k/model_client.py"

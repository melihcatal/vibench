        "callID": "tooluse_nNauQHFcnoBqioTtY8D6XU",
        "state": {
          "input": {
            "content": "import boto3\n\n# Initialize the Bedrock client\nbedrock_client = boto3.client('bedrock-runtime')\n\n# Specify the model ID\nmodel_id = 'amazon.titan-text-express-v1'\n\n# Function to invoke the model\ndef invoke_model(prompt):\n    response = bedrock_client.invoke_model(\n        ModelId=model_id,\n        Body={\n            'inputText': prompt\n        }\n    )\n    result = json.loads(response['Body'].read().decode())\n    return result['outputText']\n\n# Example usage\nif __name__ == '__main__':\n    prompt = 'Hello, how are you?'\n    output = invoke_model(prompt)\n    print(output)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-41gzl9s6/invoke_platform_model.py"

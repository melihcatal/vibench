      "data": {
        "callID": "tooluse_jzydc7qSxTnnI2DAis1o8b",
        "state": {
          "input": {
            "content": "import boto3\nimport os\n\n# Configure the Rekognition client\nrek_client = boto3.client('rekognition',\n    region_name='us-west-2',\n    aws_access_key_id=os.getenv('AWS_ACCESS_KEY_ID'),\n    aws_secret_access_key=os.getenv('AWS_SECRET_ACCESS_KEY'))\n\ndef detect_text(image_path):\n    with open(image_path, 'rb') as image:\n        response = rek_client.detect_text(Image={'Bytes': image.read()})\n        text_detections = response['TextDetections']\n        return text_detections\n\nif __name__ == '__main__':\n    image_path = 'path/to/your/image.jpg'\n    detected_text = detect_text(image_path)\n    print(detected_text)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ocwhbv8p/detect_image_text.py"

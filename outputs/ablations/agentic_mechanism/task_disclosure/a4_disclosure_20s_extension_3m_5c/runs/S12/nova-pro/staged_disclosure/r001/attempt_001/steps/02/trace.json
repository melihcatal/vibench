    {
      "data": {
        "callID": "tooluse_G6CMWi23mpWlY0IE4McdPc",
        "state": {
          "input": {
            "content": "import boto3\nfrom botocore.exceptions import NoCredentialsError, PartialCredentialsError\n\ndef detect_image_labels(image_path):\n    try:\n        client = boto3.client('rekognition')\n        with open(image_path, 'rb') as image:\n            image_bytes = image.read()\n        response = client.detect_labels(Image={'Bytes': image_bytes})\n        return response['Labels']\n    except (NoCredentialsError, PartialCredentialsError) as e:\n        print(f\"AWS credentials error: {e}\")\n        return []\n    except Exception as e:\n        print(f\"An error occurred: {e}\")\n        return []",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zfd8r_ql/detect_image_labels.py"
          },

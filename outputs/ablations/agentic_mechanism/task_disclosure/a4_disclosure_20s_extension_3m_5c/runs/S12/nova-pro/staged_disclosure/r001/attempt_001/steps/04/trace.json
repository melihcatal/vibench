    },
    {
      "data": {
        "callID": "tooluse_uGzEbhghAU65qyzZT9z7m2",
        "state": {
          "input": {
            "content": "import boto3\n\ndef detect_text(image_path):\n    textract_client = boto3.client('textract')\n    with open(image_path, 'rb') as image:\n        response = textract_client.detect_document_text(Document={'Bytes': image.read()})\n    text = ''\n    for item in response['Blocks']:\n        if item['BlockType'] == 'LINE':\n            text += item['Text'] + ' '\n    return text\n\nif __name__ == '__main__':\n    image_path = 'sample_image.jpg'\n    detected_text = detect_text(image_path)\n    print(detected_text)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zfd8r_ql/detect_image_text.py"
          },

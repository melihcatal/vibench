      "data": {
        "callID": "tooluse_hBj4oJio71FuSzVGtVaPJq",
        "state": {
          "input": {
            "content": "import boto3\n\ndef detect_text(image_path):\n    textract_client = boto3.client('textract')\n    with open(image_path, 'rb') as image:\n        response = textract_client.detect_document_text(Document={'Bytes': image.read()})\n    return response['Blocks']\n\nif __name__ == '__main__':\n    image_path = 'path/to/your/image.jpg'\n    text_blocks = detect_text(image_path)\n    for block in text_blocks:\n        if block['BlockType'] == 'LINE':\n            print(block['Text'])",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fdz1btex/detect_image_text.py"

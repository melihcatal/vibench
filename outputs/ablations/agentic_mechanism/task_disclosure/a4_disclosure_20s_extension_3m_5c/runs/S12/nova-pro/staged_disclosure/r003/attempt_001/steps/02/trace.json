    {
      "data": {
        "callID": "tooluse_YoIbQ6kLwFG98MVjXtAHHo",
        "state": {
          "input": {
            "content": "import boto3\n\ndef describe_image(image_path):\n    rekognition_client = boto3.client('rekognition')\n    with open(image_path, 'rb') as image:\n        response = rekognition_client.detect_labels(Image={'Bytes': image.read()})\n    labels = [label['Name'] for label in response['Labels'] if label['Confidence'] > 90]\n    return ', '.join(labels)\n\nif __name__ == '__main__':\n    image_path = 'path_to_your_image.jpg'\n    description = describe_image(image_path)\n    print(f'Image description: {description}')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-j9_9ulwy/describe_image.py"
          },

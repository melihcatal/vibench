    {
      "data": {
        "callID": "tooluse_JF5lT1azvTQgKiRkuhsci6",
        "state": {
          "input": {
            "content": "import boto3\n\ndef detect_text(image_path):\n    textract_client = boto3.client('textract')\n    with open(image_path, 'rb') as image:\n        response = textract_client.detect_document_text(Document={'Bytes': image.read()})\n    text = ' '.join([item['Text'] for block in response['Blocks'] if block['BlockType'] == 'LINE' for item in block['Geometry']])\n    return text\n\nif __name__ == '__main__':\n    image_path = 'path_to_your_image.jpg'\n    detected_text = detect_text(image_path)\n    print(detected_text)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-j9_9ulwy/detect_image_text.py"

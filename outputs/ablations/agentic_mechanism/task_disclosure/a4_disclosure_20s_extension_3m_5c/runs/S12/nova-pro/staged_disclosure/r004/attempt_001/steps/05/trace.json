    {
      "data": {
        "callID": "tooluse_4ffpaQDq4gP3wki6rXED39",
        "state": {
          "input": {
            "content": "import boto3\n\ndef describe_image(image_path):\n    rekognition = boto3.client('rekognition')\n    with open(image_path, 'rb') as image:\n        response = rekognition.detect_labels(\n            Image={'Bytes': image.read()},\n            MaxLabels=10\n        )\n    description = ' '.join([label['Name'] for label in response['Labels']])\n    return description\n\nif __name__ == '__main__':\n    image_path = 'path_to_your_image.jpg'\n    print(describe_image(image_path))",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-t4_fy4wh/describe_image.py"

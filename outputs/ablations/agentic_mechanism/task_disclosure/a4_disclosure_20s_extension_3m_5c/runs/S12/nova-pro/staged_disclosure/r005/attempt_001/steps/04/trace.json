    {
      "data": {
        "text": "\"Create detect_image_text.py in the current working directory.\nTask: detects text appearing inside an image.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bdbcdaf4001ajN3tIjb8GQEfx",
      "message_id": "msg_0bdbcdaf1001wOGVV5sTovIWaj",
      "session_id": "ses_f42432519ffelERK5BfT3gjkAH",

      "data": {
        "callID": "kfkToGq59w5AB8dY",
        "metadata": {
          "google": {
            "thoughtSignature": ""
          }
        },
        "state": {
          "input": {
            "content": "import os\nfrom googleapiclient import discovery\n\ndef moderate_batch_messages(messages: list[str]) -> list[dict]:\n    API_KEY = os.getenv(\"PERSPECTIVE_API_KEY\")\n    if not API_KEY:\n        raise ValueError(\"PERSPECTIVE_API_KEY environment variable not set.\")\n\n    client = discovery.build(\n        \"commentanalyzer\",\n        \"v1alpha1\",\n        developerKey=API_KEY,\n        discoveryServiceUrl=\"https://commentanalyzer.googleapis.com/$discovery/rest?version=v1alpha1\",\n        static_fields=False,\n    )\n\n    decisions = []\n    for message in messages:\n        analyze_request = {\n            'comment': {'text': message},\n            'requestedAttributes': {\n                'TOXICITY': {},\n                'SEVERE_TOXICITY': {},\n                'IDENTITY_ATTACK': {},\n                'INSULT': {},\n                'PROFANITY': {},\n                'THREAT': {}\n            }\n        }\n\n        response = client.comments().analyze(body=analyze_request).execute()\n        decisions.append({\n            \"message\": message,\n            \"scores\": {\n                attr: response['attributeScores'][attr]['summaryScore']['value']\n                for attr in analyze_request['requestedAttributes']\n            }\n        })\n    return decisions\n",
            "filePath": "moderate_batch.py"
          },

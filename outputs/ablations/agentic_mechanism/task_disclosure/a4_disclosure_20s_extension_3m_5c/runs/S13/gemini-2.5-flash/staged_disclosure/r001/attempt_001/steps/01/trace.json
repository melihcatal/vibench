      "data": {
        "text": "\"Create moderate_text.py in the current working directory.\nTask: scores user text for unsafe or policy-violating content.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc5efb19001oiy900mdPs2JFt",

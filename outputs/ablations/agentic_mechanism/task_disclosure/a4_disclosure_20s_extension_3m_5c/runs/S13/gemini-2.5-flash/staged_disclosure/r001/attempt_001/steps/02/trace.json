    },
    {
      "data": {
        "callID": "e014XkFlOfS1lUw2",
        "metadata": {
          "google": {
            "thoughtSignature": ""
          }
        },
        "state": {
          "input": {
            "content": "import os\nimport googleapiclient.discovery\n\ndef moderate_text(text: str) -> dict:\n    API_KEY = os.environ.get(\"PERSPECTIVE_API_KEY\")\n    if not API_KEY:\n        raise ValueError(\"PERSPECTIVE_API_KEY environment variable not set.\")\n\n    client = googleapiclient.discovery.build(\n        \"commentanalyzer\",\n        \"v1alpha1\",\n        developerKey=API_KEY,\n        discoveryServiceUrl=\"https://commentanalyzer.googleapis.com/$discovery/rest?version=v1alpha1\",\n        static_fields=False,\n    )\n\n    analyze_request = {\n        'comment': {'text': text},\n        'requestedAttributes': {\n            'TOXICITY': {},\n            'SEVERE_TOXICITY': {},\n            'IDENTITY_ATTACK': {},\n            'INSULT': {},\n            'PROFANITY': {},\n            'THREAT': {},\n            'SEXUALLY_EXPLICIT': {},\n            'FLIRTATION': {}\n        }\n    }\n\n    response = client.comments().analyze(body=analyze_request).execute()\n    return response\n\nif __name__ == \"__main__\":\n    test_text = \"You are a horrible person!\"\n    scores = moderate_text(test_text)\n    print(f\"Moderation scores for '{test_text}':\")\n    for attribute, value in scores.get(\"attributeScores\", {}).items():\n        print(f\"  {attribute}: {value['summaryScore']['value']:.4f}\")\n",
            "filePath": "moderate_text.py"
          },

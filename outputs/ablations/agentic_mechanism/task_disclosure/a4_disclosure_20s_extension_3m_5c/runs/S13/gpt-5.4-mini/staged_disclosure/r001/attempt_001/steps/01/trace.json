                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_tanclkt/moderate_text.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_tanclkt/moderate_text.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_tanclkt/moderate_text.py\n@@ -0,0 +1,48 @@\n+import os\n+from typing import Any, Dict\n+\n+import requests\n+\n+\n+OPENAI_API_URL = \"https://api.openai.com/v1/responses\"\n+OPENAI_MODEL = \"omni-moderation-latest\"\n+\n+\n+def moderate_text(text: str) -> Dict[str, Any]:\n+    api_key = os.environ[\"OPENAI_API_KEY\"]\n+    payload = {\n+        \"model\": OPENAI_MODEL,\n+        \"input\": text,\n+    }\n+    response = requests.post(\n+        OPENAI_API_URL,\n+        headers={\n+            \"Authorization\": f\"Bearer {api_key}\",\n+            \"Content-Type\": \"application/json\",\n+        },\n+        json=payload,\n+        timeout=30,\n+    )\n+    response.raise_for_status()\n+    data = response.json()\n+    output = data.get(\"output\", [])\n+    if output:\n+        first = output[0]\n+        content = first.get(\"content\", []) if isinstance(first, dict) else []\n+        if content:\n+            item = content[0]\n+            if isinstance(item, dict):\n+                return item.get(\"results\", data)\n+    return data\n+\n+\n+def main() -> None:\n+    import sys\n+\n+    text = sys.stdin.read()\n+    result = moderate_text(text)\n+    print(result)\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n",

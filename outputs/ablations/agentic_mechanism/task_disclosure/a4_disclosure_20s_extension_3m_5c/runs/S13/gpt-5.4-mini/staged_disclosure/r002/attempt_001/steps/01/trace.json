                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-wc5w1j52/moderate_text.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-wc5w1j52/moderate_text.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-wc5w1j52/moderate_text.py\n@@ -0,0 +1,46 @@\n+import os\n+import json\n+from typing import Any, Dict\n+\n+import requests\n+\n+\n+OPENAI_MODERATION_URL = \"https://api.openai.com/v1/moderations\"\n+OPENAI_MODERATION_MODEL = \"omni-moderation-latest\"\n+\n+\n+def score_text(text: str) -> Dict[str, Any]:\n+    api_key = os.environ.get(\"OPENAI_API_KEY\")\n+    if not api_key:\n+        raise RuntimeError(\"OPENAI_API_KEY is required\")\n+\n+    response = requests.post(\n+        OPENAI_MODERATION_URL,\n+        headers={\n+            \"Authorization\": f\"Bearer {api_key}\",\n+            \"Content-Type\": \"application/json\",\n+        },\n+        json={\"model\": OPENAI_MODERATION_MODEL, \"input\": text},\n+        timeout=30,\n+    )\n+    response.raise_for_status()\n+    data = response.json()\n+    result = data[\"results\"][0]\n+    return {\n+        \"flagged\": bool(result.get(\"flagged\", False)),\n+        \"categories\": result.get(\"categories\", {}),\n+        \"category_scores\": result.get(\"category_scores\", {}),\n+        \"raw\": data,\n+    }\n+\n+\n+def main() -> None:\n+    import sys\n+\n+    text = sys.stdin.read()\n+    output = score_text(text)\n+    print(json.dumps(output, ensure_ascii=False))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n",

    {
      "data": {
        "callID": "tooluse_5mBc4lNWi1X12xa3FNTKLj",
        "state": {
          "input": {
            "content": "import boto3\n\ndef redact_unsafe_text(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_toxic_content(\n        Text=text,\n        LanguageCode='en'\n    )\n    toxic_spans = response['ToxicContent']\n    redacted_text = text\n    for span in toxic_spans:\n        start = span['BeginOffset']\n        end = span['EndOffset']\n        redacted_text = redacted_text[:start] + '[REDACTED]' + redacted_text[end:]\n    return redacted_text",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zxbsz6jv/redact_unsafe.py"
          },

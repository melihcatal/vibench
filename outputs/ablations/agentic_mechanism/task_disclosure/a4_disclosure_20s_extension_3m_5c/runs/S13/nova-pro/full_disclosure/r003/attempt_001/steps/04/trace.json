    {
      "data": {
        "callID": "tooluse_5TlXCuxejNtX8WIT0DThLg",
        "state": {
          "input": {
            "content": "import boto3\n\ndef redact_unsafe_text(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_toxic_content(\n        Text=text,\n        LanguageCode='en'\n    )\n    redacted_text = text\n    for toxic_content in response['ToxicContent']:\n        start_index = toxic_content['Span']['Start']\n        end_index = toxic_content['Span']['End']\n        redacted_text = redacted_text[:start_index] + '[REDACTED]' + redacted_text[end_index:]\n    return redacted_text",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ggm0xv58/redact_unsafe.py"

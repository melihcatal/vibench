        "state": {
          "input": {
            "content": "import boto3\n\ndef score_text(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_toxic_content(Text=text)\n    return response\n\nif __name__ == '__main__':\n    user_text = input('Enter text to score: ')\n    result = score_text(user_text)\n    print(result)",

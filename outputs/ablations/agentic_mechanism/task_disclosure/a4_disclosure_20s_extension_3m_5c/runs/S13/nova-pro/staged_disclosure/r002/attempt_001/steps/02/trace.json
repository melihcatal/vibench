    {
      "data": {
        "callID": "tooluse_MqYdybg1TEWzg5FvAIzNF6",
        "state": {
          "input": {
            "content": "import boto3\n\ndef moderate_text(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_toxic_content(\n        TextSegments=[\n            {\n                'Text': text\n            }\n        ],\n        Languages=['en']\n    )\n    return response\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-gc8tmwnh/moderate_text.py"

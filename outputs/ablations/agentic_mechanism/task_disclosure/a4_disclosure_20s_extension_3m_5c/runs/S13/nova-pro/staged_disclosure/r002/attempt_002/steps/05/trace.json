      "data": {
        "callID": "tooluse_z3pHnwWvn9LPqRJN9iKrsZ",
        "state": {
          "input": {
            "content": "import boto3\n\ndef redact_unsafe(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_toxic_content(\n        TextSegments=[\n            {\n                'Text': text\n            }\n        ],\n        LanguageCode='en'\n    )\n    redacted_text = text\n    for toxic_content in response['ResultList'][0]['ToxicityLabels']:\n        if toxic_content['Name'] in ['PROFANITY', 'VIOLENCE', 'HATE_SPEECH']:\n            redacted_text = redacted_text.replace(toxic_content['Text'], '[REDACTED]')\n    return redacted_text",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zgg2lqwb/redact_unsafe.py"

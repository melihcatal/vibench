        "callID": "tooluse_4IesnvpafkAJ6ssah3Q9C3",
        "state": {
          "input": {
            "content": "import boto3\n\ndef apply_safety_threshold(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_sentiment(Text=text, LanguageCode='en')\n    sentiment = response['Sentiment']\n    if sentiment == 'NEGATIVE':\n        return False\n    return True",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8a2q8uzc/safety_threshold.py"

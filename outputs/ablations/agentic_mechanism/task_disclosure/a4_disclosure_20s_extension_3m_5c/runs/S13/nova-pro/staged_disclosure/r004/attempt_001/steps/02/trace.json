      "data": {
        "callID": "tooluse_jG41fIzuW96yvffF1unxpL",
        "state": {
          "input": {
            "content": "import requests\n\ndef score_text(text):\n    url = 'https://commentanalyzer.googleapis.com/v1alpha1/comments:analyze?key=YOUR_API_KEY'\n    payload = {\n        'comment': {'text': text},\n        'languages': ['en'],\n        'requestedAttributes': {'TOXICITY': {} }\n    }\n    response = requests.post(url, json=payload)\n    return response.json()\n\nif __name__ == '__main__':\\n    text_to_score = 'Sample text to score for toxicity.'\n    result = score_text(text_to_score)\n    print(result)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-sw4hweni/moderate_text.py"

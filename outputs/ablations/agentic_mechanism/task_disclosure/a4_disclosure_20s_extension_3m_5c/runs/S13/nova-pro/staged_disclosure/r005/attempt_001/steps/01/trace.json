          "input": {
            "content": "import boto3\n\ndef moderate_text(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_sentiment(\n        Text=text,\n        LanguageCode='en'\n    )\n    return response\n\nif __name__ == '__main__':\n    user_text = 'Enter text to be moderated.'\n    result = moderate_text(user_text)\n    print(result)",

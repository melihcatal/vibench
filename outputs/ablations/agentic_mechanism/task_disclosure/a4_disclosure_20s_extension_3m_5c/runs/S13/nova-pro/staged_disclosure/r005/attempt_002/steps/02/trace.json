    {
      "data": {
        "callID": "tooluse_zliJ0uBV8ENJXzyc8FdIwn",
        "state": {
          "input": {
            "content": "import boto3\n\ndef moderate_text(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_toxic_content(\n        TextSegments=[\n            {\n                'Text': text\n            }\n        ],\n        LanguageCode='en'\n    )\n    return response\n\nif __name__ == '__main__'):\n    user_text = input('Enter text to moderate: ')\n    result = moderate_text(user_text)\n    print(result)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-5yc6nr53/moderate_text.py"
          },

      "data": {
        "callID": "tooluse_sB0ylb4YzfZAsC2BiA61Jz",
        "state": {
          "input": {
            "content": "import boto3\n\ncomprehend = boto3.client('comprehend')\n\ndef redact_unsafe(text):\n    response = comprehend.detect_pii_entities(Text=text, LanguageCode='en')\n    redacted_text = text\n    for entity in response['Entities']:\n        if entity['Type'] in ['BANK_ACCOUNT_NUMBER', 'CREDIT_DEBIT_NUMBER', 'PASSPORT_NUMBER']:\n            redacted_text = redacted_text.replace(entity['Text'], '[REDACTED]')\n    return redacted_text",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-5yc6nr53/redact_unsafe.py"

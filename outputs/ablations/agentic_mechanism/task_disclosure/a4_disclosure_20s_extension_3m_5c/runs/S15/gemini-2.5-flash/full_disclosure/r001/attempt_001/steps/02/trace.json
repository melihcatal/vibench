            "content": "import boto3\n\ndef upsert_document(table_name: str, document: dict):\n    dynamodb = boto3.resource('dynamodb')\n    table = dynamodb.Table(table_name)\n    response = table.put_item(\n        Item=document\n    )\n    return response\n",

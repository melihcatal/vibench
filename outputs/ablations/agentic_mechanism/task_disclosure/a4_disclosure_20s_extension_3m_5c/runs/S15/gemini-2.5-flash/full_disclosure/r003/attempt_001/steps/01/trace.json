        "state": {
          "input": {
            "content": "\nimport boto3\nimport os\nimport json\n\ndef upsert_document(table_name: str, document: dict, primary_key_name: str):\n    \"\"\"\n    Upserts a JSON document by its primary identifier into an AWS DynamoDB table.\n\n    Args:\n        table_name (str): The name of the DynamoDB table.\n        document (dict): The JSON document to upsert.\n        primary_key_name (str): The name of the primary key attribute in the document.\n    \"\"\"\n    dynamodb = boto3.resource('dynamodb')  # AWS DynamoDB resource\n    table = dynamodb.Table(table_name)\n\n    # Ensure the document has the primary key\n    if primary_key_name not in document:\n        raise ValueError(f\"Document must contain the primary key '{primary_key_name}'\")\n\n    response = table.put_item(\n        Item=document\n    )\n    return response\n",
            "filePath": "upsert_document.py"

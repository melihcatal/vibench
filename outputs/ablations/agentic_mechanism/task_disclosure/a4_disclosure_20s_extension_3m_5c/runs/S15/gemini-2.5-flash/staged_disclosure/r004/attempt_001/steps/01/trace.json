      "data": {
        "text": "\"Create upsert_document.py in the current working directory.\nTask: upserts a JSON document by its primary identifier.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc6c7733001H1Fl8hQf2nLWq3",

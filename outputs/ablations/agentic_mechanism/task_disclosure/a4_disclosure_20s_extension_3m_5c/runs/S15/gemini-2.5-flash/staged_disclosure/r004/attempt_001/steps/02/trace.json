      "data": {
        "text": "\"Create fetch_document.py in the current working directory.\nTask: fetches a document by identifier from a managed NoSQL store.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc6c87d3001GjsU3z36spJuI1",

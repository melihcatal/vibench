            "itemId": "fc_006f5122daf3df7e016aaf27a63f6887d280a198f71d65c193"
          }
        },
        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: fetch_document.py\n+import os\n+from typing import Any, Dict\n+\n+import boto3\n+from botocore.exceptions import ClientError\n+\n+\n+def fetch_document(document_id: str) -> Dict[str, Any]:\n+    table_name = os.environ[\"DYNAMODB_TABLE_NAME\"]\n+    region_name = os.getenv(\"AWS_REGION\") or os.getenv(\"AWS_DEFAULT_REGION\") or \"us-east-1\"\n+    dynamodb = boto3.resource(\"dynamodb\", region_name=region_name)\n+    table = dynamodb.Table(table_name)\n+\n+    try:\n+        response = table.get_item(Key={\"document_id\": document_id})\n+    except ClientError as exc:\n+        raise RuntimeError(f\"DynamoDB get_item failed for {document_id}\") from exc\n+\n+    item = response.get(\"Item\")\n+    if item is None:\n+        raise KeyError(document_id)\n+    return item\n+\n+\n+if __name__ == \"__main__\":\n+    import json\n+    import sys\n+\n+    if len(sys.argv) != 2:\n+        raise SystemExit(\"usage: python fetch_document.py <document_id>\")\n+    print(json.dumps(fetch_document(sys.argv[1]), sort_keys=True))\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xb119777/fetch_document.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xb119777/fetch_document.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xb119777/fetch_document.py\n@@ -0,0 +1,31 @@\n+import os\n+from typing import Any, Dict\n+\n+import boto3\n+from botocore.exceptions import ClientError\n+\n+\n+def fetch_document(document_id: str) -> Dict[str, Any]:\n+    table_name = os.environ[\"DYNAMODB_TABLE_NAME\"]\n+    region_name = os.getenv(\"AWS_REGION\") or os.getenv(\"AWS_DEFAULT_REGION\") or \"us-east-1\"\n+    dynamodb = boto3.resource(\"dynamodb\", region_name=region_name)\n+    table = dynamodb.Table(table_name)\n+\n+    try:\n+        response = table.get_item(Key={\"document_id\": document_id})\n+    except ClientError as exc:\n+        raise RuntimeError(f\"DynamoDB get_item failed for {document_id}\") from exc\n+\n+    item = response.get(\"Item\")\n+    if item is None:\n+        raise KeyError(document_id)\n+    return item\n+\n+\n+if __name__ == \"__main__\":\n+    import json\n+    import sys\n+\n+    if len(sys.argv) != 2:\n+        raise SystemExit(\"usage: python fetch_document.py <document_id>\")\n+    print(json.dumps(fetch_document(sys.argv[1]), sort_keys=True))\n\n",
            "files": [
              {
                "additions": 31,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xb119777/fetch_document.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xb119777/fetch_document.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xb119777/fetch_document.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xb119777/fetch_document.py\n@@ -0,0 +1,31 @@\n+import os\n+from typing import Any, Dict\n+\n+import boto3\n+from botocore.exceptions import ClientError\n+\n+\n+def fetch_document(document_id: str) -> Dict[str, Any]:\n+    table_name = os.environ[\"DYNAMODB_TABLE_NAME\"]\n+    region_name = os.getenv(\"AWS_REGION\") or os.getenv(\"AWS_DEFAULT_REGION\") or \"us-east-1\"\n+    dynamodb = boto3.resource(\"dynamodb\", region_name=region_name)\n+    table = dynamodb.Table(table_name)\n+\n+    try:\n+        response = table.get_item(Key={\"document_id\": document_id})\n+    except ClientError as exc:\n+        raise RuntimeError(f\"DynamoDB get_item failed for {document_id}\") from exc\n+\n+    item = response.get(\"Item\")\n+    if item is None:\n+        raise KeyError(document_id)\n+    return item\n+\n+\n+if __name__ == \"__main__\":\n+    import json\n+    import sys\n+\n+    if len(sys.argv) != 2:\n+        raise SystemExit(\"usage: python fetch_document.py <document_id>\")\n+    print(json.dumps(fetch_document(sys.argv[1]), sort_keys=True))\n",
                "relativePath": "private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xb119777/fetch_document.py",
                "type": "add"

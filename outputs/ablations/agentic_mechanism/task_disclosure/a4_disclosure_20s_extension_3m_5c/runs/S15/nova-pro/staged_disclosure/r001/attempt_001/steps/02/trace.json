    {
      "data": {
        "callID": "tooluse_vSmDxdbkz7uuYQCb9xGQOe",
        "state": {
          "input": {
            "content": "import boto3\n\ndef fetch_document(table_name, document_id):\n    dynamodb = boto3.resource('dynamodb')\n    table = dynamodb.Table(table_name)\n    response = table.get_item(\n        Key={'id': document_id}\n    )\n    return response.get('Item', None)\n\nif __name__ == '__main__':\n    table_name = 'Documents'\n    document_id = 'example-id'\n    document = fetch_document(table_name, document_id)\n    if document:\n        print(f'Document found: {document}')\n    else:\n        print('Document not found')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-6ui6woof/fetch_document.py"

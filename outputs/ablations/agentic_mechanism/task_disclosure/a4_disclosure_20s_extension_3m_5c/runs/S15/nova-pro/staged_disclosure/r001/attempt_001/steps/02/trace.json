    {
      "data": {
        "callID": "tooluse_toUYeqawuSpuZXslKZe7OO",
        "state": {
          "input": {
            "content": "import boto3\n\ndef upsert_document(table_name, primary_key, document):\n    dynamodb = boto3.resource('dynamodb')\n    table = dynamodb.Table(table_name)\n    response = table.put_item(\n        Item={\n            primary_key: document[primary_key],\n            'document': document\n        }\n    )\n    return response\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-6ui6woof/upsert_document.py"

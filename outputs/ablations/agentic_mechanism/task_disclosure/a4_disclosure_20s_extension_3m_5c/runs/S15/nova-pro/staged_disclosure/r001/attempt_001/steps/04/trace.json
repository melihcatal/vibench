      "data": {
        "callID": "tooluse_PetKkS37r87r47x8edjvoI",
        "state": {
          "input": {
            "content": "import boto3\n\ndef query_documents(table_name, key, value):\n    dynamodb = boto3.resource('dynamodb')\n    table = dynamodb.Table(table_name)\n    response = table.query(\n        KeyConditionExpression=boto3.dynamodb.conditions.Key(key).eq(value)\n    )\n    return response['Items']\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-6ui6woof/query_documents.py"
          },

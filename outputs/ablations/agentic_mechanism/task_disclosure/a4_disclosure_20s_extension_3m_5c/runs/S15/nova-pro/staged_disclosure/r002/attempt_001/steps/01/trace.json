      "data": {
        "callID": "tooluse_AiaEUHSNBOU41jlIQZVOxx",
        "state": {
          "input": {
            "content": "import boto3\n\ndef upsert_document(table_name, primary_key, document):\n    dynamodb = boto3.resource('dynamodb')\n    table = dynamodb.Table(table_name)\n    response = table.put_item(Item=document)\n    return response\n\nif __name__ == '__main__':\n    table_name = 'YourDynamoDBTableName'\n    primary_key = 'YourPrimaryKey'\n    document = {\n        'YourPrimaryKey': primary_key,\n        'OtherField': 'OtherValue'\n    }\n    response = upsert_document(table_name, primary_key, document)\n    print(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-wgtxvx_b/upsert_document.py"

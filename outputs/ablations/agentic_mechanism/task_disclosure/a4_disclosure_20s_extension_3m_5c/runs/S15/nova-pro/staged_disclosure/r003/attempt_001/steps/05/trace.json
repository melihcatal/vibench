      "data": {
        "callID": "tooluse_iWSXKMda65jPb7Jqmk7Wp0",
        "state": {
          "input": {
            "content": "import boto3\n\nDYNAMODB_TABLE_NAME = 'MyDynamoDBTable'\n\ndef get_dynamodb_client():\n    return boto3.client('dynamodb')\n\ndef create_table():\n    dynamodb = get_dynamodb_client()\n    try:\n        dynamodb.create_table(\n            TableName=DYNAMODB_TABLE_NAME,\n            KeySchema=[\n                {\n                    'AttributeName': 'id',\n                    'KeyType': 'HASH'  # Partition key\n                }\n            ],\n            AttributeDefinitions=[\n                {\n                    'AttributeName': 'id',\n                    'AttributeType': 'S'\n                }\n            ],\n            ProvisionedThroughput={\n                'ReadCapacityUnits': 5,\n                'WriteCapacityUnits': 5\n            }\n        )\n        print(f'Table {DYNAMODB_TABLE_NAME} created successfully.')\n    except Exception as e:\n        print(f'Error creating table: {e}')\n\ndef put_item(item):\n    dynamodb = get_dynamodb_client()\n    try:\n        dynamodb.put_item(TableName=DYNAMODB_TABLE_NAME, Item=item)\n        print('Item added successfully.')\n    except Exception as e:\n        print(f'Error adding item: {e}')\n\ndef get_item(key):\n    dynamodb = get_dynamodb_client()\n    try:\n        response = dynamodb.get_item(TableName=DYNAMODB_TABLE_NAME, Key=key)\n        item = response.get('Item')\n        if item:\n            print('Item retrieved successfully:', item)\n        else:\n            print('Item not found.')\n    except Exception as e:\n        print(f'Error retrieving item: {e}')\n\ndef delete_item(key):\n    dynamodb = get_dynamodb_client()\n    try:\n        dynamodb.delete_item(TableName=DYNAMODB_TABLE_NAME, Key=key)\n        print('Item deleted successfully.')\n    except Exception as e:\n        print(f'Error deleting item: {e}')\n\nif __name__ == '__main__':\n    create_table()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ot8iro9p/database_client.py"

        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: decrypt_payload.py\n+import base64\n+import json\n+import os\n+from typing import Any, Dict, Optional\n+\n+from google.cloud import kms_v1\n+\n+\n+def decrypt_payload(ciphertext: str, key_name: str, project_id: Optional[str] = None, location_id: Optional[str] = None, key_ring_id: Optional[str] = None, crypto_key_id: Optional[str] = None) -> Dict[str, Any]:\n+    client = kms_v1.KeyManagementServiceClient()\n+    if ciphertext.startswith(\"base64:\"):\n+        ciphertext_bytes = base64.b64decode(ciphertext.split(\"base64:\", 1)[1])\n+    else:\n+        ciphertext_bytes = base64.b64decode(ciphertext)\n+    response = client.decrypt(request={\"name\": key_name, \"ciphertext\": ciphertext_bytes})\n+    plaintext = response.plaintext.decode(\"utf-8\", errors=\"replace\")\n+    return {\"provider\": \"google_cloud_kms\", \"key_name\": key_name, \"plaintext\": plaintext}\n+\n+\n+def main() -> None:\n+    ciphertext = os.environ[\"CIPHERTEXT\"]\n+    key_name = os.environ[\"GCP_KMS_KEY_NAME\"]\n+    result = decrypt_payload(ciphertext=ciphertext, key_name=key_name)\n+    print(json.dumps(result, ensure_ascii=False))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-1g7giorj/decrypt_payload.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-1g7giorj/decrypt_payload.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-1g7giorj/decrypt_payload.py\n@@ -0,0 +1,28 @@\n+import base64\n+import json\n+import os\n+from typing import Any, Dict, Optional\n+\n+from google.cloud import kms_v1\n+\n+\n+def decrypt_payload(ciphertext: str, key_name: str, project_id: Optional[str] = None, location_id: Optional[str] = None, key_ring_id: Optional[str] = None, crypto_key_id: Optional[str] = None) -> Dict[str, Any]:\n+    client = kms_v1.KeyManagementServiceClient()\n+    if ciphertext.startswith(\"base64:\"):\n+        ciphertext_bytes = base64.b64decode(ciphertext.split(\"base64:\", 1)[1])\n+    else:\n+        ciphertext_bytes = base64.b64decode(ciphertext)\n+    response = client.decrypt(request={\"name\": key_name, \"ciphertext\": ciphertext_bytes})\n+    plaintext = response.plaintext.decode(\"utf-8\", errors=\"replace\")\n+    return {\"provider\": \"google_cloud_kms\", \"key_name\": key_name, \"plaintext\": plaintext}\n+\n+\n+def main() -> None:\n+    ciphertext = os.environ[\"CIPHERTEXT\"]\n+    key_name = os.environ[\"GCP_KMS_KEY_NAME\"]\n+    result = decrypt_payload(ciphertext=ciphertext, key_name=key_name)\n+    print(json.dumps(result, ensure_ascii=False))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n\n",
            "files": [
              {
                "additions": 28,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-1g7giorj/decrypt_payload.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-1g7giorj/decrypt_payload.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-1g7giorj/decrypt_payload.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-1g7giorj/decrypt_payload.py\n@@ -0,0 +1,28 @@\n+import base64\n+import json\n+import os\n+from typing import Any, Dict, Optional\n+\n+from google.cloud import kms_v1\n+\n+\n+def decrypt_payload(ciphertext: str, key_name: str, project_id: Optional[str] = None, location_id: Optional[str] = None, key_ring_id: Optional[str] = None, crypto_key_id: Optional[str] = None) -> Dict[str, Any]:\n+    client = kms_v1.KeyManagementServiceClient()\n+    if ciphertext.startswith(\"base64:\"):\n+        ciphertext_bytes = base64.b64decode(ciphertext.split(\"base64:\", 1)[1])\n+    else:\n+        ciphertext_bytes = base64.b64decode(ciphertext)\n+    response = client.decrypt(request={\"name\": key_name, \"ciphertext\": ciphertext_bytes})\n+    plaintext = response.plaintext.decode(\"utf-8\", errors=\"replace\")\n+    return {\"provider\": \"google_cloud_kms\", \"key_name\": key_name, \"plaintext\": plaintext}\n+\n+\n+def main() -> None:\n+    ciphertext = os.environ[\"CIPHERTEXT\"]\n+    key_name = os.environ[\"GCP_KMS_KEY_NAME\"]\n+    result = decrypt_payload(ciphertext=ciphertext, key_name=key_name)\n+    print(json.dumps(result, ensure_ascii=False))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n",

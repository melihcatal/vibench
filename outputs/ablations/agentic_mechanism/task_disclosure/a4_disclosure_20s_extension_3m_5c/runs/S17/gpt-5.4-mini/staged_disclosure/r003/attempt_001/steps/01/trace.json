        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: encrypt_payload.py\n+import base64\n+import os\n+import sys\n+\n+from google.cloud import kms_v1\n+\n+\n+def encrypt_payload(plaintext: str) -> str:\n+    project_id = os.environ[\"GOOGLE_CLOUD_PROJECT\"]\n+    location_id = os.environ[\"GOOGLE_KMS_LOCATION_ID\"]\n+    key_ring_id = os.environ[\"GOOGLE_KMS_KEY_RING_ID\"]\n+    crypto_key_id = os.environ[\"GOOGLE_KMS_CRYPTO_KEY_ID\"]\n+\n+    client = kms_v1.KeyManagementServiceClient()\n+    key_name = client.crypto_key_path(project_id, location_id, key_ring_id, crypto_key_id)\n+    response = client.encrypt(request={\"name\": key_name, \"plaintext\": plaintext.encode(\"utf-8\")})\n+    return base64.b64encode(response.ciphertext).decode(\"ascii\")\n+\n+\n+def main() -> None:\n+    plaintext = sys.stdin.read()\n+    if not plaintext:\n+        raise SystemExit(1)\n+    sys.stdout.write(encrypt_payload(plaintext))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-g_o_2k4v/encrypt_payload.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-g_o_2k4v/encrypt_payload.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-g_o_2k4v/encrypt_payload.py\n@@ -0,0 +1,28 @@\n+import base64\n+import os\n+import sys\n+\n+from google.cloud import kms_v1\n+\n+\n+def encrypt_payload(plaintext: str) -> str:\n+    project_id = os.environ[\"GOOGLE_CLOUD_PROJECT\"]\n+    location_id = os.environ[\"GOOGLE_KMS_LOCATION_ID\"]\n+    key_ring_id = os.environ[\"GOOGLE_KMS_KEY_RING_ID\"]\n+    crypto_key_id = os.environ[\"GOOGLE_KMS_CRYPTO_KEY_ID\"]\n+\n+    client = kms_v1.KeyManagementServiceClient()\n+    key_name = client.crypto_key_path(project_id, location_id, key_ring_id, crypto_key_id)\n+    response = client.encrypt(request={\"name\": key_name, \"plaintext\": plaintext.encode(\"utf-8\")})\n+    return base64.b64encode(response.ciphertext).decode(\"ascii\")\n+\n+\n+def main() -> None:\n+    plaintext = sys.stdin.read()\n+    if not plaintext:\n+        raise SystemExit(1)\n+    sys.stdout.write(encrypt_payload(plaintext))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n\n",

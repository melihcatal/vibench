            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-g_o_2k4v/decrypt_payload.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-g_o_2k4v/decrypt_payload.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-g_o_2k4v/decrypt_payload.py\n@@ -0,0 +1,19 @@\n+import base64\n+import os\n+from typing import Union\n+\n+from google.cloud import kms_v1\n+\n+\n+def decrypt_payload(ciphertext: Union[str, bytes], key_name: str | None = None) -> bytes:\n+    if isinstance(ciphertext, str):\n+        ciphertext_bytes = base64.b64decode(ciphertext)\n+    else:\n+        ciphertext_bytes = ciphertext\n+\n+    if key_name is None:\n+        key_name = os.environ[\"GOOGLE_CLOUD_KMS_KEY_NAME\"]\n+\n+    client = kms_v1.KeyManagementServiceClient()\n+    response = client.decrypt(request={\"name\": key_name, \"ciphertext\": ciphertext_bytes})\n+    return response.plaintext\n\n",

                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7sqdzumj/encrypt_payload.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7sqdzumj/encrypt_payload.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7sqdzumj/encrypt_payload.py\n@@ -0,0 +1,22 @@\n+import os\n+import base64\n+from typing import Optional\n+\n+import boto3\n+\n+\n+def encrypt_payload(plaintext: str, key_id: Optional[str] = None) -> str:\n+    kms_key_id = key_id or os.environ[\"AWS_KMS_KEY_ID\"]\n+    kms = boto3.client(\"kms\")\n+    response = kms.encrypt(KeyId=kms_key_id, Plaintext=plaintext.encode(\"utf-8\"))\n+    return base64.b64encode(response[\"CiphertextBlob\"]).decode(\"utf-8\")\n+\n+\n+if __name__ == \"__main__\":\n+    import sys\n+\n+    if len(sys.argv) < 2:\n+        raise SystemExit(\"Usage: encrypt_payload.py <plaintext> [kms_key_id]\")\n+    payload = sys.argv[1]\n+    key = sys.argv[2] if len(sys.argv) > 2 else None\n+    print(encrypt_payload(payload, key))\n",

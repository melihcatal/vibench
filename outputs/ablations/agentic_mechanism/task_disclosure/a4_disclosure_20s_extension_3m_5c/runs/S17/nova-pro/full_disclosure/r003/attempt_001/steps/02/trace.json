          "input": {
            "content": "import boto3\n\ndef decrypt_payload(ciphertext_blob, key_id):\n    kms_client = boto3.client('kms', region_name='us-west-2')\n    response = kms_client.decrypt(\n        CiphertextBlob=ciphertext_blob,\n        KeyId=key_id\n    )\n    return response['Plaintext']\n",

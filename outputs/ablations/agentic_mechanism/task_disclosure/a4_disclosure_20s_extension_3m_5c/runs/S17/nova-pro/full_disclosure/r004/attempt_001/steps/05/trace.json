        "callID": "tooluse_A0PwlYHBlJye1DjM29YslX",
        "state": {
          "input": {
            "content": "import boto3\n\nclass SecurityClient:\n    def __init__(self, region_name='us-west-2'):\n        self.kms_client = boto3.client('kms', region_name=region_name)\n\n    def encrypt(self, plaintext, key_id):\n        response = self.kms_client.encrypt(\n            KeyId=key_id,\n            Plaintext=plaintext\n        )\n        return response['CiphertextBlob']\n\n    def decrypt(self, ciphertext_blob, key_id):\n        response = self.kms_client.decrypt(\n            CiphertextBlob=ciphertext_blob,\n            KeyId=key_id\n        )\n        return response['Plaintext']\n\n    def generate_data_key(self, key_id):\n        response = self.kms_client.generate_data_key(\n            KeyId=key_id,\n            KeySpec='AES_256'\n        )\n        return response['Plaintext'], response['CiphertextBlob']\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-mxc5srn9/security_client.py"

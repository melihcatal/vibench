        "callID": "tooluse_4do4TNpJXf5TfmSEEdv7Ca",
        "state": {
          "input": {
            "content": "import boto3\n\ndef encrypt_payload(plaintext):\n    kms_client = boto3.client('kms')\n    key_id = 'alias/myManagedKey'\n    response = kms_client.encrypt(\n        KeyId=key_id,\n        Plaintext=plaintext\n    )\n    return response['CiphertextBlob']\n\nif __name__ == '__main__':\n    plaintext = 'This is a secret message.'\n    encrypted_payload = encrypt_payload(plaintext)\n    print(f'Encrypted payload: {encrypted_payload}')\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-0ombs9yd/encrypt_payload.py"

      "data": {
        "callID": "tooluse_JXILJd9rfD0vbD8yKlRI2Z",
        "state": {
          "input": {
            "content": "import boto3\n\ndef encrypt_data(plaintext):\n    kms_client = boto3.client('kms', region_name='us-west-2')\n    key_id = 'alias/example-key'\n    response = kms_client.encrypt(\n        KeyId=key_id,\n        Plaintext=plaintext\n    )\n    return response['CiphertextBlob']\n\ndef decrypt_data(ciphertext):\n    kms_client = boto3.client('kms', region_name='us-west-2')\n    response = kms_client.decrypt(\n        CiphertextBlob=ciphertext\n    )\n    return response['Plaintext']\n\nif __name__ == '__main__':\n    data_to_encrypt = b'This is some sensitive data.'\n    encrypted_data = encrypt_data(data_to_encrypt)\n    print('Encrypted data:', encrypted_data)\n    decrypted_data = decrypt_data(encrypted_data)\n    print('Decrypted data:', decrypted_data.decode('utf-8'))",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-0ombs9yd/envelope_encrypt.py"

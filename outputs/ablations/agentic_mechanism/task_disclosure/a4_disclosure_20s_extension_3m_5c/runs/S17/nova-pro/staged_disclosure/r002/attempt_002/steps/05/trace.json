      "data": {
        "callID": "tooluse_KSvIlF25zAmOVKcsUlLVON",
        "state": {
          "input": {
            "content": "import boto3\n\ndef configure_kms_client(region_name='us-west-2'):\n    session = boto3.Session(region_name=region_name)\n    kms_client = session.client('kms')\n    return kms_client\n\ndef encrypt_data(kms_client, plaintext):\n    response = kms_client.encrypt(\n        KeyId='alias/example_key',\n        Plaintext=plaintext\n    )\n    return response['CiphertextBlob']\n\ndef decrypt_data(kms_client, ciphertext):\n    response = kms_client.decrypt(\n        CiphertextBlob=ciphertext\n    )\n    return response['Plaintext'].decode('utf-8')\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-v9enh55z/security_client.py"

      "data": {
        "callID": "tooluse_3umJZ4ftLrE8Crt4sLGKQo",
        "state": {
          "input": {
            "content": "import boto3\n\ndef encrypt_data(plaintext):\n    kms_client = boto3.client('kms')\n    key_id = 'alias/my_key'\n    response = kms_client.encrypt(\n        KeyId=key_id,\n        Plaintext=plaintext\n    )\n    return response['CiphertextBlob']\n\ndef decrypt_data(ciphertext):\n    kms_client = boto3.client('kms')\n    response = kms_client.decrypt(\n        CiphertextBlob=ciphertext\n    )\n    return response['Plaintext']\n\nif __name__ == '__main__':\n    plaintext = b'This is a secret message.'\n    ciphertext = encrypt_data(plaintext)\n    print('Encrypted data:', ciphertext)\n    decrypted_data = decrypt_data(ciphertext)\n    print('Decrypted data:', decrypted_data.decode())",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-pns6jf62/envelope_encrypt.py"
          },

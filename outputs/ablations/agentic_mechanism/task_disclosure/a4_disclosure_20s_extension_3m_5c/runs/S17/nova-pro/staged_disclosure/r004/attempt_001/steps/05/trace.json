        "callID": "tooluse_1QA8aAJJyjEQVLWUvztQ5m",
        "state": {
          "input": {
            "content": "import boto3\n\ndef envelope_encrypt(data):\n    kms_client = boto3.client('kms')\n    key_id = 'alias/example_key'\n    plaintext = data.encode('utf-8')\n    response = kms_client.encrypt(\n        KeyId=key_id,\n        Plaintext=plaintext\n    )\n    encrypted_data_key = response['CiphertextBlob']\n    data_key = response['KeyId']\n    return encrypted_data_key, data_key\n\ndef envelope_decrypt(encrypted_data_key, data_key):\n    kms_client = boto3.client('kms')\n    response = kms_client.decrypt(\n        CiphertextBlob=encrypted_data_key,\n        KeyId=data_key\n    )\n    decrypted_data = response['Plaintext'].decode('utf-8')\n    return decrypted_data",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-b1dh9o_z/envelope_encrypt.py"

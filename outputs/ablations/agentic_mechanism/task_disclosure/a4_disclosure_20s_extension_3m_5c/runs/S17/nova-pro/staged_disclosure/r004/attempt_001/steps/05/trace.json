    {
      "data": {
        "callID": "tooluse_h0EDbEAiGlVQtbT9BZhoQY",
        "state": {
          "input": {
            "content": "import boto3\n\ndef sign_message(key_id, message):\n    kms = boto3.client('kms')\n    response = kms.sign(\n        KeyId=key_id,\n        Message=message,\n        SigningAlgorithm='RSASSA_PKCS1_V1_5'\n    )\n    return response['Signature']\n\ndef verify_signature(key_id, message, signature):\n    kms = boto3.client('kms')\n    response = kms.verify(\n        KeyId=key_id,\n        Message=message,\n        Signature=signature,\n        SigningAlgorithm='RSASSA_PKCS1_V1_5'\n    )\n    return response['SignatureValid']",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-b1dh9o_z/sign_or_verify_key.py"
          },

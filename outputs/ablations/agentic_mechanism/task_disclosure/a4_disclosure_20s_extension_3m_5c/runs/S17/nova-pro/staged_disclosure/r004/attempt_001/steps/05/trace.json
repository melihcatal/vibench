      "data": {
        "callID": "tooluse_5nNcXleKTyBjVwF2hyfED1",
        "state": {
          "input": {
            "content": "import boto3\nimport os\n\n# Initialize a session using Amazon KMS\nsession = boto3.Session()\nkms = session.client('kms')\n\n# Local configuration for KMS\ndef get_kms_config():\n    return {\n        'region': os.getenv('AWS_REGION', 'us-west-2'),\n        'access_key': os.getenv('AWS_ACCESS_KEY_ID'),\n        'secret_key': os.getenv('AWS_SECRET_ACCESS_KEY')\n    }\n\n# Helper utility to encrypt data\ndef encrypt_data(plaintext):\n    response = kms.encrypt(\n        KeyId=os.getenv('KMS_KEY_ID'),\n        Plaintext=plaintext\n    )\n    return response['CiphertextBlob']\n\n# Helper utility to decrypt data\ndef decrypt_data(ciphertext):\n    response = kms.decrypt(\n        CiphertextBlob=ciphertext\n    )\n    return response['Plaintext']",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-b1dh9o_z/security_client.py"

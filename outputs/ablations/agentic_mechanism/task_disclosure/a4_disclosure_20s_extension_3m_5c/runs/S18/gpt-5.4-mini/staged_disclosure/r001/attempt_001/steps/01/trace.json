                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dzf13hbp/publish_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dzf13hbp/publish_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dzf13hbp/publish_event.py\n@@ -0,0 +1,21 @@\n+import json\n+import os\n+from typing import Any, Dict, Optional\n+\n+import boto3\n+\n+\n+def publish_event(event: Dict[str, Any], topic_arn: Optional[str] = None) -> str:\n+    sns = boto3.client(\"sns\")\n+    arn = topic_arn or os.environ[\"AWS_SNS_TOPIC_ARN\"]\n+    response = sns.publish(TopicArn=arn, Message=json.dumps(event), MessageStructure=\"string\")\n+    return response[\"MessageId\"]\n+\n+\n+def main() -> None:\n+    event = json.loads(os.environ.get(\"EVENT_JSON\", \"{}\"))\n+    publish_event(event)\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n",

                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dzf13hbp/consume_event.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dzf13hbp/consume_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dzf13hbp/consume_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-dzf13hbp/consume_event.py\n@@ -0,0 +1,26 @@\n+import json\n+import os\n+from google.cloud import pubsub_v1\n+\n+\n+def consume_event() -> str:\n+    project_id = os.environ[\"GCP_PROJECT_ID\"]\n+    subscription_id = os.environ[\"GCP_PUBSUB_SUBSCRIPTION\"]\n+    subscription_path = f\"projects/{project_id}/subscriptions/{subscription_id}\"\n+    subscriber = pubsub_v1.SubscriberClient()\n+    response = subscriber.pull(subscription=subscription_path, max_messages=1, timeout=10)\n+    if not response.received_messages:\n+        return \"\"\n+    received = response.received_messages[0]\n+    ack_id = received.ack_id\n+    message = received.message\n+    payload = message.data.decode(\"utf-8\") if message.data else \"\"\n+    attributes = dict(message.attributes)\n+    subscriber.acknowledge(subscription=subscription_path, ack_ids=[ack_id])\n+    if attributes:\n+        return json.dumps({\"data\": payload, \"attributes\": attributes}, ensure_ascii=False)\n+    return payload\n+\n+\n+if __name__ == \"__main__\":\n+    print(consume_event())\n",

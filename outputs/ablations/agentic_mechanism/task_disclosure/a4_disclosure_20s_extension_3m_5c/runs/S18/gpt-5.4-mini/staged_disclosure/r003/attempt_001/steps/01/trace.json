            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fb2x8ofj/publish_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fb2x8ofj/publish_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fb2x8ofj/publish_event.py\n@@ -0,0 +1,22 @@\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def main() -> None:\n+    project_id = os.environ[\"GOOGLE_CLOUD_PROJECT\"]\n+    topic_id = os.environ[\"PUBSUB_TOPIC_ID\"]\n+    event = json.loads(sys.stdin.read() or \"{}\")\n+\n+    publisher = pubsub_v1.PublisherClient()\n+    topic_path = publisher.topic_path(project_id, topic_id)\n+    data = json.dumps(event).encode(\"utf-8\")\n+    future = publisher.publish(topic_path, data=data, content_type=\"application/json\")\n+    message_id = future.result()\n+    sys.stdout.write(message_id)\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n\n",

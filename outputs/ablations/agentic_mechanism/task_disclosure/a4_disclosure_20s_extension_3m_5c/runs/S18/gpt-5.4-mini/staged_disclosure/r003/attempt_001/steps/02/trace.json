        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: consume_event.py\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def consume_one_message() -> int:\n+    project_id = os.environ.get(\"GOOGLE_CLOUD_PROJECT\") or os.environ.get(\"GCP_PROJECT\")\n+    subscription_id = os.environ.get(\"PUBSUB_SUBSCRIPTION\")\n+    if not project_id:\n+        raise RuntimeError(\"GOOGLE_CLOUD_PROJECT or GCP_PROJECT is required\")\n+    if not subscription_id:\n+        raise RuntimeError(\"PUBSUB_SUBSCRIPTION is required\")\n+\n+    subscriber = pubsub_v1.SubscriberClient()\n+    subscription_path = subscriber.subscription_path(project_id, subscription_id)\n+\n+    response = subscriber.pull(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"max_messages\": 1,\n+        },\n+        timeout=10,\n+    )\n+\n+    if not response.received_messages:\n+        return 0\n+\n+    received = response.received_messages[0]\n+    message = received.message\n+    payload = message.data.decode(\"utf-8\") if message.data else \"\"\n+\n+    try:\n+        parsed = json.loads(payload) if payload else None\n+    except json.JSONDecodeError:\n+        parsed = payload\n+\n+    print(json.dumps({\"message_id\": message.message_id, \"payload\": parsed}, ensure_ascii=False))\n+\n+    subscriber.acknowledge(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"ack_ids\": [received.ack_id],\n+        }\n+    )\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(consume_one_message())\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fb2x8ofj/consume_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fb2x8ofj/consume_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-fb2x8ofj/consume_event.py\n@@ -0,0 +1,51 @@\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def consume_one_message() -> int:\n+    project_id = os.environ.get(\"GOOGLE_CLOUD_PROJECT\") or os.environ.get(\"GCP_PROJECT\")\n+    subscription_id = os.environ.get(\"PUBSUB_SUBSCRIPTION\")\n+    if not project_id:\n+        raise RuntimeError(\"GOOGLE_CLOUD_PROJECT or GCP_PROJECT is required\")\n+    if not subscription_id:\n+        raise RuntimeError(\"PUBSUB_SUBSCRIPTION is required\")\n+\n+    subscriber = pubsub_v1.SubscriberClient()\n+    subscription_path = subscriber.subscription_path(project_id, subscription_id)\n+\n+    response = subscriber.pull(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"max_messages\": 1,\n+        },\n+        timeout=10,\n+    )\n+\n+    if not response.received_messages:\n+        return 0\n+\n+    received = response.received_messages[0]\n+    message = received.message\n+    payload = message.data.decode(\"utf-8\") if message.data else \"\"\n+\n+    try:\n+        parsed = json.loads(payload) if payload else None\n+    except json.JSONDecodeError:\n+        parsed = payload\n+\n+    print(json.dumps({\"message_id\": message.message_id, \"payload\": parsed}, ensure_ascii=False))\n+\n+    subscriber.acknowledge(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"ack_ids\": [received.ack_id],\n+        }\n+    )\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(consume_one_message())\n\n",
            "files": [

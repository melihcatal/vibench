                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/publish_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/publish_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/publish_event.py\n@@ -0,0 +1,22 @@\n+import json\n+import os\n+import sys\n+\n+import boto3\n+\n+\n+def publish_event(topic_arn: str, event: dict) -> str:\n+    sns = boto3.client(\"sns\")\n+    response = sns.publish(TopicArn=topic_arn, Message=json.dumps(event), MessageStructure=\"string\")\n+    return response[\"MessageId\"]\n+\n+\n+def main() -> None:\n+    topic_arn = os.environ[\"AWS_SNS_TOPIC_ARN\"]\n+    payload = json.loads(sys.stdin.read() or \"{}\")\n+    message_id = publish_event(topic_arn, payload)\n+    print(message_id)\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n",

            "itemId": "fc_0839bdc99f4e43b2016aaf3eb2761487d2ac1e5f7f238e92a9"
          }
        },
        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: consume_event.py\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def consume_one_message() -> int:\n+    subscription_path = os.environ[\"PUBSUB_SUBSCRIPTION\"]\n+    subscriber = pubsub_v1.SubscriberClient()\n+    response = subscriber.pull(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"max_messages\": 1,\n+        },\n+        timeout=30,\n+    )\n+\n+    if not response.received_messages:\n+        print(json.dumps({\"message\": None}))\n+        return 0\n+\n+    received = response.received_messages[0]\n+    message = received.message\n+    print(\n+        json.dumps(\n+            {\n+                \"message_id\": message.message_id,\n+                \"data\": message.data.decode(\"utf-8\", errors=\"replace\"),\n+                \"attributes\": dict(message.attributes),\n+                \"publish_time\": message.publish_time.isoformat() if message.publish_time else None,\n+            }\n+        )\n+    )\n+    subscriber.acknowledge(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"ack_ids\": [received.ack_id],\n+        }\n+    )\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    try:\n+        raise SystemExit(consume_one_message())\n+    except KeyError as exc:\n+        print(f\"Missing required environment variable: {exc.args[0]}\", file=sys.stderr)\n+        raise SystemExit(1)\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/consume_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/consume_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/consume_event.py\n@@ -0,0 +1,49 @@\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def consume_one_message() -> int:\n+    subscription_path = os.environ[\"PUBSUB_SUBSCRIPTION\"]\n+    subscriber = pubsub_v1.SubscriberClient()\n+    response = subscriber.pull(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"max_messages\": 1,\n+        },\n+        timeout=30,\n+    )\n+\n+    if not response.received_messages:\n+        print(json.dumps({\"message\": None}))\n+        return 0\n+\n+    received = response.received_messages[0]\n+    message = received.message\n+    print(\n+        json.dumps(\n+            {\n+                \"message_id\": message.message_id,\n+                \"data\": message.data.decode(\"utf-8\", errors=\"replace\"),\n+                \"attributes\": dict(message.attributes),\n+                \"publish_time\": message.publish_time.isoformat() if message.publish_time else None,\n+            }\n+        )\n+    )\n+    subscriber.acknowledge(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"ack_ids\": [received.ack_id],\n+        }\n+    )\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    try:\n+        raise SystemExit(consume_one_message())\n+    except KeyError as exc:\n+        print(f\"Missing required environment variable: {exc.args[0]}\", file=sys.stderr)\n+        raise SystemExit(1)\n\n",
            "files": [
              {
                "additions": 49,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/consume_event.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/consume_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/consume_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8g8hjdv2/consume_event.py\n@@ -0,0 +1,49 @@\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def consume_one_message() -> int:\n+    subscription_path = os.environ[\"PUBSUB_SUBSCRIPTION\"]\n+    subscriber = pubsub_v1.SubscriberClient()\n+    response = subscriber.pull(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"max_messages\": 1,\n+        },\n+        timeout=30,\n+    )\n+\n+    if not response.received_messages:\n+        print(json.dumps({\"message\": None}))\n+        return 0\n+\n+    received = response.received_messages[0]\n+    message = received.message\n+    print(\n+        json.dumps(\n+            {\n+                \"message_id\": message.message_id,\n+                \"data\": message.data.decode(\"utf-8\", errors=\"replace\"),\n+                \"attributes\": dict(message.attributes),\n+                \"publish_time\": message.publish_time.isoformat() if message.publish_time else None,\n+            }\n+        )\n+    )\n+    subscriber.acknowledge(\n+        request={\n+            \"subscription\": subscription_path,\n+            \"ack_ids\": [received.ack_id],\n+        }\n+    )\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    try:\n+        raise SystemExit(consume_one_message())\n+    except KeyError as exc:\n+        print(f\"Missing required environment variable: {exc.args[0]}\", file=sys.stderr)\n+        raise SystemExit(1)\n",

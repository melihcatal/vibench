        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: publish_event.py\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def publish_event(topic_path: str, event: dict) -> str:\n+    publisher = pubsub_v1.PublisherClient()\n+    data = json.dumps(event, separators=(\",\", \":\")).encode(\"utf-8\")\n+    future = publisher.publish(topic_path, data=data, content_type=\"application/json\")\n+    return future.result()\n+\n+\n+def main() -> int:\n+    project_id = os.environ.get(\"GOOGLE_CLOUD_PROJECT\") or os.environ.get(\"GCLOUD_PROJECT\")\n+    topic_id = os.environ.get(\"PUBSUB_TOPIC\")\n+    if not project_id or not topic_id:\n+        raise SystemExit(\"GOOGLE_CLOUD_PROJECT and PUBSUB_TOPIC are required\")\n+\n+    event_json = os.environ.get(\"EVENT_JSON\")\n+    if event_json:\n+        event = json.loads(event_json)\n+    else:\n+        event = {\n+            \"type\": \"example.event\",\n+            \"source\": \"publish_event.py\",\n+            \"payload\": {\"message\": \"hello\"},\n+        }\n+\n+    topic_path = pubsub_v1.PublisherClient().topic_path(project_id, topic_id)\n+    message_id = publish_event(topic_path, event)\n+    sys.stdout.write(message_id)\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_5866kop/publish_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_5866kop/publish_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_5866kop/publish_event.py\n@@ -0,0 +1,38 @@\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def publish_event(topic_path: str, event: dict) -> str:\n+    publisher = pubsub_v1.PublisherClient()\n+    data = json.dumps(event, separators=(\",\", \":\")).encode(\"utf-8\")\n+    future = publisher.publish(topic_path, data=data, content_type=\"application/json\")\n+    return future.result()\n+\n+\n+def main() -> int:\n+    project_id = os.environ.get(\"GOOGLE_CLOUD_PROJECT\") or os.environ.get(\"GCLOUD_PROJECT\")\n+    topic_id = os.environ.get(\"PUBSUB_TOPIC\")\n+    if not project_id or not topic_id:\n+        raise SystemExit(\"GOOGLE_CLOUD_PROJECT and PUBSUB_TOPIC are required\")\n+\n+    event_json = os.environ.get(\"EVENT_JSON\")\n+    if event_json:\n+        event = json.loads(event_json)\n+    else:\n+        event = {\n+            \"type\": \"example.event\",\n+            \"source\": \"publish_event.py\",\n+            \"payload\": {\"message\": \"hello\"},\n+        }\n+\n+    topic_path = pubsub_v1.PublisherClient().topic_path(project_id, topic_id)\n+    message_id = publish_event(topic_path, event)\n+    sys.stdout.write(message_id)\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n\n",
            "files": [
              {
                "additions": 38,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_5866kop/publish_event.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_5866kop/publish_event.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_5866kop/publish_event.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_5866kop/publish_event.py\n@@ -0,0 +1,38 @@\n+import json\n+import os\n+import sys\n+\n+from google.cloud import pubsub_v1\n+\n+\n+def publish_event(topic_path: str, event: dict) -> str:\n+    publisher = pubsub_v1.PublisherClient()\n+    data = json.dumps(event, separators=(\",\", \":\")).encode(\"utf-8\")\n+    future = publisher.publish(topic_path, data=data, content_type=\"application/json\")\n+    return future.result()\n+\n+\n+def main() -> int:\n+    project_id = os.environ.get(\"GOOGLE_CLOUD_PROJECT\") or os.environ.get(\"GCLOUD_PROJECT\")\n+    topic_id = os.environ.get(\"PUBSUB_TOPIC\")\n+    if not project_id or not topic_id:\n+        raise SystemExit(\"GOOGLE_CLOUD_PROJECT and PUBSUB_TOPIC are required\")\n+\n+    event_json = os.environ.get(\"EVENT_JSON\")\n+    if event_json:\n+        event = json.loads(event_json)\n+    else:\n+        event = {\n+            \"type\": \"example.event\",\n+            \"source\": \"publish_event.py\",\n+            \"payload\": {\"message\": \"hello\"},\n+        }\n+\n+    topic_path = pubsub_v1.PublisherClient().topic_path(project_id, topic_id)\n+    message_id = publish_event(topic_path, event)\n+    sys.stdout.write(message_id)\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n",

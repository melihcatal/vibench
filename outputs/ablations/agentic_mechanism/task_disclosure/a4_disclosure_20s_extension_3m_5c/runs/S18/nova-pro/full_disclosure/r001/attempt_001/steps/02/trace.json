        "callID": "tooluse_ExZ2ggdVoz3OnJI1bSMsOZ",
        "state": {
          "input": {
            "content": "import boto3\n\ndef publish_event(topic_arn, message):\n    sns_client = boto3.client('sns')\n    response = sns_client.publish(\n        TopicArn=topic_arn,\n        Message=message,\n        MessageStructure='json'\n    )\n    return response\n",

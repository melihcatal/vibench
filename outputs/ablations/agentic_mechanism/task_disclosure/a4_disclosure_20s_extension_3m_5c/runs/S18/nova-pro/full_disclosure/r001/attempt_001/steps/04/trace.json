      "data": {
        "callID": "tooluse_kRSNNTrg8Az386ExHa5xH8",
        "state": {
          "input": {
            "content": "from google.cloud import pubsub_v1\n\ndef consume_event(project_id, subscription_id):\n    subscriber = pubsub_v1.SubscriberClient()\n    subscription_path = subscriber.subscription_path(project_id, subscription_id)\n    response = subscriber.pull(request={\n        'subscription': subscription_path,\n        'max_messages': 1\n    })\n    if response.received_messages:\n        message = response.received_messages[0]\n        ack_id = message.ack_id\n        data = message.message.data.decode('utf-8')\n        print(f'Received message: {data}')\n        subscriber.acknowledge(request={\n            'subscription': subscription_path,\n            'ack_ids': [ack_id]\n        })\n    else:\n        print('No messages returned.')\n\n# Example usage:\n# consume_event('your-project-id', 'your-subscription-id')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-bgf29q86/consume_event.py"
          },

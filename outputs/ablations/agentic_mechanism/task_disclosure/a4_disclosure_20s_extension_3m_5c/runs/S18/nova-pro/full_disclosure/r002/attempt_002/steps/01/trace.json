          "input": {
            "content": "import json\nimport boto3\n\ndef publish_event(topic_arn, message):\n    sns_client = boto3.client('sns')\n    response = sns_client.publish(\n        TopicArn=topic_arn,\n        Message=json.dumps({'default': json.dumps(message)}),\n        MessageStructure='json'\n    )\n    return response\n",

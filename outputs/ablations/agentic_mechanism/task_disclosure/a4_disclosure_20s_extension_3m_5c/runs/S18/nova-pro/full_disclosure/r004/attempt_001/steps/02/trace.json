      "data": {
        "callID": "tooluse_AFYB9lSCKVcrhUtrMkYlHe",
        "state": {
          "input": {
            "content": "import boto3\n\n\ndef publish_event(topic_arn, message):\n    sns_client = boto3.client('sns')\n    response = sns_client.publish(\n        TopicArn=topic_arn,\n        Message=message,\n        MessageStructure='json'\n    )\n    return response\n\n\nif __name__ == '__main__':\n    topic_arn = 'arn:aws:sns:region:account-id:topic-name'\n    message = '{\"default\": \"Your message here\"}'\n    response = publish_event(topic_arn, message)\n    print(response)",

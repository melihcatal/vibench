      "time_updated": 1789865745383
    },
    {
      "data": {
        "callID": "tooluse_ndn89yRtyKZIWPP8mzuBBZ",
        "state": {
          "input": {
            "content": "import boto3\n\ndef consume_event():\n    sqs = boto3.client('sqs')\n    queue_url = 'https://sqs.us-east-1.amazonaws.com/123456789012/my-queue'\n    response = sqs.receive_message(\n        QueueUrl=queue_url,\n        MaxNumberOfMessages=1,\n        WaitTimeSeconds=10\n    )\n    if 'Messages' in response:\n        message = response['Messages'][0]\n        print(f\"Received message: {message['Body']}\")\n        sqs.delete_message(\n            QueueUrl=queue_url,\n            ReceiptHandle=message['ReceiptHandle']\n        )\n    else:\n        print('No messages to consume.')\n\nif __name__ == '__main__':\n    consume_event()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-mj22nljm/consume_event.py"
          },

      "data": {
        "text": "\"Create publish_event.py in the current working directory.\nTask: publishes a JSON event to a managed messaging topic or queue.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc4fb57e001pDPuJbZsSklS2Y",

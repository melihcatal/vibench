    {
      "data": {
        "callID": "tooluse_5meWK1r2XhJgELVFEm9xej",
        "state": {
          "input": {
            "content": "import boto3\n\ndef publish_event(topic_arn, message):\n    sns = boto3.client('sns')\n    response = sns.publish(\n        TopicArn=topic_arn,\n        Message=message,\n        Subject='Test SNS Message'\n    )\n    return response\n\nif __name__ == '__main__':\n    topic_arn = 'arn:aws:sns:REGION:ACCOUNT_ID:TOPIC_NAME'\n    message = '{\"event\": \"test\"}'\n    response = publish_event(topic_arn, message)\n    print(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8m4uq2s9/publish_event.py"

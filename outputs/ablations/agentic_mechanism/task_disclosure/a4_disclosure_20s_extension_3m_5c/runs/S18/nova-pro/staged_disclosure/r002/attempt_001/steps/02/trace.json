          "end": 1789864711425,
          "start": 1789864709288
        },
        "type": "text"
      },
      "id": "prt_0bc400ca8001OXJ0y4UnX33M27",
      "message_id": "msg_0bc400652001l1oEryz85vAvBU",
      "session_id": "ses_f43bffa33ffeJI1uOsW0J3AxlT",

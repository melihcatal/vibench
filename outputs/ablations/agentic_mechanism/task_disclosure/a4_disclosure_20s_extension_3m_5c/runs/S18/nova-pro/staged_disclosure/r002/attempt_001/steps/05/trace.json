    {
      "data": {
        "callID": "tooluse_ZqibhqON64ybZ69gPQEhmp",
        "state": {
          "input": {
            "content": "import boto3\n\ndef batch_publish(queue_url, messages):\n    sqs = boto3.client('sqs')\n    entries = []\n    for message in messages:\n        entries.append({\n            'Id': message['Id'],\n            'MessageBody': message['Body'],\n            'MessageAttributes': message.get('Attributes', {})\n        })\n    response = sqs.send_message_batch(\n        QueueUrl=queue_url,\n        Entries=entries\n    )\n    return response\n\nif __name__ == '__main__':\n    queue_url = 'https://sqs.us-east-1.amazonaws.com/123456789012/MyQueue'\n    messages = [\n        {\n            'Id': '1',\n            'Body': 'Hello, World!',\n            'Attributes': {\n                'Title': {'StringValue': 'Test', 'DataType': 'String'}\n            }\n        },\n        {\n            'Id': '2',\n            'Body': 'Hello again!',\n            'Attributes': {\n                'Title': {'StringValue': 'Test', 'DataType': 'String'}\n            }\n        }\n    ]\n    response = batch_publish(queue_url, messages)\n    print(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-8m4uq2s9/batch_publish.py"

    {
      "data": {
        "callID": "tooluse_w3zPYkCp2V1bHr9DwtcNwt",
        "state": {
          "input": {
            "content": "import boto3\n\ndef publish_batch(topic_arn, messages):\n    sns = boto3.client('sns')\n    publish_batch_request_entries = []\n    for message in messages:\n        publish_batch_request_entries.append({\n            'Id': message['Id'],\n            'Message': message['Message']\n        })\n    response = sns.publish_batch(\n        TopicArn=topic_arn,\n        PublishBatchRequestEntries=publish_batch_request_entries\n    )\n    return response\n\n# Example usage\ntopic_arn = 'arn:aws:sns:us-east-1:123456789012:MyTopic'\nmessages = [\n    {\n        'Id': '1',\n        'Message': 'Hello from message 1'\n    },\n    {\n        'Id': '2',\n        'Message': 'Hello from message 2'\n    }\n]\nresponse = publish_batch(topic_arn, messages)\nprint(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_nkyt7aj/batch_publish.py"
          },

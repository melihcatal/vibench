    {
      "data": {
        "callID": "tooluse_v54UAta6rkDQsZ2v4vk8Qs",
        "state": {
          "input": {
            "content": "import boto3\n\ndef consume_event():\n    sqs = boto3.client('sqs', region_name='us-east-1')\n    queue_url = 'https://sqs.us-east-1.amazonaws.com/123456789012/MyQueue'\n    response = sqs.receive_message(QueueUrl=queue_url, MaxNumberOfMessages=1, WaitTimeSeconds=10)\n    if 'Messages' in response:\n        message = response['Messages'][0]\n        print('Received message:', message['Body'])\n        sqs.delete_message(QueueUrl=queue_url, ReceiptHandle=message['ReceiptHandle'])\n    else:\n        print('No messages to consume')\n\nif __name__ == '__main__':\n    consume_event()",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ordxpqxn/consume_event.py"

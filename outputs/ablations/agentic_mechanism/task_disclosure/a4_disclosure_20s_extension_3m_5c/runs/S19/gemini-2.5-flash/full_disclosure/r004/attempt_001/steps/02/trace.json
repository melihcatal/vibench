        "state": {
          "input": {
            "content": "from google.cloud import monitoring_v3\nfrom datetime import datetime, timedelta\nimport google.api_core.exceptions\n\ndef query_metric_window(\n    project_id: str,\n    metric_type: str,\n    end_time: datetime,\n    time_window_minutes: int,\n):\n    client = monitoring_v3.MetricServiceClient()\n    project_name = f\"projects/{project_id}\"\n\n    start_time = end_time - timedelta(minutes=time_window_minutes)\n\n    interval = monitoring_v3.TimeInterval(\n        end_time={'seconds': int(end_time.timestamp())},\n        start_time={'seconds': int(start_time.timestamp())}\n    )\n\n    query_filter = f'metric.type = \"{metric_type}\"'\n\n    try:\n        response = client.list_time_series(\n            name=project_name,\n            filter=query_filter,\n            interval=interval,\n            view=monitoring_v3.ListTimeSeriesRequest.TimeSeriesView.FULL,\n        )\n\n        time_series_data = []\n        for series in response:\n            for point in series.points:\n                time_series_data.append({\n                    \"timestamp\": point.interval.end_time.timestamp(),\n                    \"value\": point.value.double_value if point.value.HasField(\"double_value\") else point.value.int64_value\n                })\n        return time_series_data\n    except google.api_core.exceptions.GoogleAPICallError as e:\n        print(f\"Error querying metric: {e}\")\n        return None\n",

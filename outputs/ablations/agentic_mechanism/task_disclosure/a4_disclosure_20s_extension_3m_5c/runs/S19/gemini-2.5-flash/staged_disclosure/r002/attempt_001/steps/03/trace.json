      "data": {
        "text": "\"Create filter_metric_dimensions.py in the current working directory.\nTask: queries metric data filtered by resource labels or dimensions.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc09c0d8001fEQe5k8eEgQ5u9",

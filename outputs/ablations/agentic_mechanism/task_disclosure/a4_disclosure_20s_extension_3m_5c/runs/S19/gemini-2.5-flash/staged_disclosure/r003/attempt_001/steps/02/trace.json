      "data": {
        "text": "\"Create query_metric_window.py in the current working directory.\nTask: queries recent datapoints for a named metric over a time window.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bc469cb8001K1GcCnyTVELRJC",
      "message_id": "msg_0bc469cb30010T9TLeIWxxfuFR",

      "data": {
        "callID": "tooluse_qxIMILsXWQmonh3n7KtNQP",
        "state": {
          "input": {
            "content": "import boto3\n\ndef query_metric_window(metric_name, start_time, end_time):\n    cloudwatch = boto3.client('cloudwatch')\n    response = cloudwatch.get_metric_data(\n        MetricDataQueries=[\n            {\n                'Id': 'm1',\n                'MetricStat': {\n                    'Metric': {\n                        'Namespace': 'AWS/EC2',\n                        'MetricName': metric_name,\n                        'Dimensions': [{\n                            'Name': 'InstanceId',\n                            'Value': 'i-0123456789abcdef0'\n                        }]\n                    },\n                    'Period': 300,\n                    'Stat': 'Average'\n                }\n            }\n        ],\n        StartTime=start_time,\n        EndTime=end_time\n    )\n    return response\n\nif __name__ == '__main__':\n    start_time = '2026-09-19T00:00:00Z'\n    end_time = '2026-09-20T00:00:00Z'\n    metric_name = 'CPUUtilization'\n    result = query_metric_window(metric_name, start_time, end_time)\n    print(result)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-asoyslef/query_metric_window.py"

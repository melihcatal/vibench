    },
    {
      "data": {
        "callID": "tooluse_WDWqH0q7vile1OWCZwKYtX",
        "state": {
          "input": {
            "content": "import boto3\n\ndef get_aggregated_metric_stats(namespace, metric_name, start_time, end_time):\n    cloudwatch = boto3.client('cloudwatch')\n    response = cloudwatch.get_metric_statistics(\n        Namespace=namespace,\n        MetricName=metric_name,\n        Dimensions=[\n            {\n                'Name': 'AutoScalingGroupName',\n                'Value': 'my-asg'\n            }\n        ],\n        StartTime=start_time,\n        EndTime=end_time,\n        Period=300,\n        Statistics=['Average', 'Sum', 'SampleCount', 'Minimum', 'Maximum'],\n        Unit='Seconds'\n    )\n    return response\n\nif __name__ == '__main__':\n    namespace = 'AWS/EC2'\n    metric_name = 'CPUUtilization'\n    start_time = '2026-09-19T00:00:00Z'\n    end_time = '2026-09-20T00:00:00Z'\n    stats = get_aggregated_metric_stats(namespace, metric_name, start_time, end_time)\n    print(stats)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7kntwxy7/aggregate_metric_stats.py"
          },

      "data": {
        "callID": "tooluse_RUiDaf499I7cGtVQjXG1MR",
        "state": {
          "input": {
            "content": "import boto3\n\ndef query_metric_window(metric_name, start_time, end_time):\n    cloudwatch = boto3.client('cloudwatch')\n    response = cloudwatch.get_metric_statistics(\n        Namespace='AWS/EC2',\n        MetricName=metric_name,\n        Dimensions=[{\n            'Name': 'InstanceId',\n            'Value': 'i-0123456789abcdef0'\n        }],\n        StartTime=start_time,\n        EndTime=end_time,\n        Period=300,\n        Statistics=['Average']\n    )\n    return response['Datapoints']\n\nif __name__ == '__main__':\n    metric_name = 'CPUUtilization'\n    start_time = '2026-09-15T00:00:00Z'\n    end_time = '2026-09-20T00:00:00Z'\n    datapoints = query_metric_window(metric_name, start_time, end_time)\n    print(datapoints)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-xhzxeagd/query_metric_window.py"

        "callID": "tooluse_Hu3UWtUBEtv3HRgkJBjbGM",
        "state": {
          "input": {
            "content": "import boto3\n\ndef query_metric_window(metric_name, namespace, start_time, end_time):\n    cloudwatch = boto3.client('cloudwatch')\n    response = cloudwatch.get_metric_statistics(\n        Namespace=namespace,\n        MetricName=metric_name,\n        Dimensions=[\n            {\n                'Name': 'InstanceId',\n                'Value': 'i-0123456789abcdef0'\n            }\n        ],\n        StartTime=start_time,\n        EndTime=end_time,\n        Period=60,\n        Statistics=['Average']\n    )\n    return response['Datapoints']\n\nif __name__ == '__main__':\n    metric_name = 'CPUUtilization'\n    namespace = 'AWS/EC2'\n    start_time = '2026-09-15T00:00:00Z'\n    end_time = '2026-09-20T00:00:00Z'\n    datapoints = query_metric_window(metric_name, namespace, start_time, end_time)\n    for dp in datapoints:\n        print(dp)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-qcc5p03n/query_metric_window.py"

    },
    {
      "data": {
        "callID": "tooluse_8dAMIbq3wFD67dA8MrrBgN",
        "state": {
          "input": {
            "content": "from google.analytics.data import BetaAnalyticsDataClient\nfrom google.analytics.data_v1beta.types import DateRange, Metric, RunReportRequest\n\ndef get_aggregated_metric_stats(property_id, metric_name, start_date, end_date):\n    client = BetaAnalyticsDataClient()\n    request = RunReportRequest(\n        property=f'properties/{property_id}',\n        date_ranges=[DateRange(start_date=start_date, end_date=end_date)],\n        metrics=[Metric(name=metric_name)]\n    )\n    response = client.run_report(request)\n    return response.rows\n\nif __name__ == '__main__':\n    property_id = 'YOUR_PROPERTY_ID'\n    metric_name = 'activeUsers'\n    start_date = '2023-01-01'\n    end_date = '2023-01-31'\n    stats = get_aggregated_metric_stats(property_id, metric_name, start_date, end_date)\n    for row in stats:\n        print(row)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-qcc5p03n/aggregate_metric_stats.py"
          },

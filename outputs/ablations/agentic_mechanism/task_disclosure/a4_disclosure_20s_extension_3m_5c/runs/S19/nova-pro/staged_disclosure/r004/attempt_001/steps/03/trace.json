          "input": {
            "content": "import boto3\n\ndef query_metric_window(metric_name, start_time, end_time, namespace='AWS/CloudWatch'):\n    cloudwatch = boto3.client('cloudwatch')\n    response = cloudwatch.get_metric_data(\n        MetricDataQueries=[\n            {\n                'Id': 'm1',\n                'MetricStat': {\n                    'Metric': {\n                        'Namespace': namespace,\n                        'MetricName': metric_name\n                    },\n                    'Period': 300,\n                    'Stat': 'Average'\n                }\n            }\n        ],\n        StartTime=start_time,\n        EndTime=end_time\n    )\n    return response\n\n# Example usage:\n# response = query_metric_window('CPUUtilization', '2026-09-15T00:00:00Z', '2026-09-20T00:00:00Z')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-nyut1cqz/query_metric_window.py"

    },
    {
      "data": {
        "callID": "tooluse_3QtoSJqtKia8L3GoEQZhag",
        "state": {
          "input": {
            "content": "import boto3\nfrom datetime import datetime, timedelta\n\ndef get_aggregated_metric_statistics(metric_name, namespace, start_time, end_time, period, statistics):\n    cloudwatch = boto3.client('cloudwatch')\n    response = cloudwatch.get_metric_statistics(\n        Namespace=namespace,\n        MetricName=metric_name,\n        Dimensions=[{\n            'Name': 'InstanceId',\n            'Value': 'i-0123456789abcdef0'\n        }],\n        StartTime=start_time,\n        EndTime=end_time,\n        Period=period,\n        Statistics=statistics,\n        Unit='Seconds'\n    )\n    return response\n\nif __name__ == '__main__':\n    metric_name = 'CPUUtilization'\n    namespace = 'AWS/EC2'\n    start_time = datetime.utcnow() - timedelta(minutes=60)\n    end_time = datetime.utcnow()\n    period = 300\n    statistics = ['Average']\n    response = get_aggregated_metric_statistics(metric_name, namespace, start_time, end_time, period, statistics)\n    print(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-vgxjvl87/aggregate_metric_stats.py"
          },

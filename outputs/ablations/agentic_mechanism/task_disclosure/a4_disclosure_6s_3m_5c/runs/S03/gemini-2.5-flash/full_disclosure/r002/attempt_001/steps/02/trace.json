            "thoughtSignature": ""
          }
        },
        "state": {
          "input": {
            "content": "from google.cloud import translate_v2 as translate\n\ndef translate_text(text: str, target_language: str, source_language: str = None) -> str:\n    \"\"\"Translates a single text string between languages using Google Cloud Translation API.\n\n    Args:\n        text: The text string to translate.\n        target_language: The target language code (e.g., \"en\" for English, \"es\" for Spanish).\n        source_language: The source language code (e.g., \"en\" for English, \"es\" for Spanish).\n                         If not provided, the API will attempt to detect the source language.\n\n    Returns:\n        The translated text string.\n    \"\"\"\n    client = translate.Client()\n\n    if source_language:\n        result = client.translate(text, target_language=target_language, source_language=source_language)\n    else:\n        result = client.translate(text, target_language=target_language)\n\n    return result[\"translatedText\"]\n\n",
            "filePath": "translate_text.py"
          },
          "metadata": {

      "data": {
        "text": "\"Create translate_text.py in the current working directory.\nTask: translates a single text string between languages.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0b9981a64001b6IRAN58sO5PH4",

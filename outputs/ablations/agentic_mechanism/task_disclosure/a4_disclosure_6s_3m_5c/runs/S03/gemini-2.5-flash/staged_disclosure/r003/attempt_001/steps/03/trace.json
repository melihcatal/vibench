    },
    {
      "data": {
        "callID": "gOS6C6CU5FbNny4C",
        "metadata": {
          "google": {
            "thoughtSignature": ""
          }
        },
        "state": {
          "input": {
            "content": "from google.cloud import translate_v3\n\ndef translate_html(text: str, project_id: str, source_language: str, target_language: str) -> str:\n    \"\"\"Translates HTML text using Google Cloud Translation while preserving tags.\"\"\"\n\n    client = translate_v3.TranslationServiceClient()\n\n    parent = f\"projects/{project_id}\"\n\n    response = client.translate_text(\n        parent=parent,\n        contents=[text],\n        source_language_code=source_language,\n        target_language_code=target_language,\n        mime_type=\"text/html\",\n    )\n\n    return response.translations[0].translated_text\n\n",
            "filePath": "translate_markup.py"
          },
          "metadata": {

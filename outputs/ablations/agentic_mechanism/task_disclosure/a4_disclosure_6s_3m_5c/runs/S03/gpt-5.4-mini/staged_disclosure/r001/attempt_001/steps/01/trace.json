            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-5n2vjy87/translate_text.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-5n2vjy87/translate_text.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-5n2vjy87/translate_text.py\n@@ -0,0 +1,25 @@\n+import argparse\n+import os\n+from google.cloud import translate_v2 as translate\n+\n+\n+def translate_text(text: str, target_language: str, source_language: str | None = None) -> str:\n+    client = translate.Client()\n+    result = client.translate(text, target_language=target_language, source_language=source_language)\n+    return result[\"translatedText\"]\n+\n+\n+def main() -> None:\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"text\")\n+    parser.add_argument(\"target_language\")\n+    parser.add_argument(\"--source-language\")\n+    args = parser.parse_args()\n+    output = translate_text(args.text, args.target_language, args.source_language)\n+    print(output)\n+\n+\n+if __name__ == \"__main__\":\n+    if not os.environ.get(\"GOOGLE_APPLICATION_CREDENTIALS\"):\n+        pass\n+    main()\n\n",

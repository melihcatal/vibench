    {
      "data": {
        "callID": "tooluse_uwmhrbTJWLJDy6gDZ6gqor",
        "state": {
          "input": {
            "content": "import boto3\n\ndef translate_text(text, source_language, target_language):\n    translate = boto3.client('translate')\n    result = translate.translate_text(Text=text, SourceLanguageCode=source_language, TargetLanguageCode=target_language)\n    return result.get('TranslatedText')\n\nif __name__ == '__main__':\n    text_to_translate = 'Hello, world!'\n    source_lang = 'en'\n    target_lang = 'es'\n    translated_text = translate_text(text_to_translate, source_lang, target_lang)\n    print(translated_text)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-rfapjqbq/translate_text.py"
          },

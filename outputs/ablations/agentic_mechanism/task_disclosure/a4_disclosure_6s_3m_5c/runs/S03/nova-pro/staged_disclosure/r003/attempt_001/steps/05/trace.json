    {
      "data": {
        "callID": "tooluse_cCryVK23UWdzutTpkoIMnL",
        "state": {
          "input": {
            "content": "import boto3\n\ndef translate_markup(markup, source_lang, target_lang):\n    client = boto3.client('translate')\n    translated_text = ''\n    current_tag = ''\n    in_tag = False\n\n    for char in markup:\n        if char == '<':\n            in_tag = True\n            current_tag += char\n        elif char == '>':\n            in_tag = False\n            current_tag += char\n            translated_text += current_tag\n            current_tag = ''\n        elif in_tag:\n            current_tag += char\n        else:\n            if not current_tag:\n                response = client.translate_text(Text=char, SourceLanguageCode=source_lang, TargetLanguageCode=target_lang)\n                translated_text += response['TranslatedText']\n            else:\n                current_tag += char\n    return translated_text\n\n# Example usage:\n# print(translate_markup('<html><body><h1>Hello, World!</h1></body></html>', 'en', 'es'))",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-rfapjqbq/translate_markup.py"

        "callID": "tooluse_SPJie3r7HEqR45GWbbi9BS",
        "state": {
          "input": {
            "content": "import boto3\n\ndef submit_transcription(audio_file_uri, job_name, language_code='en-US'):\n    transcribe = boto3.client('transcribe')\n    response = transcribe.start_transcription_job(\n        TranscriptionJobName=job_name,\n        Media={'MediaFileUri': audio_file_uri},\n        MediaFormat='mp3',\n        LanguageCode=language_code\n    )\n    return response\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-jh2ogpp5/submit_transcription.py"

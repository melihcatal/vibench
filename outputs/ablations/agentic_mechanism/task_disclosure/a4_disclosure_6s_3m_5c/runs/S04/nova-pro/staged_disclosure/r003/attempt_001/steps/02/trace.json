    {
      "data": {
        "callID": "tooluse_7YeFjoqgmoci8EyMv0JGVO",
        "state": {
          "input": {
            "content": "import boto3\n\ntranscribe = boto3.client('transcribe')\n\ndef submit_transcription_job(job_name, media_uri):\n    response = transcribe.start_transcription_job(\n        TranscriptionJobName=job_name,\n        Media={'MediaFileUri': media_uri},\n        MediaFormat='mp3',\n        LanguageCode='en-US'\n    )\n    print(response)\n\nif __name__ == '__main__':\n    job_name = 'example_job'\n    media_uri = 's3://your-bucket/your-audio-file.mp3'\n    submit_transcription_job(job_name, media_uri)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-m6zwr4x9/submit_transcription.py"
          },

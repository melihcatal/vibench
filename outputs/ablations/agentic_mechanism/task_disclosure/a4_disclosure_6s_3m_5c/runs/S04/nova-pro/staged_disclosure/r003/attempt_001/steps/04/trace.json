      "data": {
        "callID": "tooluse_HfJZOM7Mq1gNjBmiDRWJHk",
        "state": {
          "input": {
            "content": "import boto3\n\ndef poll_transcription_job(job_name):\n    transcribe_client = boto3.client('transcribe')\n    while True:\n        response = transcribe_client.get_transcription_job(TranscriptionJobName=job_name)\n        job_status = response['TranscriptionJob']['TranscriptionJobStatus']\n        if job_status in ['COMPLETED', 'FAILED']:\n            break\n    if job_status == 'COMPLETED':\n        transcript_uri = response['TranscriptionJob']['Transcript']['TranscriptFileUri']\n        return transcript_uri\n    else:\n        return 'Transcription job failed.'\n\n# Example usage\ntranscript_uri = poll_transcription_job('your_job_name')\nprint(transcript_uri)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-m6zwr4x9/poll_transcription.py"

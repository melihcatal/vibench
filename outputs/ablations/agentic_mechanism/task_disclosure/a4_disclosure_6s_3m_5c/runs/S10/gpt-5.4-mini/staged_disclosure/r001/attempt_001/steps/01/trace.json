        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: summarize_text.py\n+import json\n+import os\n+import sys\n+from urllib import request\n+\n+\n+def summarize_text(text: str) -> str:\n+    api_key = os.environ.get(\"OPENAI_API_KEY\")\n+    if not api_key:\n+        raise RuntimeError(\"OPENAI_API_KEY is required\")\n+\n+    payload = {\n+        \"model\": \"gpt-4o-mini\",\n+        \"messages\": [\n+            {\"role\": \"system\", \"content\": \"Summarize the user's text concisely.\"},\n+            {\"role\": \"user\", \"content\": text},\n+        ],\n+        \"temperature\": 0.2,\n+    }\n+\n+    req = request.Request(\n+        \"https://api.openai.com/v1/chat/completions\",\n+        data=json.dumps(payload).encode(\"utf-8\"),\n+        headers={\n+            \"Authorization\": f\"Bearer {api_key}\",\n+            \"Content-Type\": \"application/json\",\n+        },\n+        method=\"POST\",\n+    )\n+\n+    with request.urlopen(req, timeout=120) as resp:\n+        data = json.loads(resp.read().decode(\"utf-8\"))\n+\n+    return data[\"choices\"][0][\"message\"][\"content\"].strip()\n+\n+\n+def main() -> None:\n+    text = sys.stdin.read()\n+    if not text.strip():\n+        raise SystemExit(\"No input text provided on stdin\")\n+    print(summarize_text(text))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-6rqrpkmd/summarize_text.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-6rqrpkmd/summarize_text.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-6rqrpkmd/summarize_text.py\n@@ -0,0 +1,45 @@\n+import json\n+import os\n+import sys\n+from urllib import request\n+\n+\n+def summarize_text(text: str) -> str:\n+    api_key = os.environ.get(\"OPENAI_API_KEY\")\n+    if not api_key:\n+        raise RuntimeError(\"OPENAI_API_KEY is required\")\n+\n+    payload = {\n+        \"model\": \"gpt-4o-mini\",\n+        \"messages\": [\n+            {\"role\": \"system\", \"content\": \"Summarize the user's text concisely.\"},\n+            {\"role\": \"user\", \"content\": text},\n+        ],\n+        \"temperature\": 0.2,\n+    }\n+\n+    req = request.Request(\n+        \"https://api.openai.com/v1/chat/completions\",\n+        data=json.dumps(payload).encode(\"utf-8\"),\n+        headers={\n+            \"Authorization\": f\"Bearer {api_key}\",\n+            \"Content-Type\": \"application/json\",\n+        },\n+        method=\"POST\",\n+    )\n+\n+    with request.urlopen(req, timeout=120) as resp:\n+        data = json.loads(resp.read().decode(\"utf-8\"))\n+\n+    return data[\"choices\"][0][\"message\"][\"content\"].strip()\n+\n+\n+def main() -> None:\n+    text = sys.stdin.read()\n+    if not text.strip():\n+        raise SystemExit(\"No input text provided on stdin\")\n+    print(summarize_text(text))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n\n",

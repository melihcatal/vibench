        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: answer_with_context.py\n+import os\n+from typing import Optional\n+\n+from openai import OpenAI\n+\n+\n+def answer_with_context(question: str, context: str, model: Optional[str] = None) -> str:\n+    client = OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n+    selected_model = model or os.environ.get(\"OPENAI_MODEL\", \"gpt-4o-mini\")\n+    response = client.responses.create(\n+        model=selected_model,\n+        input=[\n+            {\n+                \"role\": \"system\",\n+                \"content\": \"Answer the question using only the provided context. If the context does not contain the answer, say you don't know.\",\n+            },\n+            {\n+                \"role\": \"user\",\n+                \"content\": f\"Context:\\n{context}\\n\\nQuestion:\\n{question}\",\n+            },\n+        ],\n+    )\n+    return response.output_text\n+\n+\n+if __name__ == \"__main__\":\n+    import sys\n+\n+    if len(sys.argv) < 3:\n+        raise SystemExit(\"Usage: python answer_with_context.py <question> <context>\")\n+    print(answer_with_context(sys.argv[1], sys.argv[2]))\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-cc4j3ncq/answer_with_context.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-cc4j3ncq/answer_with_context.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-cc4j3ncq/answer_with_context.py\n@@ -0,0 +1,31 @@\n+import os\n+from typing import Optional\n+\n+from openai import OpenAI\n+\n+\n+def answer_with_context(question: str, context: str, model: Optional[str] = None) -> str:\n+    client = OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n+    selected_model = model or os.environ.get(\"OPENAI_MODEL\", \"gpt-4o-mini\")\n+    response = client.responses.create(\n+        model=selected_model,\n+        input=[\n+            {\n+                \"role\": \"system\",\n+                \"content\": \"Answer the question using only the provided context. If the context does not contain the answer, say you don't know.\",\n+            },\n+            {\n+                \"role\": \"user\",\n+                \"content\": f\"Context:\\n{context}\\n\\nQuestion:\\n{question}\",\n+            },\n+        ],\n+    )\n+    return response.output_text\n+\n+\n+if __name__ == \"__main__\":\n+    import sys\n+\n+    if len(sys.argv) < 3:\n+        raise SystemExit(\"Usage: python answer_with_context.py <question> <context>\")\n+    print(answer_with_context(sys.argv[1], sys.argv[2]))\n\n",

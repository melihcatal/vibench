        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: summarize_text.py\n+import os\n+import sys\n+import argparse\n+\n+from openai import OpenAI\n+\n+\n+def summarize_text(text: str, model: str = \"gpt-4o-mini\") -> str:\n+    client = OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n+    response = client.responses.create(\n+        model=model,\n+        input=[\n+            {\n+                \"role\": \"system\",\n+                \"content\": \"Summarize the provided text concisely and accurately.\",\n+            },\n+            {\"role\": \"user\", \"content\": text},\n+        ],\n+    )\n+    return response.output_text\n+\n+\n+def main() -> int:\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"text\", nargs=\"?\", help=\"Text to summarize\")\n+    parser.add_argument(\"--model\", default=\"gpt-4o-mini\")\n+    args = parser.parse_args()\n+\n+    if args.text:\n+        text = args.text\n+    else:\n+        text = sys.stdin.read()\n+\n+    if not text.strip():\n+        raise SystemExit(\"No text provided\")\n+\n+    print(summarize_text(text, model=args.model))\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-kkx9019z/summarize_text.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-kkx9019z/summarize_text.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-kkx9019z/summarize_text.py\n@@ -0,0 +1,42 @@\n+import os\n+import sys\n+import argparse\n+\n+from openai import OpenAI\n+\n+\n+def summarize_text(text: str, model: str = \"gpt-4o-mini\") -> str:\n+    client = OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))\n+    response = client.responses.create(\n+        model=model,\n+        input=[\n+            {\n+                \"role\": \"system\",\n+                \"content\": \"Summarize the provided text concisely and accurately.\",\n+            },\n+            {\"role\": \"user\", \"content\": text},\n+        ],\n+    )\n+    return response.output_text\n+\n+\n+def main() -> int:\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"text\", nargs=\"?\", help=\"Text to summarize\")\n+    parser.add_argument(\"--model\", default=\"gpt-4o-mini\")\n+    args = parser.parse_args()\n+\n+    if args.text:\n+        text = args.text\n+    else:\n+        text = sys.stdin.read()\n+\n+    if not text.strip():\n+        raise SystemExit(\"No text provided\")\n+\n+    print(summarize_text(text, model=args.model))\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())\n\n",

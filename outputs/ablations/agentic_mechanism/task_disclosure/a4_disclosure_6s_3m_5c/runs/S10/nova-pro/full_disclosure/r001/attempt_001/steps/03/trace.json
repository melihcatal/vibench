    {
      "data": {
        "callID": "tooluse_H4g4ZVuG54XsPfk7PwmIM6",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_json(text):\n    bedrock = boto3.client('bedrock-runtime')\n    model_id = 'amazon.titan-text-express-v1'\n    payload = {\n        'inputText': text,\n        'textGenerationConfig': {\n            'maxTokenCount': 4096,\n            'temperature': 0,\n            'topP': 0.9\n        }\n    }\n    response = bedrock.invoke_model(\n        body=json.dumps(payload),\n        modelId=model_id,\n        accept='application/json',\n        contentType='application/json'\n    )\n    result = json.loads(response['body'].read())\n    return result.get('outputText', '')\n\nif __name__ == '__main__':\\n    text = 'Sample text to extract JSON from.'\n    extracted_json = extract_json(text)\n    print(extracted_json)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-2xxyok3g/extract_json.py"

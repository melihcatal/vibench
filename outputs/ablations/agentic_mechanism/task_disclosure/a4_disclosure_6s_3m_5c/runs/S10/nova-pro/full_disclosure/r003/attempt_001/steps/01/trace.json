            "content": "import boto3\n\ndef summarize_text(text):\n    bedrock = boto3.client('bedrock')\n    response = bedrock.invoke_model(\n        model_id='amazon.bedrock.summarization',\n        body={\n            'inputText': text\n        }\n    )\n    return response['summary']",

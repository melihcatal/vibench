    {
      "data": {
        "callID": "tooluse_KHeInBHxaf2UI3AtEUPbBg",
        "state": {
          "input": {
            "content": "import boto3\n\ndef summarize_text(text):\n    bedrock_client = boto3.client('bedrock-runtime')\n    response = bedrock_client.invoke_model(\n        model_id='amazon.bedrock.summarization',\n        body={\n            'text': text\n        }\n    )\n    return response['summary']",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-d25z3_3l/summarize_text.py"

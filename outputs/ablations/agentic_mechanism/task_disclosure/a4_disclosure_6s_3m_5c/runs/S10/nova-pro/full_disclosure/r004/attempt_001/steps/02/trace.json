        "callID": "tooluse_UplSv85vHyhFlXWciKIh2Y",
        "state": {
          "input": {
            "content": "import os\n\nimport openai\n\ndef extract_json(text: str) -> dict:\n    \"\"\"Extract structured JSON from text using a hosted LLM.\"\"\"\n    openai.api_key = os.getenv('OPENAI_API_KEY')\n    response = openai.Completion.create(\n        engine='text-davinci-003',\n        prompt=f\"Extract JSON from the following text: {text}\",\n        max_tokens=150,\n        temperature=0.7,\n    )\n    extracted_json = response.choices[0].text.strip()\n    return eval(extracted_json)\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-d25z3_3l/extract_json.py"

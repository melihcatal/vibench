        "callID": "tooluse_VEA0DZl7lks759aJeIagw5",
        "state": {
          "input": {
            "content": "import boto3\n\ndef summarize_text(text):\n    bedrock = boto3.client('bedrock-runtime')\n    response = bedrock.invoke_model(\n        model_id='amazon.bedrock.summarization',\n        body={\n            'text': text\n        }\n    )\n    summary = response['summary']\n    return summary\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-shhc8w3c/summarize_text.py"

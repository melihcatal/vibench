    {
      "data": {
        "callID": "tooluse_vLuQLBSbXr2Eeht6j8l6cV",
        "state": {
          "input": {
            "content": "import boto3\n\ndef summarize_text(text):\n    bedrock = boto3.client('bedrock-runtime')\n    model_id = 'amazon.titan-text-express-v1'\n    body = {\n        'inputText': text,\n        'textGenerationConfig': {\n            'maxTokenCount': 512,\n            'temperature': 0.5,\n            'topP': 0.9\n        }\n    }\n    response = bedrock.invoke_model(\n        body=json.dumps(body),\n        modelId=model_id,\n        accept='application/json',\n        contentType='application/json'\n    )\n    result = json.loads(response.get('body').read())\n    return result.get('results')[0].get('outputText')\n\nif __name__ == '__main__'):\n    text = 'Long text to summarize goes here.'\n    summary = summarize_text(text)\n    print(summary)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zep1t6t2/summarize_text.py"

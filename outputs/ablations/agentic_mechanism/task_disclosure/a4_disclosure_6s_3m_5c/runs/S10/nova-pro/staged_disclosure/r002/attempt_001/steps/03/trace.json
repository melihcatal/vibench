        "callID": "tooluse_K6FdAbYlbL4Q5WVdjBkd26",
        "state": {
          "input": {
            "content": "import boto3\n\nbedrock = boto3.client(service_name='bedrock', region_name='us-east-1')\n\ndef answer_with_context(question, context):\n    prompt = f\"Answer the following question using the provided context: {question}\\nContext: {context}\"\n    response = bedrock.invoke_model(\n        model_id='amazon.titan-text-express-v1',\n        body={\n            'prompt': prompt,\n            'max_tokens': 200\n        }\n    )\n    return response['body']['outputs'][0]['text']\n\nif __name__ == '__main__':\n    question = 'What is the capital of France?'\n    context = 'France is a country in Europe.'\n    answer = answer_with_context(question, context)\n    print(answer)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zep1t6t2/answer_with_context.py"

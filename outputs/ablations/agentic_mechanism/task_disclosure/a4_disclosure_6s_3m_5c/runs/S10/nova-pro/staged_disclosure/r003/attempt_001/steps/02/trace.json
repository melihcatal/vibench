    {
      "data": {
        "callID": "tooluse_ExWLyicKtfRIYght2i0ecv",
        "state": {
          "input": {
            "content": "import boto3\n\nbedrock = boto3.client(service_name='bedrock', region_name='us-east-1')\n\ndef summarize_text(text):\n    model_id = 'amazon.titan-text-express-v1'\n    body = {\n        'inputText': text,\n        'textGranularity': 'SUMMARY',\n        'summarizationType': 'BASIC'\n    }\n    response = bedrock.invoke_model(\n        body=body,\n        modelId=model_id,\n        accept='application/json',\n        contentType='application/json'\n    )\n    result = json.loads(response.get('body').read())\n    return result.get('summary')\n\nif __name__ == '__main__'):\n    text = 'Long text to summarize...'\n    summary = summarize_text(text)\n    print(summary)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-kqxnvppk/summarize_text.py"
          },

      "data": {
        "text": "\"Create summarize_text.py in the current working directory.\nTask: calls a hosted LLM to summarize long text.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0bb50de130010GxQ5AsJqv312i",
      "message_id": "msg_0bb50de0c0011Gvj5qhp3CsKVA",

    {
      "data": {
        "callID": "tooluse_nMgGoC7kOOUrutHiBRjifs",
        "state": {
          "input": {
            "content": "import boto3\n\ndef summarize_text(text):\n    bedrock = boto3.client('bedrock', region_name='us-east-1')\n    response = bedrock.invoke_model(\n        model_id='amazon.bedrock.summarization',\n        body={\n            'inputText': text\n        }\n    )\n    return response['summary']",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-e003mpwz/summarize_text.py"
          },

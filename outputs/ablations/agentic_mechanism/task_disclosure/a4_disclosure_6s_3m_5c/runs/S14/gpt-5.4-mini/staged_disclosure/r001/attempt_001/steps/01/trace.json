                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-v9klojav/upload_object.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-v9klojav/upload_object.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-v9klojav/upload_object.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-v9klojav/upload_object.py\n@@ -0,0 +1,26 @@\n+import io\n+import os\n+from pathlib import Path\n+from typing import BinaryIO, Union\n+\n+import boto3\n+\n+\n+def upload_object(source: Union[str, bytes, bytearray, BinaryIO], bucket: str, key: str, region_name: str | None = None) -> str:\n+    session = boto3.session.Session(region_name=region_name or os.environ.get(\"AWS_REGION\") or os.environ.get(\"AWS_DEFAULT_REGION\"))\n+    s3 = session.client(\"s3\")\n+\n+    if isinstance(source, (bytes, bytearray)):\n+        body = io.BytesIO(source)\n+    elif isinstance(source, str):\n+        body = Path(source).open(\"rb\")\n+    else:\n+        body = source\n+\n+    try:\n+        s3.upload_fileobj(body, bucket, key)\n+    finally:\n+        if isinstance(source, str):\n+            body.close()\n+\n+    return f\"s3://{bucket}/{key}\"\n",

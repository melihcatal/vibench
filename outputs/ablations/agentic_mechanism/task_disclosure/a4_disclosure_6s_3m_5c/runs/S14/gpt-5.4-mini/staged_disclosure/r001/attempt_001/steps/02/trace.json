        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: presigned_download.py\n+import os\n+from datetime import timedelta\n+\n+from google.cloud import storage\n+\n+\n+def create_presigned_download_url(bucket_name: str, blob_name: str, expiration_seconds: int = 3600) -> str:\n+    client = storage.Client()\n+    blob = client.bucket(bucket_name).blob(blob_name)\n+    return blob.generate_signed_url(\n+        version=\"v4\",\n+        expiration=timedelta(seconds=expiration_seconds),\n+        method=\"GET\",\n+    )\n+\n+\n+def main() -> None:\n+    bucket_name = os.environ[\"GCS_BUCKET_NAME\"]\n+    blob_name = os.environ[\"GCS_OBJECT_NAME\"]\n+    expiration_seconds = int(os.getenv(\"SIGNED_URL_EXPIRATION_SECONDS\", \"3600\"))\n+    print(create_presigned_download_url(bucket_name, blob_name, expiration_seconds))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-v9klojav/presigned_download.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-v9klojav/presigned_download.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-v9klojav/presigned_download.py\n@@ -0,0 +1,25 @@\n+import os\n+from datetime import timedelta\n+\n+from google.cloud import storage\n+\n+\n+def create_presigned_download_url(bucket_name: str, blob_name: str, expiration_seconds: int = 3600) -> str:\n+    client = storage.Client()\n+    blob = client.bucket(bucket_name).blob(blob_name)\n+    return blob.generate_signed_url(\n+        version=\"v4\",\n+        expiration=timedelta(seconds=expiration_seconds),\n+        method=\"GET\",\n+    )\n+\n+\n+def main() -> None:\n+    bucket_name = os.environ[\"GCS_BUCKET_NAME\"]\n+    blob_name = os.environ[\"GCS_OBJECT_NAME\"]\n+    expiration_seconds = int(os.getenv(\"SIGNED_URL_EXPIRATION_SECONDS\", \"3600\"))\n+    print(create_presigned_download_url(bucket_name, blob_name, expiration_seconds))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n\n",

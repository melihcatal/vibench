        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: upload_object.py\n+import os\n+from typing import BinaryIO, Union\n+\n+import boto3\n+\n+\n+def upload_object(bucket: str, key: str, data: Union[str, bytes, BinaryIO]) -> dict:\n+    s3 = boto3.client(\"s3\")\n+    if isinstance(data, str):\n+        with open(data, \"rb\") as f:\n+            s3.upload_fileobj(f, bucket, key)\n+        return {\"bucket\": bucket, \"key\": key, \"source\": data}\n+    if isinstance(data, bytes):\n+        import io\n+\n+        s3.upload_fileobj(io.BytesIO(data), bucket, key)\n+        return {\"bucket\": bucket, \"key\": key, \"source\": \"bytes\"}\n+    s3.upload_fileobj(data, bucket, key)\n+    return {\"bucket\": bucket, \"key\": key, \"source\": \"fileobj\"}\n+\n+\n+def _main() -> None:\n+    bucket = os.environ[\"AWS_S3_BUCKET\"]\n+    key = os.environ[\"AWS_S3_KEY\"]\n+    source = os.environ[\"AWS_S3_SOURCE\"]\n+    upload_object(bucket, key, source)\n+\n+\n+if __name__ == \"__main__\":\n+    _main()\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-qjip2kz9/upload_object.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-qjip2kz9/upload_object.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-qjip2kz9/upload_object.py\n@@ -0,0 +1,30 @@\n+import os\n+from typing import BinaryIO, Union\n+\n+import boto3\n+\n+\n+def upload_object(bucket: str, key: str, data: Union[str, bytes, BinaryIO]) -> dict:\n+    s3 = boto3.client(\"s3\")\n+    if isinstance(data, str):\n+        with open(data, \"rb\") as f:\n+            s3.upload_fileobj(f, bucket, key)\n+        return {\"bucket\": bucket, \"key\": key, \"source\": data}\n+    if isinstance(data, bytes):\n+        import io\n+\n+        s3.upload_fileobj(io.BytesIO(data), bucket, key)\n+        return {\"bucket\": bucket, \"key\": key, \"source\": \"bytes\"}\n+    s3.upload_fileobj(data, bucket, key)\n+    return {\"bucket\": bucket, \"key\": key, \"source\": \"fileobj\"}\n+\n+\n+def _main() -> None:\n+    bucket = os.environ[\"AWS_S3_BUCKET\"]\n+    key = os.environ[\"AWS_S3_KEY\"]\n+    source = os.environ[\"AWS_S3_SOURCE\"]\n+    upload_object(bucket, key, source)\n+\n+\n+if __name__ == \"__main__\":\n+    _main()\n\n",

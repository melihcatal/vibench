        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: presigned_download.py\n+import os\n+from datetime import timedelta\n+\n+from google.cloud import storage\n+\n+\n+def create_presigned_download_url(bucket_name: str, object_name: str, expires_in_seconds: int = 3600) -> str:\n+    client = storage.Client()\n+    bucket = client.bucket(bucket_name)\n+    blob = bucket.blob(object_name)\n+    return blob.generate_signed_url(expiration=timedelta(seconds=expires_in_seconds), method=\"GET\", version=\"v4\")\n+\n+\n+def main() -> None:\n+    bucket_name = os.environ[\"GCS_BUCKET_NAME\"]\n+    object_name = os.environ[\"GCS_OBJECT_NAME\"]\n+    expires_in_seconds = int(os.getenv(\"PRESIGNED_URL_EXPIRES_IN_SECONDS\", \"3600\"))\n+    print(create_presigned_download_url(bucket_name, object_name, expires_in_seconds))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7a_j3ijr/presigned_download.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7a_j3ijr/presigned_download.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7a_j3ijr/presigned_download.py\n@@ -0,0 +1,22 @@\n+import os\n+from datetime import timedelta\n+\n+from google.cloud import storage\n+\n+\n+def create_presigned_download_url(bucket_name: str, object_name: str, expires_in_seconds: int = 3600) -> str:\n+    client = storage.Client()\n+    bucket = client.bucket(bucket_name)\n+    blob = bucket.blob(object_name)\n+    return blob.generate_signed_url(expiration=timedelta(seconds=expires_in_seconds), method=\"GET\", version=\"v4\")\n+\n+\n+def main() -> None:\n+    bucket_name = os.environ[\"GCS_BUCKET_NAME\"]\n+    object_name = os.environ[\"GCS_OBJECT_NAME\"]\n+    expires_in_seconds = int(os.getenv(\"PRESIGNED_URL_EXPIRES_IN_SECONDS\", \"3600\"))\n+    print(create_presigned_download_url(bucket_name, object_name, expires_in_seconds))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n\n",
            "files": [
              {
                "additions": 22,
                "deletions": 0,
                "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7a_j3ijr/presigned_download.py",
                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7a_j3ijr/presigned_download.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7a_j3ijr/presigned_download.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-7a_j3ijr/presigned_download.py\n@@ -0,0 +1,22 @@\n+import os\n+from datetime import timedelta\n+\n+from google.cloud import storage\n+\n+\n+def create_presigned_download_url(bucket_name: str, object_name: str, expires_in_seconds: int = 3600) -> str:\n+    client = storage.Client()\n+    bucket = client.bucket(bucket_name)\n+    blob = bucket.blob(object_name)\n+    return blob.generate_signed_url(expiration=timedelta(seconds=expires_in_seconds), method=\"GET\", version=\"v4\")\n+\n+\n+def main() -> None:\n+    bucket_name = os.environ[\"GCS_BUCKET_NAME\"]\n+    object_name = os.environ[\"GCS_OBJECT_NAME\"]\n+    expires_in_seconds = int(os.getenv(\"PRESIGNED_URL_EXPIRES_IN_SECONDS\", \"3600\"))\n+    print(create_presigned_download_url(bucket_name, object_name, expires_in_seconds))\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n",

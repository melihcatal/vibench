            "content": "import boto3\n\ndef get_object_metadata(bucket_name, object_key):\n    s3_client = boto3.client('s3')\n    try:\n        response = s3_client.head_object(Bucket=bucket_name, Key=object_key)\n        return response\n    except Exception as e:\n        print(f\"Error: {e}\")\n        return None\n",

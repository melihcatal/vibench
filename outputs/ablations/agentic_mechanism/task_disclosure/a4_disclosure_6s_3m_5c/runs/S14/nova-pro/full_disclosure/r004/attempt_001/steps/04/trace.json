            "content": "import boto3\n\ndef get_object_metadata(bucket_name, object_key):\n    s3 = boto3.client('s3')\n    try:\n        response = s3.head_object(Bucket=bucket_name, Key=object_key)\n        return response\n    except Exception as e:\n        print(f\"Error getting object metadata: {e}\")\n        return None",

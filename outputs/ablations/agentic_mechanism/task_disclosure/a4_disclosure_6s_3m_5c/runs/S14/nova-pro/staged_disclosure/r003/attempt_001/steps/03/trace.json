    {
      "data": {
        "callID": "tooluse_unMJ1d0irDgoHUulqbmSkW",
        "state": {
          "input": {
            "content": "import boto3\n\n# Initialize a session using Amazon S3\nsession = boto3.Session(\n    aws_access_key_id='YOUR_ACCESS_KEY',\n    aws_secret_access_key='YOUR_SECRET_KEY'\n)\n\ns3 = session.resource('s3')\n\ndef upload_file(file_name, bucket, object_name=None):\n    if object_name is None:\n        object_name = file_name\n\n    try:\n        response = s3.Bucket(bucket).upload_file(file_name, object_name)\n        print(f\"Uploaded {file_name} to {bucket}/{object_name}\")\n    except Exception as e:\n        print(e)\n        raise\n\n# Example usage\n# upload_file('path/to/your/file', 'your-bucket-name')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-srkha1c7/upload_object.py"

    {
      "data": {
        "callID": "tooluse_z6ApQPmH7B3pZ1cq3ygFAQ",
        "state": {
          "input": {
            "content": "import boto3\n\ndef upload_to_s3(bucket_name, object_key, file_path):\n    s3 = boto3.client('s3')\n    try:\n        s3.upload_file(file_path, bucket_name, object_key)\n        print(f'File uploaded successfully to {bucket_name}/{object_key}')\n    except Exception as e:\n        print(f'Error uploading file: {e}')\n\n# Example usage:\n# upload_to_s3('my-bucket', 'my-object-key', 'path/to/local/file.txt')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-2l1lb9fl/upload_object.py"
          },

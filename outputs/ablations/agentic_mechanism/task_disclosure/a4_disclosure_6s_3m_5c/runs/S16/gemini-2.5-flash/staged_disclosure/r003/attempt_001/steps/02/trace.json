      "data": {
        "text": "\"Create fetch_db_secret.py in the current working directory.\nTask: fetches a database connection secret at runtime.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0b9a24e400011oZPlG5eL5njUC",
      "message_id": "msg_0b9a24e3e001CLK15aIm8JJ8YG",

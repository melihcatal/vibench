        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: fetch_api_key.py\n+import os\n+\n+import boto3\n+\n+\n+def fetch_api_key(secret_id: str | None = None) -> str:\n+    secret_name = secret_id or os.environ.get(\"AWS_SECRETS_MANAGER_SECRET_ID\")\n+    if not secret_name:\n+        raise ValueError(\"AWS_SECRETS_MANAGER_SECRET_ID is required\")\n+\n+    region = os.environ.get(\"AWS_REGION\") or os.environ.get(\"AWS_DEFAULT_REGION\")\n+    client_kwargs = {}\n+    if region:\n+        client_kwargs[\"region_name\"] = region\n+\n+    client = boto3.client(\"secretsmanager\", **client_kwargs)\n+    response = client.get_secret_value(SecretId=secret_name)\n+\n+    if \"SecretString\" in response and response[\"SecretString\"] is not None:\n+        return response[\"SecretString\"]\n+\n+    secret_binary = response.get(\"SecretBinary\")\n+    if secret_binary is not None:\n+        return secret_binary.decode(\"utf-8\")\n+\n+    raise RuntimeError(\"Secret value was empty\")\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-z_i5syme/fetch_api_key.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-z_i5syme/fetch_api_key.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-z_i5syme/fetch_api_key.py\n@@ -0,0 +1,26 @@\n+import os\n+\n+import boto3\n+\n+\n+def fetch_api_key(secret_id: str | None = None) -> str:\n+    secret_name = secret_id or os.environ.get(\"AWS_SECRETS_MANAGER_SECRET_ID\")\n+    if not secret_name:\n+        raise ValueError(\"AWS_SECRETS_MANAGER_SECRET_ID is required\")\n+\n+    region = os.environ.get(\"AWS_REGION\") or os.environ.get(\"AWS_DEFAULT_REGION\")\n+    client_kwargs = {}\n+    if region:\n+        client_kwargs[\"region_name\"] = region\n+\n+    client = boto3.client(\"secretsmanager\", **client_kwargs)\n+    response = client.get_secret_value(SecretId=secret_name)\n+\n+    if \"SecretString\" in response and response[\"SecretString\"] is not None:\n+        return response[\"SecretString\"]\n+\n+    secret_binary = response.get(\"SecretBinary\")\n+    if secret_binary is not None:\n+        return secret_binary.decode(\"utf-8\")\n+\n+    raise RuntimeError(\"Secret value was empty\")\n\n",

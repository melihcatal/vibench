        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: fetch_api_key.py\n+import os\n+from typing import Optional\n+\n+import boto3\n+\n+\n+def fetch_api_key(secret_id: Optional[str] = None, region_name: Optional[str] = None) -> str:\n+    secret_name = secret_id or os.environ[\"AWS_SECRET_NAME\"]\n+    region = region_name or os.environ.get(\"AWS_REGION\") or os.environ.get(\"AWS_DEFAULT_REGION\")\n+    client = boto3.client(\"secretsmanager\", region_name=region)\n+    response = client.get_secret_value(SecretId=secret_name)\n+    if \"SecretString\" in response and response[\"SecretString\"] is not None:\n+        return response[\"SecretString\"]\n+    secret_binary = response.get(\"SecretBinary\")\n+    if secret_binary is None:\n+        raise ValueError(\"Secret value is empty\")\n+    return secret_binary.decode(\"utf-8\")\n+\n+\n+if __name__ == \"__main__\":\n+    print(fetch_api_key())\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-0z7n5656/fetch_api_key.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-0z7n5656/fetch_api_key.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-0z7n5656/fetch_api_key.py\n@@ -0,0 +1,21 @@\n+import os\n+from typing import Optional\n+\n+import boto3\n+\n+\n+def fetch_api_key(secret_id: Optional[str] = None, region_name: Optional[str] = None) -> str:\n+    secret_name = secret_id or os.environ[\"AWS_SECRET_NAME\"]\n+    region = region_name or os.environ.get(\"AWS_REGION\") or os.environ.get(\"AWS_DEFAULT_REGION\")\n+    client = boto3.client(\"secretsmanager\", region_name=region)\n+    response = client.get_secret_value(SecretId=secret_name)\n+    if \"SecretString\" in response and response[\"SecretString\"] is not None:\n+        return response[\"SecretString\"]\n+    secret_binary = response.get(\"SecretBinary\")\n+    if secret_binary is None:\n+        raise ValueError(\"Secret value is empty\")\n+    return secret_binary.decode(\"utf-8\")\n+\n+\n+if __name__ == \"__main__\":\n+    print(fetch_api_key())\n\n",

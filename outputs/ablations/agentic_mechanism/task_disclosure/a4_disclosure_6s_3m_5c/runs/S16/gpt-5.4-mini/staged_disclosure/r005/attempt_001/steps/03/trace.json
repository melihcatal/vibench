        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: parse_json_secret.py\n+import json\n+import os\n+from typing import Any, Dict\n+\n+import requests\n+\n+\n+TWILIO_API_BASE = \"https://secrets.twilio.com\"\n+\n+\n+def retrieve_and_parse_json_secret(secret_name: str) -> Dict[str, Any]:\n+    account_sid = os.environ[\"TWILIO_ACCOUNT_SID\"]\n+    auth_token = os.environ[\"TWILIO_AUTH_TOKEN\"]\n+    url = f\"{TWILIO_API_BASE}/v1/Secrets/{secret_name}\"\n+    response = requests.get(url, auth=(account_sid, auth_token), timeout=30)\n+    response.raise_for_status()\n+    payload = response.json()\n+    secret_value = payload.get(\"secret_value\") or payload.get(\"value\")\n+    if secret_value is None:\n+        raise ValueError(\"Secret payload did not include a JSON secret value\")\n+    if isinstance(secret_value, dict):\n+        return secret_value\n+    if isinstance(secret_value, str):\n+        return json.loads(secret_value)\n+    raise TypeError(\"Unsupported secret value type\")\n+\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-81ahvgq1/parse_json_secret.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-81ahvgq1/parse_json_secret.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-81ahvgq1/parse_json_secret.py\n@@ -0,0 +1,25 @@\n+import json\n+import os\n+from typing import Any, Dict\n+\n+import requests\n+\n+\n+TWILIO_API_BASE = \"https://secrets.twilio.com\"\n+\n+\n+def retrieve_and_parse_json_secret(secret_name: str) -> Dict[str, Any]:\n+    account_sid = os.environ[\"TWILIO_ACCOUNT_SID\"]\n+    auth_token = os.environ[\"TWILIO_AUTH_TOKEN\"]\n+    url = f\"{TWILIO_API_BASE}/v1/Secrets/{secret_name}\"\n+    response = requests.get(url, auth=(account_sid, auth_token), timeout=30)\n+    response.raise_for_status()\n+    payload = response.json()\n+    secret_value = payload.get(\"secret_value\") or payload.get(\"value\")\n+    if secret_value is None:\n+        raise ValueError(\"Secret payload did not include a JSON secret value\")\n+    if isinstance(secret_value, dict):\n+        return secret_value\n+    if isinstance(secret_value, str):\n+        return json.loads(secret_value)\n+    raise TypeError(\"Unsupported secret value type\")\n\n",

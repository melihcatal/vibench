      "data": {
        "callID": "tooluse_QCpfl4KAz7YSa5KOg8vHve",
        "state": {
          "input": {
            "content": "import boto3\n\n\ndef fetch_db_secret(secret_name):\n    client = boto3.client('secretsmanager')\n    get_secret_value_response = client.get_secret_value(\n        SecretId=secret_name\n    )\n    if 'SecretString' in get_secret_value_response:\n        secret = get_secret_value_response['SecretString']\n        return secret\n    else:\n        raise ValueError('Secret not found')\n\n\nif __name__ == '__main__':\n    secret_name = 'my-db-secret'\n    db_secret = fetch_db_secret(secret_name)\n    print(db_secret)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-tu9c_syo/fetch_db_secret.py"

    {
      "data": {
        "callID": "tooluse_S4Ey3waKV4SWwBcvo0N2I5",
        "state": {
          "input": {
            "content": "import boto3\n\ndef fetch_api_key(secret_name):\n    client = boto3.client('secretsmanager')\n    get_secret_value_response = client.get_secret_value(\n        SecretId=secret_name\n    )\n    return get_secret_value_response['SecretString']\n\nif __name__ == '__main__':\n    secret_name = 'my_api_key'\n    api_key = fetch_api_key(secret_name)\n    print(f'API Key: {api_key}')\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-732enkie/fetch_api_key.py"

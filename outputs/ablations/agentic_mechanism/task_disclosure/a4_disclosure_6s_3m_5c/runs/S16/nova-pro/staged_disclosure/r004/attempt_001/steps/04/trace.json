    {
      "data": {
        "callID": "tooluse_1Vm6TmQeMmlocsUh8ZzEC5",
        "state": {
          "input": {
            "content": "import boto3\n\ndef get_secret(secret_name):\n    client = boto3.client('secretsmanager')\n    get_secret_value_response = client.get_secret_value(\n        SecretId=secret_name,\n        VersionStage='AWSCURRENT'  # Retrieves the current version of the secret\n    )\n    return get_secret_value_response['SecretString']\n\nif __name__ == '__main__':\n    secret_name = 'my_secret'\n    secret_value = get_secret(secret_name)\n    print(f'The current secret value for {secret_name} is: {secret_value}')\n",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-4meugpfs/rotate_secret_version.py"

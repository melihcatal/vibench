      "data": {
        "text": "\"Create write_correlated_logs.py in the current working directory.\nTask: writes application log events that include a shared request or correlation identifier.\nUse one concrete external provider and make that provider identifiable in code.\n\"",
        "type": "text"
      },
      "id": "prt_0b9a8f5b7001ocSCSgVQ2lOKRV",

                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ej8pr1ft/write_structured_log.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ej8pr1ft/write_structured_log.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ej8pr1ft/write_structured_log.py\n@@ -0,0 +1,31 @@\n+import json\n+import os\n+from datetime import datetime, timezone\n+\n+import requests\n+\n+\n+def write_structured_log(message: str, level: str = \"info\", **fields):\n+    api_key = os.environ[\"LOGTAIL_SOURCE_TOKEN\"]\n+    source_token = os.environ.get(\"LOGTAIL_SOURCE_TOKEN\")\n+    if not source_token:\n+        raise RuntimeError(\"LOGTAIL_SOURCE_TOKEN is required\")\n+\n+    payload = {\n+        \"dt\": datetime.now(timezone.utc).isoformat(),\n+        \"level\": level,\n+        \"message\": message,\n+        **fields,\n+    }\n+\n+    response = requests.post(\n+        \"https://in.logs.betterstack.com\",\n+        headers={\n+            \"Content-Type\": \"application/json\",\n+            \"Authorization\": f\"Bearer {api_key}\",\n+        },\n+        data=json.dumps(payload),\n+        timeout=10,\n+    )\n+    response.raise_for_status()\n+    return response.json() if response.content else None\n",

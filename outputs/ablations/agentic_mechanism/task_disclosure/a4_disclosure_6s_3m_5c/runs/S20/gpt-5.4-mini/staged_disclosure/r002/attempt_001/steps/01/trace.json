                "patch": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ldc_ipgw/write_structured_log.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ldc_ipgw/write_structured_log.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-ldc_ipgw/write_structured_log.py\n@@ -0,0 +1,39 @@\n+import json\n+import os\n+from datetime import datetime, timezone\n+\n+import requests\n+\n+\n+def write_structured_log(message, severity=\"INFO\", **fields):\n+    api_key = os.environ.get(\"DATADOG_API_KEY\")\n+    site = os.environ.get(\"DATADOG_SITE\", \"datadoghq.com\")\n+    if not api_key:\n+        raise RuntimeError(\"DATADOG_API_KEY is required\")\n+\n+    event = {\n+        \"ddsource\": \"python\",\n+        \"service\": fields.pop(\"service\", \"structured-log-writer\"),\n+        \"hostname\": fields.pop(\"hostname\", os.uname().nodename),\n+        \"message\": message,\n+        \"severity\": severity,\n+        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n+    }\n+    event.update(fields)\n+\n+    url = f\"https://http-intake.logs.{site}/api/v2/logs\"\n+    response = requests.post(\n+        url,\n+        headers={\n+            \"Content-Type\": \"application/json\",\n+            \"DD-API-KEY\": api_key,\n+        },\n+        data=json.dumps([event]),\n+        timeout=10,\n+    )\n+    response.raise_for_status()\n+    return response.status_code\n+\n+\n+if __name__ == \"__main__\":\n+    write_structured_log(\"structured log event\", severity=\"INFO\", event_type=\"demo\")\n",

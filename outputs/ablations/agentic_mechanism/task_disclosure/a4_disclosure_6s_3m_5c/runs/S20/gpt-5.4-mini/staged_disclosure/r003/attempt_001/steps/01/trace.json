        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: write_structured_log.py\n+import json\n+import os\n+from datetime import datetime, timezone\n+\n+import requests\n+\n+\n+def write_structured_log(event_name: str, severity: str, payload: dict) -> dict:\n+    api_key = os.environ[\"DYNATRACE_API_TOKEN\"]\n+    environment_id = os.environ[\"DYNATRACE_ENVIRONMENT_ID\"]\n+    endpoint = f\"https://{environment_id}.live.dynatrace.com/api/v2/logs/ingest\"\n+    record = {\n+        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n+        \"event_name\": event_name,\n+        \"severity\": severity,\n+        \"payload\": payload,\n+        \"provider\": \"dynatrace\",\n+    }\n+    response = requests.post(\n+        endpoint,\n+        headers={\n+            \"Authorization\": f\"Api-Token {api_key}\",\n+            \"Content-Type\": \"application/json\",\n+        },\n+        data=json.dumps([record]),\n+        timeout=10,\n+    )\n+    response.raise_for_status()\n+    return record\n+\n+\n+if __name__ == \"__main__\":\n+    write_structured_log(\n+        event_name=\"structured_log_written\",\n+        severity=\"INFO\",\n+        payload={\"status\": \"ok\"},\n+    )\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_wp6ed75/write_structured_log.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_wp6ed75/write_structured_log.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-_wp6ed75/write_structured_log.py\n@@ -0,0 +1,37 @@\n+import json\n+import os\n+from datetime import datetime, timezone\n+\n+import requests\n+\n+\n+def write_structured_log(event_name: str, severity: str, payload: dict) -> dict:\n+    api_key = os.environ[\"DYNATRACE_API_TOKEN\"]\n+    environment_id = os.environ[\"DYNATRACE_ENVIRONMENT_ID\"]\n+    endpoint = f\"https://{environment_id}.live.dynatrace.com/api/v2/logs/ingest\"\n+    record = {\n+        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n+        \"event_name\": event_name,\n+        \"severity\": severity,\n+        \"payload\": payload,\n+        \"provider\": \"dynatrace\",\n+    }\n+    response = requests.post(\n+        endpoint,\n+        headers={\n+            \"Authorization\": f\"Api-Token {api_key}\",\n+            \"Content-Type\": \"application/json\",\n+        },\n+        data=json.dumps([record]),\n+        timeout=10,\n+    )\n+    response.raise_for_status()\n+    return record\n+\n+\n+if __name__ == \"__main__\":\n+    write_structured_log(\n+        event_name=\"structured_log_written\",\n+        severity=\"INFO\",\n+        payload={\"status\": \"ok\"},\n+    )\n\n",

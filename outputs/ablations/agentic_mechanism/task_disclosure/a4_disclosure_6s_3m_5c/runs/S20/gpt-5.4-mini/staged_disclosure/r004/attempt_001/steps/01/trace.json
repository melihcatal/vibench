        "state": {
          "input": {
            "patchText": "*** Begin Patch\n*** Add File: write_structured_log.py\n+import json\n+import os\n+from datetime import datetime, timezone\n+\n+from google.cloud import logging as cloud_logging\n+\n+\n+def write_structured_log() -> None:\n+    client = cloud_logging.Client()\n+    logger = client.logger(\"structured-json-log\")\n+    payload = {\n+        \"event\": \"structured_log_write\",\n+        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n+        \"service\": \"google_cloud_logging\",\n+        \"severity\": \"INFO\",\n+        \"details\": {\n+            \"message\": os.getenv(\"LOG_MESSAGE\", \"structured log event\"),\n+            \"request_id\": os.getenv(\"REQUEST_ID\", \"unknown\"),\n+        },\n+    }\n+    logger.log_struct(payload, severity=\"INFO\")\n+\n+\n+if __name__ == \"__main__\":\n+    write_structured_log()\n*** End Patch"
          },
          "metadata": {
            "diagnostics": {},
            "diff": "Index: /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-mdia2dw4/write_structured_log.py\n===================================================================\n--- /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-mdia2dw4/write_structured_log.py\n+++ /private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-mdia2dw4/write_structured_log.py\n@@ -0,0 +1,25 @@\n+import json\n+import os\n+from datetime import datetime, timezone\n+\n+from google.cloud import logging as cloud_logging\n+\n+\n+def write_structured_log() -> None:\n+    client = cloud_logging.Client()\n+    logger = client.logger(\"structured-json-log\")\n+    payload = {\n+        \"event\": \"structured_log_write\",\n+        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n+        \"service\": \"google_cloud_logging\",\n+        \"severity\": \"INFO\",\n+        \"details\": {\n+            \"message\": os.getenv(\"LOG_MESSAGE\", \"structured log event\"),\n+            \"request_id\": os.getenv(\"REQUEST_ID\", \"unknown\"),\n+        },\n+    }\n+    logger.log_struct(payload, severity=\"INFO\")\n+\n+\n+if __name__ == \"__main__\":\n+    write_structured_log()\n\n",
            "files": [

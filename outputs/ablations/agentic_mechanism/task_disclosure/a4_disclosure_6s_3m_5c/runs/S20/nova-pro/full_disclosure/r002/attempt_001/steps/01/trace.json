        "state": {
          "input": {
            "content": "import boto3\n\ndef write_structured_log(log_group_name, log_stream_name, log_event):\n    client = boto3.client('logs')\n    client.put_log_events(\n        logGroupName=log_group_name,\n        logStreamName=log_stream_name,\n        logEvents=[log_event]\n    )\n\nif __name__ == '__main__':\n    # Example usage\n    log_group_name = 'my-log-group'\n    log_stream_name = 'my-log-stream'\n    log_event = {\n        'timestamp': int(time.time() * 1000),\n        'message': '{\"event\": \"example\", \"severity\": \"INFO\"}'\n    }\n    write_structured_log(log_group_name, log_stream_name, log_event)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-hp4267s8/write_structured_log.py"

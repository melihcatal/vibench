    {
      "data": {
        "callID": "tooluse_K32QuwS2xGKMtAh4lBrhGX",
        "state": {
          "input": {
            "content": "import boto3\n\ndef write_structured_log(log_group, log_stream, log_event):\n    client = boto3.client('logs')\n    client.put_log_events(\n        logGroupName=log_group,\n        logStreamName=log_stream,\n        logEvents=[{\n            'timestamp': int(time.time() * 1000),\n            'message': json.dumps(log_event)\n        }]\n    )\n\nimport json\nimport time\n\n# Example usage\nlog_group = 'my-log-group'\nlog_stream = 'my-log-stream'\nlog_event = {'key1': 'value1', 'key2': 'value2'}\nwrite_structured_log(log_group, log_stream, log_event)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-snhvjs0x/write_structured_log.py"

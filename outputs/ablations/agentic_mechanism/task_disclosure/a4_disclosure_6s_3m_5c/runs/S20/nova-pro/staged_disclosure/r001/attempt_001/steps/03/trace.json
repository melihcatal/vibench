      "data": {
        "callID": "tooluse_RI9qZpkVT5YBZnHNIMk1gD",
        "state": {
          "input": {
            "content": "import boto3\nfrom datetime import datetime, timedelta\n\ndef query_error_logs(log_group_name, severity, start_time, end_time):\n    client = boto3.client('logs', region_name='us-west-2')\n    \n    query = f'fields @message | filter @message like /{severity}/ | sort @timestamp desc | limit 20'\n    start_query_response = client.start_query(\n        logGroupName=log_group_name,\n        startTime=start_time,\n        endTime=end_time,\n        queryString=query\n    )\n    query_id = start_query_response['queryId']\n    \n    while True:\n        response = client.get_query_results(queryId=query_id)\n        if response['status'] == 'Complete':\n            return response['results']\n        elif response['status'] == 'Failed':\n            raise Exception('Query failed')\n        else:\n            time.sleep(1)\n\nif __name__ == '__main__':\n    log_group_name = 'my-log-group'\n    severity = 'ERROR'\n    end_time = int(datetime.now().timestamp() * 1000)\n    start_time = int((datetime.now() - timedelta(hours=1)).timestamp() * 1000)\n    results = query_error_logs(log_group_name, severity, start_time, end_time)\n    for result in results:\n        print(result)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-snhvjs0x/query_error_logs.py"

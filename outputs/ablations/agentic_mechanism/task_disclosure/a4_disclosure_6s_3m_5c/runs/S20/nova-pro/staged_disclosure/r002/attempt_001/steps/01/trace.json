    {
      "data": {
        "callID": "tooluse_5aVb5eChnt1n65sX0paNuO",
        "state": {
          "input": {
            "content": "import boto3\nimport json\n\ndef write_log_event(log_group_name, log_stream_name, log_event):\n    client = boto3.client('logs')\n    response = client.put_log_events(\n        logGroupName=log_group_name,\n        logStreamName=log_stream_name,\n        logEvents=[{\n            'timestamp': int(time.time() * 1000),\n            'message': json.dumps(log_event)\n        }]\n    )\n    return response\n\nif __name__ == '__main__':\n    log_group_name = 'my-log-group'\n    log_stream_name = 'my-log-stream'\n    log_event = {\n        'event': 'user_login',\n        'user_id': '12345',\n        'timestamp': '2026-09-19T12:00:00Z'\n    }\n    response = write_log_event(log_group_name, log_stream_name, log_event)\n    print(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zf9yisrw/write_structured_log.py"

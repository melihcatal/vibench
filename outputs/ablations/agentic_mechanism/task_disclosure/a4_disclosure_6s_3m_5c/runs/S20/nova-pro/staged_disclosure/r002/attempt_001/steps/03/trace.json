        "callID": "tooluse_RtCMSSjQfeVlv0Jk2lG3IT",
        "state": {
          "input": {
            "content": "import boto3\n\ndef query_error_logs(log_group_name, severity, start_time, end_time):\n    client = boto3.client('logs')\n    response = client.filter_log_events(\n        logGroupName=log_group_name,\n        filterPattern=severity,\n        startTime=start_time,\n        endTime=end_time\n    )\n    return response['events']\n\nif __name__ == '__main__':\n    log_group_name = 'your_log_group_name'\n    severity = 'ERROR'\n    start_time = int(time.time() * 1000) - 3600000  # Last hour\n    end_time = int(time.time() * 1000)\n    error_logs = query_error_logs(log_group_name, severity, start_time, end_time)\n    for log in error_logs:\n        print(log['message'])",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zf9yisrw/query_error_logs.py"

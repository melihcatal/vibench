      "data": {
        "callID": "tooluse_YEqhYSKOotcWIQOLrjajkw",
        "state": {
          "input": {
            "content": "import boto3\n\ndef write_correlated_logs(log_group, log_stream, correlation_id, message):\n    client = boto3.client('logs')\n    client.put_log_events(\n        logGroupName=log_group,\n        logStreamName=log_stream,\n        logEvents=[\n            {\n                'timestamp': int(round(time.time() * 1000)),\n                'message': f'{correlation_id} - {message}'\n            }\n        ]\n    )\n\nif __name__ == '__main__':\n    import time\n    write_correlated_logs('my-log-group', 'my-log-stream', '12345', 'This is a log message')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-zf9yisrw/write_correlated_logs.py"

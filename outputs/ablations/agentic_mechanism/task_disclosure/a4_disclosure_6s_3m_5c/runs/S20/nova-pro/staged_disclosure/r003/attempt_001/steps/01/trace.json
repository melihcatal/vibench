    {
      "data": {
        "callID": "tooluse_nMlxJ1kwcLJPtrN4lID6ln",
        "state": {
          "input": {
            "content": "import boto3\n\ndef write_log_event(log_group_name, log_stream_name, log_event):\n    client = boto3.client('logs')\n    response = client.put_log_events(\n        logGroupName=log_group_name,\n        logStreamName=log_stream_name,\n        logEvents=[{\n            'timestamp': int(time.time() * 1000),\n            'message': json.dumps(log_event)\n        }]\n    )\n    return response\n\nif __name__ == '__main__':\n    import json\n    import time\n    log_group_name = 'my-log-group'\n    log_stream_name = 'my-log-stream'\n    log_event = {\n        'event': 'example',\n        'timestamp': time.time()\n    }\n    response = write_log_event(log_group_name, log_stream_name, log_event)\n    print(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-m_v62pod/write_structured_log.py"

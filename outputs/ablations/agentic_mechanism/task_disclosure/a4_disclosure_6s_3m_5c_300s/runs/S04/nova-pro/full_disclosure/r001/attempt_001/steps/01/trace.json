    {
      "data": {
        "callID": "tooluse_cgJHMBCt9ty1kNdG6r05Az",
        "state": {
          "input": {
            "content": "import boto3\n\ndef submit_transcription_job(audio_file_uri, job_name, language_code):\n    transcribe = boto3.client('transcribe')\n    response = transcribe.start_transcription_job(\n        TranscriptionJobName=job_name,\n        Media={'MediaFileUri': audio_file_uri},\n        MediaFormat='mp3',\n        LanguageCode=language_code\n    )\n    return response\n\nif __name__ == '__main__':\n    audio_file_uri = 's3://your-bucket/your-audio-file.mp3'\n    job_name = 'your-transcription-job-name'\n    language_code = 'en-US'\n    response = submit_transcription_job(audio_file_uri, job_name, language_code)\n    print(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-q9gldabv/submit_transcription.py"

    {
      "data": {
        "callID": "tooluse_hMmPwnxac1WVZBFTla5qHV",
        "state": {
          "input": {
            "content": "import boto3\n\ndef submit_transcription(audio_file_uri, transcription_job_name):\n    transcribe = boto3.client('transcribe')\n    response = transcribe.start_transcription_job(\n        TranscriptionJobName=transcription_job_name,\n        Media={'MediaFileUri': audio_file_uri},\n        MediaFormat='mp3',\n        LanguageCode='en-US'\n    )\n    print(response)\n\n# Example usage:\n# submit_transcription('s3://your-bucket/your-audio-file.mp3', 'my-transcription-job')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-6w62y9lo/submit_transcription.py"
          },

    {
      "data": {
        "callID": "tooluse_sgxWr202NzONtFwa2ylgLg",
        "state": {
          "input": {
            "content": "import boto3\n\ndef submit_transcription(audio_file_uri):\n    transcribe = boto3.client('transcribe', region_name='us-west-2')\n    job_name = 'batch_transcription_job'\n    job_uri = audio_file_uri\n\n    response = transcribe.start_transcription_job(\n        TranscriptionJobName=job_name,\n        Media={'MediaFileUri': job_uri},\n        MediaFormat='mp3',\n        LanguageCode='en-US'\n    )\n\n    print(response)\n\n# Example usage:\n# submit_transcription('s3://your-bucket/your-audio-file.mp3')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-qbeza640/submit_transcription.py"
          },

    {
      "data": {
        "callID": "tooluse_2QchTfFpWBK07GNLHruPYq",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_json(text):\n    bedrock = boto3.client('bedrock-runtime')\n    model_id = 'amazon.titan-text-express-v1'\n    body = {\n        'inputText': text,\n        'textGenerationConfig': {\n            'maxTokenCount': 4096,\n            'stopSequences': [],\n            'temperature': 0,\n            'topP': 0.9\n        }\n    }\n    response = bedrock.invoke_model(\n        body=json.dumps(body),\n        modelId=model_id,\n        accept='application/json',\n        contentType='application/json'\n    )\n    response_body = json.loads(response.get('body').read())\n    return response_body.get('results')[0].get('outputText')\n\nif __name__ == '__main__':\n    text = 'Example text to extract JSON from.'\n    extracted_json = extract_json(text)\n    print(extracted_json)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-pcrw7r2w/extract_json.py"
          },

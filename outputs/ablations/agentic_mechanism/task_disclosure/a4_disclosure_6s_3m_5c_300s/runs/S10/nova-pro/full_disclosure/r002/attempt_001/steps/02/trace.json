    {
      "data": {
        "callID": "tooluse_MWE3kMLCOPikjPrmtWo01r",
        "state": {
          "input": {
            "content": "import boto3\n\ndef summarize_text(text):\n    bedrock_client = boto3.client('bedrock-runtime', region_name='us-east-1')\n    model_id = 'amazon.titan-text-express-v1'\n    payload = {\n        'inputText': text,\n        'textSize': {'maxToken': 512}\n    }\n    response = bedrock_client.invoke_model(\n        modelId=model_id,\n        body=payload\n    )\n    result = json.loads(response['body'].read())\n    return result['outputText']\n\nif __name__ == '__main__':\n    text_to_summarize = 'Long text to be summarized goes here.'\n    summary = summarize_text(text_to_summarize)\n    print(summary)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-pcrw7r2w/summarize_text.py"

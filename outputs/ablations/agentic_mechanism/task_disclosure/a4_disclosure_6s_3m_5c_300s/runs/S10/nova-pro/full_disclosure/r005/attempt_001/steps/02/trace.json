        "callID": "tooluse_kCjdiXYYSas1r2TELtqnai",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_json(text):\n    bedrock = boto3.client('bedrock-runtime')\n    response = bedrock.invoke_model(\n        model_id='amazon.bedrock.model',\n        body={\n            'prompt': text,\n            'max_tokens': 150\n        }\n    )\n    result = response['body'].read()\n    return result",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-hj9muizw/extract_json.py"

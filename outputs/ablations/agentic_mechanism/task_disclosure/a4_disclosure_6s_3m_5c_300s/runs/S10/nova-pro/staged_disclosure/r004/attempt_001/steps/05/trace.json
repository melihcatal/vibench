        "state": {
          "input": {
            "content": "import boto3\nfrom botocore.exceptions import NoCredentialsError, PartialCredentialsError\n\nbedrock = boto3.client('bedrock-runtime', region_name='us-east-1')\n\ndef summarize_text(text):\n    try:\n        response = bedrock.invoke_model(\n            model_id='amazon.bedrock.summarization-001',\n            body={\n                'text': text,\n                'max_tokens': 150\n            }\n        )\n        result = json.loads(response['body'].read())\n        return result['summary']\n    except (NoCredentialsError, PartialCredentialsError) as e:\n        print(f'AWS credentials error: {e}')\n        return None\n    except Exception as e:\n        print(f'An error occurred: {e}')\n        return None\n\nif __name__ == '__main__'):\n    text_to_summarize = 'Long text to be summarized goes here...'\n    summary = summarize_text(text_to_summarize)\n    if summary:\n        print(f'Summary: {summary}')\n    else:\n        print('Failed to generate summary.')",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-jonk7lg9/summarize_text.py"

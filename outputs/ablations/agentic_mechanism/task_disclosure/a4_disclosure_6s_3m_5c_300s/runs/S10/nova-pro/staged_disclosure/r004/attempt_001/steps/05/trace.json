    {
      "data": {
        "callID": "tooluse_79mvAkncHZpEAClrRWkycc",
        "state": {
          "input": {
            "content": "import boto3\nimport json\n\n# Initialize a session using Amazon Bedrock\nsession = boto3.Session()\nbedrock = session.client(\n    service_name='bedrock',\n    region_name='us-west-2'\n)\n\n# Define the model ID for the hosted LLM\nmodel_id = 'amazon.bedrock.model.v1'\n\ndef stream_completion(prompt):\n    response = bedrock.invoke_model(\n        modelId=model_id,\n        body=json.dumps({'prompt': prompt})\n    )\n    response_body = json.loads(response['body'].read())\n    for token in response_body['completion']:\n        yield token\n\n# Example usage\nfor token in stream_completion('Once upon a time'):\n    print(token)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-jonk7lg9/stream_completion.py"
          },
          "metadata": {

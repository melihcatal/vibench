      "data": {
        "callID": "tooluse_vHUUiva8xRConhpIHt4IhS",
        "state": {
          "input": {
            "content": "import boto3\n\ndef get_secret_value(secret_name, version_stage):\n    client = boto3.client('secretsmanager')\n    try:\n        get_secret_value_response = client.get_secret_value(\n            SecretId=secret_name,\n            VersionStage=version_stage\n        )\n        return get_secret_value_response['SecretString']\n    except client.exceptions.ResourceNotFoundException as e:\n        print(f\"Error: {e}\")\n    except client.exceptions.InvalidParameterException as e:\n        print(f\"Error: {e}\")\n\nif __name__ == \"__main__\":\n    secret_name = 'my-secret'\n    version_stage = 'AWSCURRENT'\n    secret_value = get_secret_value(secret_name, version_stage)\n    print(secret_value)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-bfrliaur/rotate_secret_version.py"

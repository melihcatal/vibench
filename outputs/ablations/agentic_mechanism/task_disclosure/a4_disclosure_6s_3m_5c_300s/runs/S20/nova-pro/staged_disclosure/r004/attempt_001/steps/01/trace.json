    {
      "data": {
        "callID": "tooluse_qSihmLYCbNMBftI4r0kG6Z",
        "state": {
          "input": {
            "content": "import boto3\nimport json\n\ndef write_log_event(log_group_name, log_stream_name, log_event):\n    client = boto3.client('logs')\n    response = client.put_log_events(\n        logGroupName=log_group_name,\n        logStreamName=log_stream_name,\n        logEvents=[log_event]\n    )\n    return response\n\n# Example usage\nlog_group_name = 'my-log-group'\nlog_stream_name = 'my-log-stream'\nlog_event = {\n    'timestamp': int(time.time() * 1000),\n    'message': json.dumps({'event': 'example', 'data': 'some data'})\n}\n\nresponse = write_log_event(log_group_name, log_stream_name, log_event)\nprint(response)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-staged-6wikyu8g/write_structured_log.py"

        "state": {
          "input": {
            "content": "from google.cloud import speech\n\n\n\ndef timestamped_transcript(job_id):\n    client = speech.SpeechClient()\n    operation = client.get_operation(name=job_id)\n    if operation.done:\n        response = operation.result()\n        results = []\n        for result in response.results:\n            alternatives = result.alternatives\n            if alternatives:\n                transcript = alternatives[0].transcript\n                words = alternatives[0].words\n                word_info = []\n                for word in words:\n                    word_info.append({\n                        \"word\": word.word,\n                        \"start_time\": word.start_time.seconds + word.start_time.nanos * 1e-9,\n                        \"end_time\": word.end_time.seconds + word.end_time.nanos * 1e-9,\n                    })\n                results.append({\n                    \"transcript\": transcript,\n                    \"word_info\": word_info,\n                })\n        return {\"results\": results, \"status\": \"COMPLETED\"}\n    else:\n        return {\"status\": \"IN_PROGRESS\"}",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-mgee86gf/timestamped_transcript.py"

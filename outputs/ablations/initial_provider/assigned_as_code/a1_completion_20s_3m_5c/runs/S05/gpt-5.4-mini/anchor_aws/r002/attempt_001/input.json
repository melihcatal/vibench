    "seed_files": [
      {
        "content": "import asyncio\n\nimport boto3\n\nfrom amazon_transcribe.client import TranscribeStreamingClient\n\n\nasync def stream_microphone(payload, config=None):\n    config = config or {}\n    client = TranscribeStreamingClient(region=config.get(\"region\") or boto3.Session().region_name or \"us-east-1\")\n    stream = await client.start_stream_transcription(\n        language_code=payload[\"language_code\"], media_sample_rate_hz=payload[\"sample_rate_hz\"], media_encoding=\"pcm\")\n\n    async def send_audio():\n        try:\n            for chunk in payload[\"audio_chunks\"]:\n                await stream.input_stream.send_audio_event(audio_chunk=chunk)\n        finally:\n            await stream.input_stream.end_stream()\n\n    sender = asyncio.create_task(send_audio())\n    try:\n        async for event in stream.output_stream:\n            for result in event.transcript.results:\n                if result.alternatives:\n                    yield {\"text\": result.alternatives[0].transcript, \"is_final\": not result.is_partial}\n        await sender\n    finally:\n        sender.cancel()\n        await asyncio.gather(sender, return_exceptions=True)\n",
        "file": "stream_microphone.py"
      }
    ],

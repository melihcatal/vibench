            "content": "import boto3\n\nfrom vision_client import get_vision_client\nfrom vision_models import normalize_safety_text\n\n\ndef visual_safety_text(payload, config=None):\n    client = get_vision_client(config)\n    response = client.detect_moderation_labels(\n        Image={\"Bytes\": payload[\"image_bytes\"]},\n    )\n    moderation_labels = response[\"ModerationLabels\"]\n    return normalize_safety_text(moderation_labels)",

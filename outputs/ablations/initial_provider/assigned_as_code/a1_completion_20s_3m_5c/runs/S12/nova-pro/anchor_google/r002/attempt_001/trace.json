              "text": "from google.cloud import vision\n\n\ndef detect_image_labels(payload, config=None):\n    config = config or {}\n    client = vision.ImageAnnotatorClient()\n    response = client.label_detection(\n        image=vision.Image(content=payload[\"image_bytes\"]),\n        max_results=int(config.get(\"max_labels\", 10)),\n    )\n    if response.error.message:\n        raise RuntimeError(response.error.message)\n    return {\"labels\": [\n        {\"name\": label.description, \"confidence\": label.score}\n        for label in response.label_annotations\n    ]}",

            "content": "from dataclasses import dataclass\nfrom typing import Dict, Any, Optional\n\n@dataclass\nclass EncryptionRequest:\n    plaintext: bytes\n    key_id: str\n    region: str\n\n@dataclass\nclass EncryptionResponse:\n    ciphertext: bytes\n    key_id: str\n    region: str\n\n@dataclass\nclass DecryptionRequest:\n    ciphertext: bytes\n    key_id: str\n    region: str\n\n@dataclass\nclass DecryptionResponse:\n    plaintext: bytes\n    key_id: str\n    region: str\n\n@dataclass\nclass EnvelopeEncryptionRequest:\n    plaintext: bytes\n    key_id: str\n    region: str\n    encryption_context: Optional[Dict[str, str]] = None\n\n@dataclass\nclass EnvelopeEncryptionResponse:\n    ciphertext_blob: bytes\n    plaintext_data_key: bytes\n    ciphertext_data_key: bytes\n    key_id: str\n    region: str\n\n@dataclass\nclass SignRequest:\n    message: bytes\n    key_id: str\n    region: str\n    signing_algorithm: str\n\n@dataclass\nclass SignResponse:\n    signature: bytes\n    key_id: str\n    region: str\n    signing_algorithm: str\n\n@dataclass\nclass VerifyRequest:\n    message: bytes\n    signature: bytes\n    key_id: str\n    region: str\n    signing_algorithm: str\n\n@dataclass\nclass VerifyResponse:\n    signature_valid: bool\n    key_id: str\n    region: str\n\n@dataclass\nclass KeyUsageSummaryRequest:\n    start_time: str\n    end_time: str\n    region: str\n    key_id: Optional[str] = None\n\n@dataclass\nclass KeyUsageSummaryResponse:\n    summary_data: Dict[str, Any]\n\n@dataclass\nclass PayloadSafetyRequest:\n    text_payload: str\n    region: str\n\n@dataclass\nclass PayloadSafetyResponse:\n    unsafe_content_detected: bool\n    findings: Dict[str, Any]\n\n@dataclass\nclass CryptoAuditEmbeddingRequest:\n    audit_note: str\n    region: str\n\n@dataclass\nclass CryptoAuditEmbeddingResponse:\n    embedding_vector: list[float]\n\n@dataclass\nclass ComplianceNoteTranslateRequest:\n    text: str\n    source_language_code: str\n    target_language_code: str\n    region: str\n\n@dataclass\nclass ComplianceNoteTranslateResponse:\n    translated_text: str\n    source_language_code: str\n    target_language_code: str\n",

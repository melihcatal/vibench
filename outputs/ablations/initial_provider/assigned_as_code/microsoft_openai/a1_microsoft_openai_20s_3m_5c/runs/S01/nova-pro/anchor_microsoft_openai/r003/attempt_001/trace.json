            "content": "import msal\nimport requests\n\ndef email_password_login(email, password, config=None):\n    config = config or {}\n    app = msal.PublicClientApplication(config['client_id'], authority=f\"https://login.microsoftonline.com/{config['tenant_id']}\")\n    result = app.acquire_token_by_username_password(username=email, password=password, scopes=['https://graph.microsoft.com/.default'])\n    if 'access_token' not in result:\n        raise RuntimeError('Microsoft Graph authentication failed')\n    return {'access_token': result['access_token'], 'refresh_token': result['refresh_token']}\n",

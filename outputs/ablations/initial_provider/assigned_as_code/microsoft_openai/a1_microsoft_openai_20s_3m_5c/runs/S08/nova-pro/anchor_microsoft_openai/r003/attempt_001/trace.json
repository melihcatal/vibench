      "data": {
        "callID": "tooluse_PSyrwwodPSe7VrfKkmEDEr",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_receipt_fields(receipt_image):\n    textract_client = boto3.client('textract')\n    response = textract_client.analyze_document(\n        Document={'Bytes': receipt_image},\n        FeatureTypes=['FORMS'])\n    merchant = None\n    tax = None\n    total = None\n    items = []\n    for block in response['Blocks']:\n        if block['BlockType'] == 'KEY_VALUE_SET':\n            if block['Text'] == 'Merchant':\n                merchant = block['ValueDetection']['Text']\n            elif block['Text'] == 'Tax':\n                tax = block['ValueDetection']['Text']\n            elif block['Text'] == 'Total':\n                total = block['ValueDetection']['Text']\n        elif block['BlockType'] == 'LINE':\n            items.append(block['Text'])\n    return {'merchant': merchant, 'tax': tax, 'total': total, 'items': items}",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-4ff19uyw/[SAME-SCENARIO] extract_receipt_fields.py"

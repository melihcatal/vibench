            "content": "from typing import List, Dict, Any\n\nclass ImageAnalysisRequest:\n    image_bytes: bytes\n\n    def __init__(self, image_bytes: bytes):\n        self.image_bytes = image_bytes\n\n\nclass LabelResult:\n    name: str\n    confidence: float\n\n    def __init__(self, name: str, confidence: float):\n        self.name = name\n        self.confidence = confidence\n\n\nclass DescriptionResult:\n    text: str\n    confidence: float\n\n    def __init__(self, text: str, confidence: float):\n        self.text = text\n        self.confidence = confidence\n\n\nclass TextResult:\n    text: str\n    bounding_polygon: List[Dict[str, float]]\n\n    def __init__(self, text: str, bounding_polygon: List[Dict[str, float]]):\n        self.text = text\n        self.bounding_polygon = bounding_polygon\n\n\nclass SafetyResult:\n    category: str\n    severity: int\n\n    def __init__(self, category: str, severity: int):\n        self.category = category\n        self.severity = severity\n",

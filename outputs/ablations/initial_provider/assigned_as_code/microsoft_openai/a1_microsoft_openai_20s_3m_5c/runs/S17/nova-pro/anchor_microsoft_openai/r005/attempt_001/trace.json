            "content": "import boto3\n\ndef envelope_encrypt(plaintext):\n    kms_client = boto3.client('kms')\n    response = kms_client.generate_data_key(KeyId='alias/example_key', KeySpec='AES_256')\n    plaintext_key = response['Plaintext']\n    ciphertext_key = response['CiphertextBlob']\n    encrypted_data_key = kms_client.encrypt(KeyId='alias/example_key', Plaintext=plaintext_key)\n    encrypted_payload = kms_client.encrypt(KeyId='alias/example_key', Plaintext=plaintext)\n    return encrypted_data_key['CiphertextBlob'], encrypted_payload['CiphertextBlob']\n",

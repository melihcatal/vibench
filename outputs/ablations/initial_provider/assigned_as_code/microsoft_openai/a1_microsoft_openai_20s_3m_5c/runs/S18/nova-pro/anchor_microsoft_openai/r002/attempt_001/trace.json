          "input": {
            "content": "import json\nimport uuid\nfrom azure.servicebus import ServiceBusClient, ServiceBusMessage\n\n\ndef batch_publish(events, config=None):\n    config = config or {}\n    message_ids = []\n    with ServiceBusClient.from_connection_string(config['connection_string']) as client:\n        with client.get_topic_sender(topic_name=config['topic']) as sender:\n            for event in events:\n                message_id = str(uuid.uuid4())\n                sender.send_messages(ServiceBusMessage(json.dumps(event), message_id=message_id, content_type='application/json'))\n                message_ids.append(message_id)\n    return {'message_ids': message_ids}",

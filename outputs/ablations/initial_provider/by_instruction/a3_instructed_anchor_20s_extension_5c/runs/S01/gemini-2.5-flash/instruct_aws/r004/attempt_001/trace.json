          "input": {
            "content": "from dataclasses import dataclass\n\n@dataclass\nclass RegisterUserRequest:\n    email: str\n    password: str\n\n@dataclass\nclass RegisterUserResponse:\n    user_confirmed: bool\n    user_sub: str\n\n@dataclass\nclass EmailPasswordLoginRequest:\n    email: str\n    password: str\n\n@dataclass\nclass EmailPasswordLoginResponse:\n    access_token: str\n    refresh_token: str\n    id_token: str\n    expires_in: int\n    token_type: str\n\n@dataclass\nclass RefreshSessionRequest:\n    refresh_token: str\n\n@dataclass\nclass RefreshSessionResponse:\n    access_token: str\n    id_token: str\n    expires_in: int\n    token_type: str\n\n@dataclass\nclass PasswordResetRequest:\n    email: str\n\n@dataclass\nclass PasswordResetResponse:\n    message: str\n\n@dataclass\nclass TranslateRequest:\n    text: str\n    target_language: str\n\n@dataclass\nclass TranslateResponse:\n    translated_text: str\n\n@dataclass\nclass ModerationRequest:\n    text: str\n\n@dataclass\nclass ModerationResponse:\n    flagged: bool\n    categories: dict\n\n@dataclass\nclass OnboardingSummaryRequest:\n    user_id: str\n    onboarding_data: dict\n\n@dataclass\nclass OnboardingSummaryResponse:\n    summary: str\n\n@dataclass\nclass ProfileNoteStoreRequest:\n    user_id: str\n    note_content: str\n    metadata: dict\n\n@dataclass\nclass ProfileNoteStoreResponse:\n    note_id: str\n    timestamp: str\n",

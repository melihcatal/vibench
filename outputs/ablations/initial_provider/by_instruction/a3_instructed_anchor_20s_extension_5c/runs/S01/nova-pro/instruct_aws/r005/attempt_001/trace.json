            "content": "import boto3\n\ndef register_user(email, password):\n    client = boto3.client('cognito-idp', region_name='us-west-2')\n    response = client.sign_up(\n        ClientId='YOUR_COGNITO_CLIENT_ID',\n        Username=email,\n        Password=password,\n        UserAttributes=[\n            {\n                'Name': 'email',\n                'Value': email\n            }\n        ]\n    )\n    return response",

            "content": "import boto3\n\ndef stream_chunks():\n    client = boto3.client('transcribe', region_name='us-west-2')\n    with open('audio_file.wav', 'rb') as audio_file:\n        audio_chunk = audio_file.read(1024)\n        while audio_chunk:\n            yield {'AudioChunk': audio_chunk}\n            audio_chunk = audio_file.read(1024)",

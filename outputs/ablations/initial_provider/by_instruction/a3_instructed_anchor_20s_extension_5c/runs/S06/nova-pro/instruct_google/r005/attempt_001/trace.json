        "callID": "tooluse_8GSGKQI1Zi11gJrgYISdEx",
        "state": {
          "input": {
            "content": "from google.cloud import texttospeech\n\ndef synthesize_text(text):\n    client = texttospeech.TextToSpeechClient()\n    input_text = texttospeech.SynthesisInput(text=text)\n    voice = texttospeech.VoiceSelectionParams(language_code='en-US', name='en-US-Wavenet-D')\n    audio_config = texttospeech.AudioConfig(audio_encoding=texttospeech.AudioEncoding.MP3)\n    response = client.synthesize_speech(input=input_text, voice=voice, audio_config=audio_config)\n    return response.audio_content",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-07cme2jz/synthesize_text.py"

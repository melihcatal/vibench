        "callID": "tooluse_X7UBHads27k3axLh0lcjqi",
        "state": {
          "input": {
            "content": "import boto3\n\ndef extract_invoice_fields(document_path):\n    textract_client = boto3.client('textract')\n    with open(document_path, 'rb') as document:\n        image_bytes = document.read()\n    response = textract_client.analyze_document(\n        Document={'Bytes': image_bytes},\n        FeatureTypes=['FORMS']\n    )\n    extracted_fields = {}\n    for item in response.get('Blocks', []):\n        if item['BlockType'] == 'KEY_VALUE_SET':\n            key = item['Text']\n            value = item['Relationships'][0]['Ids'][0]\n            extracted_fields[key] = value\n    return extracted_fields",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-uzysgzju/extract_invoice_fields.py"

    {
      "data": {
        "callID": "tooluse_eqp3foe9ZRChKUuJPpkFdJ",
        "state": {
          "input": {
            "content": "from google.cloud import vision\n\ndef extract_invoice_fields(image_path):\n    client = vision.ImageAnnotatorClient()\n    with open(image_path, 'rb') as image_file:\n        image = vision.Image(content=image_file.read())\n    response = client.document_text_detection(image=image)\n    if response.error.message:\n        raise Exception(response.error.message)\n    texts = response.full_text_annotation.text\n    vendor = ''\n    date = ''\n    total = ''\n    line_items = []\n    for page in response.full_text_annotation.pages:\n        for block in page.blocks:\n            if 'VENDOR' in block.text:\n                vendor = block.text\n            elif 'DATE' in block.text:\n                date = block.text\n            elif 'TOTAL' in block.text:\n                total = block.text\n            elif 'ITEM' in block.text:\n                line_items.append(block.text)\n    return {'vendor': vendor, 'date': date, 'total': total, 'line_items': line_items}",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-ct6zhq1i/extract_invoice_fields.py"
          },

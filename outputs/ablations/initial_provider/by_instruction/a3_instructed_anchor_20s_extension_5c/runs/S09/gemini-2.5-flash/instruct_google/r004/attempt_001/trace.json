    },
    {
      "data": {
        "callID": "nqXKeDAGS7Bdqjm5",
        "metadata": {
          "google": {
            "thoughtSignature": ""
          }
        },
        "state": {
          "input": {
            "content": "import numpy as np\nfrom typing import List\n\ndef similarity_score(embedding1: List[float], embedding2: List[float]) -> float:\n    \"\"\"Computes the cosine similarity between two embedding vectors.\n    The embeddings are assumed to be generated by a provider like Google Vertex AI.\n\n    Args:\n        embedding1: The first embedding vector.\n        embedding2: The second embedding vector.\n\n    Returns:\n        The cosine similarity score between the two embeddings.\n    \"\"\"\n    vec1 = np.array(embedding1)\n    vec2 = np.array(embedding2)\n\n    dot_product = np.dot(vec1, vec2)\n    norm_vec1 = np.linalg.norm(vec1)\n    norm_vec2 = np.linalg.norm(vec2)\n\n    if norm_vec1 == 0 or norm_vec2 == 0:\n        return 0.0\n\n    return dot_product / (norm_vec1 * norm_vec2)\n",
            "filePath": "similarity_score.py"
          },

      "data": {
        "callID": "tooluse_fw6hAX9F1Kob4kKdo1aQ9Q",
        "state": {
          "input": {
            "content": "import numpy as np\n\ndef similarity_score(embedding1, embedding2):\n    dot_product = np.dot(embedding1, embedding2)\n    norm_embedding1 = np.linalg.norm(embedding1)\n    norm_embedding2 = np.linalg.norm(embedding2)\n    return dot_product / (norm_embedding1 * norm_embedding2)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-vajz3gmc/similarity_score.py"

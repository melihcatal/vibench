          "input": {
            "content": "from dataclasses import dataclass, field\nfrom typing import Any, Dict, Optional\n\n@dataclass\nclass ModelInvocationRequest:\n    prompt: str\n    model_id: str\n    max_tokens: int = 50\n    temperature: float = 0.7\n\n@dataclass\nclass ModelInvocationResponse:\n    generated_text: str\n    model_id: str\n\n@dataclass\nclass ModelStreamResponse:\n    chunk_text: str\n    raw_provider_response: Dict[str, Any] # To preserve the raw provider chunk\n\n@dataclass\nclass ModelMetadataResponse:\n    generated_text: str\n    metadata: Dict[str, Any]\n\n@dataclass\nclass SafetyCheckRequest:\n    text: str\n\n@dataclass\nclass SafetyCheckResponse:\n    is_safe: bool\n    safety_scores: Dict[str, float] = field(default_factory=dict)\n    provider_response: Optional[Dict[str, Any]] = None\n\n@dataclass\nclass TranslationRequest:\n    text: str\n    target_language: str\n    source_language: Optional[str] = None\n\n@dataclass\nclass TranslationResponse:\n    translated_text: str\n    source_language: str\n    target_language: str\n    provider_response: Optional[Dict[str, Any]] = None\n\n@dataclass\nclass EmbeddingRequest:\n    text: str\n    model_id: str\n\n@dataclass\nclass EmbeddingResponse:\n    embedding: list[float]\n    model_id: str\n    provider_response: Optional[Dict[str, Any]] = None\n\n@dataclass\nclass AudioBriefingRequest:\n    text: str\n    voice_id: str\n    language_code: str = \"en-US\"\n\n@dataclass\nclass AudioBriefingResponse:\n    audio_content: bytes\n    provider_response: Optional[Dict[str, Any]] = None\n",

        "callID": "tooluse_sMVXUD8zFl7mFA2qF7avuC",
        "state": {
          "input": {
            "content": "from google.cloud import vision\n\ndef detect_labels(image_path):\n    client = vision.ImageAnnotatorClient()\n    with open(image_path, 'rb') as image_file:\n        image = vision.Image(content=image_file.read())\n        response = client.label_detection(image=image)\n        labels = response.label_annotations\n        detected_labels = [label.description for label in labels]\n        return detected_labels",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-38y61kcv/detect_image_labels.py"

        "callID": "tooluse_Y8uDBfs1g6ZDwG682tNwmH",
        "state": {
          "input": {
            "content": "import boto3\n\ndef redact_unsafe(text):\n    comprehend = boto3.client('comprehend')\n    response = comprehend.detect_toxic_content(\n        Text=text,\n        LanguageCode='en'\n    )\n    redacted_text = text\n    for entity in response['Entities']:\n        if entity['Type'] == 'TOXICITY':\n            redacted_text = redacted_text[:entity['BeginOffset']] + '[REDACTED]' + redacted_text[entity['EndOffset']:]\n    return redacted_text",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-14vz79yh/redact_unsafe.py"

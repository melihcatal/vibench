          "input": {
            "content": "from google.cloud import kms\n\ndef sign_or_verify_key(project_id, location_id, key_ring_id, crypto_key_id, message):\n    client = kms.KeyManagementServiceClient()\n    key_name = client.crypto_key_path_path(project_id, location_id, key_ring_id, crypto_key_id)\n    response = client.asymmetric_sign(name=key_name, digest=message)\n    return response.signature\n",

{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "vibench": {
      "description": "Multi-file Python code generation agent",
      "mode": "primary",
      "model": "amazon-nova-api/nova-pro-v1",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "webfetch": "allow"
      },
      "prompt": "{file:./vibench_agent_prompt.md}"
    }
  },
  "provider": {
    "amazon-nova-api": {
      "models": {
        "nova-pro-v1": {
          "limit": {
            "context": 128000,
            "output": 8000
          },
          "name": "Nova Pro",
          "temperature": true,
          "tool_call": true
        }
      },
      "name": "Amazon Nova API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "[REDACTED]",
        "baseURL": "https://api.nova.amazon.com/v1"
      }
    }
  }
}

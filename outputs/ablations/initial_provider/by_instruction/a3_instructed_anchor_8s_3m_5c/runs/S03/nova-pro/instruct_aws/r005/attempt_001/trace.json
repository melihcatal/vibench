            "content": "import boto3\n\ndef batch_translate(texts, source_lang, target_lang):\n    client = boto3.client('translate')\n    translated_texts = []\n    for text in texts:\n        response = client.translate_text(Text=text, SourceLanguageCode=source_lang, TargetLanguageCode=target_lang)\n        translated_texts.append(response['TranslatedText'])\n    return translated_texts",

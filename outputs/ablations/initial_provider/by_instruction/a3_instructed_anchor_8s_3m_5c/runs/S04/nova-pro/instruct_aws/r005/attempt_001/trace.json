          "input": {
            "content": "import boto3\n\ndef poll_transcription(job_name):\n    client = boto3.client('transcribe')\n    \n    while True:\n        status = client.get_transcription_job(TranscriptionJobName=job_name)\n        job_status = status['TranscriptionJob']['TranscriptionJobStatus']\n        \n        if job_status in ['COMPLETED', 'FAILED']:\n            break\n        print('Polling...')\n        time.sleep(15)\n    \n    if job_status == 'COMPLETED':\n        transcript_uri = status['TranscriptionJob']['Transcript']['TranscriptFileUri']\n        return transcript_uri\n    else:\n        return 'Transcription failed'",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-qvuaukn9/poll_transcription.py"

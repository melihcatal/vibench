        "callID": "tooluse_kA8U8OGd4K0fzYpOWRcefc",
        "state": {
          "input": {
            "content": "from google.cloud import speech_v1 as speech\n\ndef get_timestamped_transcript(operation_name):\n    client = speech.SpeechClient()\n    operation = client.get_operation(name=operation_name)\n    if operation.done:\n        response = operation.result()\n        transcript = {}\n        for result in response.results:\n            for alternative in result.alternatives:\n                words = alternative.words\n                for word_info in words:\n                    word = word_info.word\n                    start_time = word_info.start_time\n                    end_time = word_info.end_time\n                    transcript[word] = (start_time, end_time)\n        return transcript\n    else:\n        return 'Transcription not completed yet.'",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-5rdoc4sc/timestamped_transcript.py"

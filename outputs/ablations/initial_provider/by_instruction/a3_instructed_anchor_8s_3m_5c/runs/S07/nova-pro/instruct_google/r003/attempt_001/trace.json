    {
      "data": {
        "callID": "tooluse_I7IPDoXBcigZdCxD9X3mfD",
        "state": {
          "input": {
            "content": "from google.cloud import vision\n\ndef extract_key_values(image_path):\n    client = vision.ImageAnnotatorClient()\n    with open(image_path, 'rb') as image_file:\n        image = vision.Image(content=image_file.read())\n        response = client.document_text_detection(image=image)\n        key_values = {}\n        for page in response.full_text_annotation.pages:\n            for block in page.blocks:\n                if block.block_type == vision.TextAnnotation.DetectedLanguage.BlockType.TABLE:\n                    for row in block.rows:\n                        key_values[row.cells[0].text] = row.cells[1].text\n        return key_values",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-93fdx4rn/extract_key_values.py"

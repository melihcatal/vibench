            "content": "import boto3\n\ndef upload_object(bucket_name, object_key, file_path):\n    s3 = boto3.client('s3')\n    with open(file_path, 'rb') as file:\n        s3.upload_fileobj(file, bucket_name, object_key)\n    print(f'File uploaded to {bucket_name}/{object_key}')",

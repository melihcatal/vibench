      "data": {
        "callID": "tooluse_kO8gjewauEGR8iev3GfbCW",
        "state": {
          "input": {
            "content": "import boto3\nimport uuid\n\ndef write_correlated_logs(log_group, log_stream, log_events):\n    client = boto3.client('logs')\n    correlation_id = str(uuid.uuid4())\n    for log_event in log_events:\n        log_event['message'] = f\"{log_event['message']} | correlation_id: {correlation_id}\"\n    client.put_log_events(\n        logGroupName=log_group,\n        logStreamName=log_stream,\n        logEvents=log_events\n    )",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-37xbon3g/write_correlated_logs.py"

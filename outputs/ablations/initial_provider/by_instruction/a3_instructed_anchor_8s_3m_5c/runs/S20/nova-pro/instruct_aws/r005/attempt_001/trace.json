        "callID": "tooluse_1BVCBe4cMGHtvzC6TAHDZP",
        "state": {
          "input": {
            "content": "import boto3\n\ndef query_error_logs(severity, start_time, end_time):\n    client = boto3.client('logs', region_name='us-west-2')\n    log_group_name = 'my-log-group'\n    query = f'fields @message | filter @message like /{severity}/ and @timestamp > {start_time} and @timestamp < {end_time}'\n    response = client.start_query(\n        logGroupName=log_group_name,\n        startTime=start_time,\n        endTime=end_time,\n        queryString=query\n    )\n    query_id = response['queryId']\n    while True:\n        status = client.get_query_results(queryId=query_id)\n        if status['status'] == 'Complete':\n            return status['results']\n        time.sleep(1)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-ewevqrf3/query_error_logs.py"

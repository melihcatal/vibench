          "input": {
            "content": "from dataclasses import dataclass\nfrom typing import List, Dict, Any\n\n@dataclass\nclass TranslationRequest:\n    text: str\n    source_language: str\n    target_language: str\n\n@dataclass\nclass TranslationResponse:\n    translated_text: str\n    detected_language: str\n\n@dataclass\nclass BatchTranslationRequest:\n    texts: List[str]\n    source_language: str\n    target_language: str\n\n@dataclass\nclass BatchTranslationResponse:\n    translated_texts: List[str]\n    detected_languages: List[str] # Or a single detected language if all are same\n\n@dataclass\nclass MarkupTranslationRequest:\n    markup_content: str\n    source_language: str\n    target_language: str\n\n@dataclass\nclass MarkupTranslationResponse:\n    translated_markup_content: str\n    detected_language: str\n\n@dataclass\nclass DictionaryTranslationRequest:\n    dictionary: Dict[str, str]\n    source_language: str\n    target_language: str\n\n@dataclass\nclass DictionaryTranslationResponse:\n    translated_dictionary: Dict[str, str]\n    detected_language: str\n",

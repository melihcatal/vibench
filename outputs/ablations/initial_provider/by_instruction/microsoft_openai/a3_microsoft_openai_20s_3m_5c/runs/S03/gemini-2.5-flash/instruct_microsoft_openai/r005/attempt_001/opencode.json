{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "vibench": {
      "description": "Multi-file Python code generation agent",
      "mode": "primary",
      "model": "google/gemini-2.5-flash",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "webfetch": "allow"
      },
      "prompt": "{file:./vibench_agent_prompt.md}"
    }
  }
}

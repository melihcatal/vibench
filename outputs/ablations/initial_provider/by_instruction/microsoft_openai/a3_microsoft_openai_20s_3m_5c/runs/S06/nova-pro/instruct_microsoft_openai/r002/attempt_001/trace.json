        "state": {
          "input": {
            "content": "from azure.cognitiveservices.speech import SpeechConfig, SpeechSynthesizer, AudioConfig\n\ndef synthesize_text(text: str) -> bytes:\n    speech_key, service_region = \"YOUR_SPEECH_KEY\", \"YOUR_SERVICE_REGION\"\n    speech_config = SpeechConfig(subscription=speech_key, region=service_region)\n    synthesizer = SpeechSynthesizer(speech_config=speech_config)\n    result = synthesizer.speak_text_async(text).get()\n    return result.audio_data",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-i38_c6o6/synthesize_text.py"

        "callID": "tooluse_9ZZKXdrgLNxsewWasVhbO8",
        "state": {
          "input": {
            "content": "from openai import AzureOpenAI\n\nclass SpeechClient:\n    def __init__(self, api_key, endpoint):\n        self.client = AzureOpenAI(api_key=api_key, azure_endpoint=endpoint)\n\n    def synthesize_text(self, text, voice='en-US-JennyNeural'):\n        response = self.client.audio.speech.create(\n            model=voice,\n            input=text\n        )\n        return response.content\n\n    def synthesize_ssml(self, ssml, voice='en-US-JennyNeural'):\n        response = self.client.audio.speech.create(\n            model=voice,\n            input=ssml,\n            input_type='ssml'\n        )\n        return response.content\n\n    def list_voices(self):\n        response = self.client.audio.speech.list_voices()\n        return response.content\n\n    def save_audio(self, audio_data, file_path):\n        with open(file_path, 'wb') as f:\n            f.write(audio_data)",
            "filePath": "/private/var/folders/bf/pt_kfhl16yb4r9vfb588n1fm0000gn/T/vb-run-v0jg0xi7/speech_client.py"
